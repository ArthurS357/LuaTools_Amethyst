<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- AssemblyName is the app's TECHNICAL identity and is deliberately NOT renamed: the loader DLL
         launches "LuaTools.exe" by name, Velopack keys its install on it, and %AppData%\LuaToolsGui,
         the single-instance mutex and the luatools:// handler all match it. Renaming would orphan every
         existing install. The DISPLAY identity below is what users see. -->
    <AssemblyName>LuaTools</AssemblyName>
    <AssemblyTitle>LuaTools Amethyst</AssemblyTitle>
    <Product>LuaTools Amethyst</Product>
    <!-- Single source of truth for the app version. It drives AssemblyVersion, AssemblyFileVersion and
         AssemblyInformationalVersion (the SDK generates all three from <Version>), and MainViewModel
         reads InformationalVersion back to render the "v1.5.0 · …" label in the nav pane footer. This had
         drifted to 1.1.3 while 1.2.8 was shipping, so the footer told every user the wrong version — keep
         it bumped with each release, in step with the version passed to `vpk pack`. See docs/CHANGELOG.md. -->
    <Version>1.5.0</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Explicit asInvoker. Same effective privilege level as before (no manifest defaulted to this), now
         stated on purpose so elevation can't be acquired by accident. See app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Velopack needs a custom Main (Program.Main) that runs before WPF -->
    <StartupObject>LuaToolsGui.Program</StartupObject>
  </PropertyGroup>

  <!-- UseWindowsForms (for the tray NotifyIcon) injects WinForms into the implicit global usings, which
       collides with WPF types (Application, UserControl, DragEventArgs…). We reference WinForms fully
       qualified, so strip those implicit usings to keep WPF unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Let the test project reach internal members (e.g. Program.MatchOsLanguage). -->
  <ItemGroup>
    <InternalsVisibleTo Include="LuaToolsGui.Tests" />
  </ItemGroup>

  <!-- Make App.xaml a Page so the SDK doesn't auto-generate a Main that conflicts with Program.Main -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Embed icon.ico as a resource so the Window Icon="icon.ico" can resolve it at runtime -->
  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <!-- Nothing in public/ is bundled anymore. The frontend (luatools.js) is fetched from GitHub releases
       by PluginInstallerService into %AppData%\LuaToolsGui\plugin; the Millennium-aware polyfill is inline
       (CefInjectorService.BuildInlinePolyfill); and the manifest-source list falls back to the hardcoded
       defaults in HttpServerService when api.json is absent. -->


  <!-- Localization RESX. We hand-maintain Strings.Designer.cs (works under dotnet watch), so disable the
       SDK's auto-generated designer to avoid a duplicate Strings class. zh-Hans builds a satellite asm. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings*.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.1" />
    <!-- PINNED EXACTLY ([4.3.0], not 4.3.0). The Amethyst theme depends on WPF-UI's INTERNAL resource key
         names — SystemAccentColorPrimary plus the surface keys remapped in Themes/Colors.xaml — which are
         not a public contract and can change in any release. A floating version would let a restore pull a
         build where those keys moved: nothing fails to compile, nothing throws, and the app just quietly
         reverts to grey chrome. The bracket form makes NuGet refuse to substitute another version rather
         than resolve one silently. On a deliberate upgrade, run the app once and check the startup guard
         (App.VerifyAccentApplied), which documents how to remap the keys. -->
    <PackageReference Include="WPF-UI" Version="[4.3.0]" />
  </ItemGroup>

</Project>
