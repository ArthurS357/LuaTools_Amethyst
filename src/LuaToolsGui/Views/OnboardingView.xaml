<UserControl
    x:Class="LuaToolsGui.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Segmented Yes/No button: Primary when its bound bool matches this button's value. -->
        <Style x:Key="ChoiceButton" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Dim scrim + centered welcome card (in-window overlay, not a Popup). Visibility is controlled by
         the host in MainWindow via Onboarding.IsOpen. -->
    <Grid Background="{StaticResource ScrimLightBrush}">
        <Border
            MaxWidth="640"
            Margin="16"
            Padding="30,32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource SurfaceOverlayBrush}"
            BorderBrush="{StaticResource BorderProminentBrush}"
            BorderThickness="1"
            CornerRadius="14">
            <StackPanel>
                <!-- Title -->
                <TextBlock
                    FontSize="21"
                    FontWeight="Bold"
                    Text="{x:Static res:Strings.Onboarding_Title}"
                    TextWrapping="Wrap" />

                <!-- Sign in (guest only) -->
                <StackPanel Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        Margin="0,16,0,0"
                        FontSize="13"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="{x:Static res:Strings.Onboarding_SignIn_Blurb}"
                        TextWrapping="Wrap" />
                    <ui:Button
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Appearance="Primary"
                        Command="{Binding SignInCommand}"
                        Content="{x:Static res:Strings.Nav_SignInDiscord}"
                        Icon="{ui:SymbolIcon Person24}"
                        Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVis}}" />
                    <!-- Signing-in spinner -->
                    <StackPanel
                        Margin="0,10,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{x:Static res:Strings.Nav_WaitingForBrowser}" />
                    </StackPanel>
                    <!-- Sign-in error -->
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource DangerBrush}"
                        Text="{Binding StatusLine}"
                        TextWrapping="Wrap"
                        Visibility="{Binding StatusLine, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <!-- Signed-in confirmation -->
                <TextBlock
                    Margin="0,16,0,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SuccessTextBrush}"
                    Text="{x:Static res:Strings.Onboarding_SignedIn}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />

                <Border Height="1" Margin="0,24,0,0" Background="{StaticResource SurfaceStrongBrush}" />

                <!-- Apply recommended settings -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Onboarding_Recommended_Title}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}" Text="{x:Static res:Strings.Onboarding_Recommended_Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Command="{Binding SetApplyRecommendedCommand}" Content="{x:Static res:Strings.Onboarding_Yes}">
                            <ui:Button.CommandParameter><sys:Boolean>True</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplyRecommended}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Command="{Binding SetApplyRecommendedCommand}" Content="{x:Static res:Strings.Onboarding_No}">
                            <ui:Button.CommandParameter><sys:Boolean>False</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplyRecommended}" Value="False">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Install plugin -->
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Onboarding_Plugin_Title}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}" Text="{x:Static res:Strings.Onboarding_Plugin_Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Command="{Binding SetInstallPluginCommand}" Content="{x:Static res:Strings.Onboarding_Yes}">
                            <ui:Button.CommandParameter><sys:Boolean>True</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstallPlugin}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Command="{Binding SetInstallPluginCommand}" Content="{x:Static res:Strings.Onboarding_No}">
                            <ui:Button.CommandParameter><sys:Boolean>False</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstallPlugin}" Value="False">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Let's go! -->
                <ui:Button
                    Margin="0,28,0,0"
                    Padding="0,10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding FinishCommand}"
                    Content="{x:Static res:Strings.Onboarding_Go}"
                    FontSize="14"
                    IsEnabled="{Binding NotBusy}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
