<UserControl
    x:Class="LuaToolsGui.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Segmented Yes/No button: Primary when its bound bool matches this button's value. -->
        <Style x:Key="ChoiceButton" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="{DynamicResource SpaceLeft8}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Dim scrim + centered welcome card (in-window overlay, not a Popup). Visibility is controlled by
         the host in MainWindow via Onboarding.IsOpen. -->
    <Grid Background="{StaticResource ScrimLightBrush}">
        <Border
            MaxWidth="640"
            Margin="{DynamicResource SpaceAll16}"
            Padding="{DynamicResource SpaceAll32}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource SurfaceOverlayBrush}"
            BorderBrush="{StaticResource BorderProminentBrush}"
            Style="{StaticResource CardStyle}">
            <StackPanel>
                <!-- Title -->
                <TextBlock Style="{StaticResource TextTitle}" Text="{x:Static res:Strings.Onboarding_Title}" />

                <!-- Sign in (guest only) -->
                <StackPanel Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        Margin="{DynamicResource SpaceTop16}"
                        Foreground="{StaticResource TextMutedBrush}"
                        Style="{StaticResource TextBody}"
                        Text="{x:Static res:Strings.Onboarding_SignIn_Blurb}" />
                    <ui:Button
                        Margin="{DynamicResource SpaceTop12}"
                        HorizontalAlignment="Left"
                        Appearance="Primary"
                        Command="{Binding SignInCommand}"
                        Content="{x:Static res:Strings.Nav_SignInDiscord}"
                        Icon="{ui:SymbolIcon Person24}"
                        Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVis}}" />
                    <!-- Signing-in spinner -->
                    <StackPanel
                        Margin="{DynamicResource SpaceTop12}"
                        Orientation="Horizontal"
                        Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                        <TextBlock
                            Margin="{DynamicResource SpaceLeft8}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextMutedBrush}"
                            Style="{StaticResource TextCaption}"
                            Text="{x:Static res:Strings.Nav_WaitingForBrowser}" />
                    </StackPanel>
                    <!-- Sign-in error -->
                    <TextBlock
                        Margin="{DynamicResource SpaceTop8}"
                        Foreground="{StaticResource DangerBrush}"
                        Style="{StaticResource TextCaption}"
                        Text="{Binding StatusLine}"
                        Visibility="{Binding StatusLine, Converter={StaticResource NullToCollapsed}}" />
                    <!-- Any failed browser sign-in: one click to the /login code box (same as MainWindow). -->
                    <ui:Button
                        Margin="{DynamicResource SpaceTop8}"
                        HorizontalAlignment="Left"
                        Appearance="Secondary"
                        Command="{Binding UseManualCodeCommand}"
                        Content="{x:Static res:Strings.Auth_UseManualCode}"
                        Icon="{ui:SymbolIcon Key24}"
                        Visibility="{Binding StatusLine, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <!-- Signed-in confirmation -->
                <TextBlock
                    Margin="{DynamicResource SpaceTop16}"
                    Foreground="{StaticResource SuccessTextBrush}"
                    Style="{StaticResource TextBodyStrong}"
                    Text="{x:Static res:Strings.Onboarding_SignedIn}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />

                <Border Margin="{DynamicResource SpaceTop24}" Style="{StaticResource RowDividerStyle}" />

                <!-- Apply recommended settings -->
                <Grid Margin="{DynamicResource SpaceTop24}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Onboarding_Recommended_Title}" />
                        <TextBlock Margin="{DynamicResource SpaceTop4}" Foreground="{StaticResource TextDimBrush}" Style="{StaticResource TextCaption}" Text="{x:Static res:Strings.Onboarding_Recommended_Detail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="{DynamicResource SpaceLeft16}" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Command="{Binding SetApplyRecommendedCommand}" Content="{x:Static res:Strings.Onboarding_Yes}">
                            <ui:Button.CommandParameter><sys:Boolean>True</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplyRecommended}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Command="{Binding SetApplyRecommendedCommand}" Content="{x:Static res:Strings.Onboarding_No}">
                            <ui:Button.CommandParameter><sys:Boolean>False</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplyRecommended}" Value="False">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Install plugin -->
                <Grid Margin="{DynamicResource SpaceTop24}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Onboarding_Plugin_Title}" />
                        <TextBlock Margin="{DynamicResource SpaceTop4}" Foreground="{StaticResource TextDimBrush}" Style="{StaticResource TextCaption}" Text="{x:Static res:Strings.Onboarding_Plugin_Detail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="{DynamicResource SpaceLeft16}" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Command="{Binding SetInstallPluginCommand}" Content="{x:Static res:Strings.Onboarding_Yes}">
                            <ui:Button.CommandParameter><sys:Boolean>True</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstallPlugin}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Command="{Binding SetInstallPluginCommand}" Content="{x:Static res:Strings.Onboarding_No}">
                            <ui:Button.CommandParameter><sys:Boolean>False</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstallPlugin}" Value="False">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Let's go! -->
                <ui:Button
                    Margin="{DynamicResource SpaceTop32}"
                    Padding="{DynamicResource SpaceAll12}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding FinishCommand}"
                    Content="{x:Static res:Strings.Onboarding_Go}"
                    FontSize="{DynamicResource FontSizeSubtitle}"
                    IsEnabled="{Binding NotBusy}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
