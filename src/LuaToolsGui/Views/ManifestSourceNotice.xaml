<UserControl
    x:Class="LuaToolsGui.Views.ManifestSourceNotice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Focusable="False"
    mc:Ignorable="d">

    <!--
        Static guidance card. No view model, no commands, no network, no persisted state: it can be
        dropped anywhere and removed by deleting the one line that places it. Whether it shows at all is
        decided once in the constructor from AppConfig.ShowManifestSourceNotice.

        Accessibility notes:
        - The card is not focusable and contains nothing focusable, so it never inserts a tab stop ahead
          of the controls it sits above. Keyboard order through the page is unchanged.
        - The Border carries AutomationProperties.Name so the card is announced as a named notice; the
          four TextBlocks below are still in the automation tree and read in order, which is what a
          screen-reader user wants here — the detail IS the message.
        - The icon is decorative and repeats what the title says, so it is given an empty
          AutomationProperties.Name rather than being announced as an unlabelled element.
        - Colours come from theme tokens, so the card follows the accent and both light and dark ramps.
          Body text uses TextMutedBrush over AccentTintBrush, which is the same pairing the source cards
          directly below it already use.
    -->
    <Border
        Padding="12,10"
        AutomationProperties.Name="{x:Static res:Strings.Notice_Manifests_Title}"
        Background="{StaticResource AccentTintBrush}"
        BorderBrush="{StaticResource AccentOutlineBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon
                Margin="0,1,10,0"
                VerticalAlignment="Top"
                AutomationProperties.Name=""
                Focusable="False"
                Foreground="{StaticResource InfoBrush}"
                Symbol="Info24" />

            <StackPanel Grid.Column="1">
                <TextBlock
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Text="{x:Static res:Strings.Notice_Manifests_Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{x:Static res:Strings.Notice_Manifests_Source}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,3,0,0"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{x:Static res:Strings.Notice_Manifests_Lock}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,3,0,0"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{x:Static res:Strings.Notice_Manifests_Retry}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
