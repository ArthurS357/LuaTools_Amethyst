<UserControl
    x:Class="LuaToolsGui.Views.ManageListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:themes="clr-namespace:LuaToolsGui.Themes"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ManageViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root" MinHeight="36">
        <ListBox
            x:Name="GameList"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource ListItemStyle}"
            ItemsSource="{Binding ListItems}"
            PreviewKeyDown="List_PreviewKeyDown"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionMode="Single"
            VirtualizingPanel.CacheLength="1,1"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid
                        x:Name="RowRoot"
                        MinHeight="34"
                        themes:Motion.EnableSmoothHover="True"
                        Background="Transparent"
                        Cursor="Hand"
                        DataContextChanged="Row_DataContextChanged"
                        Loaded="Row_Loaded"
                        MouseLeftButtonUp="Row_Click">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.PlayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{Binding PlayLabel}"
                                    Icon="{ui:SymbolIcon Play24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_ViewDetails}"
                                    Icon="{ui:SymbolIcon Info24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.ManageBuildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_ManageBuild}"
                                    Icon="{ui:SymbolIcon BranchFork24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.UpdateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_Update}"
                                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.RemoveDrmCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_RemoveDrm}"
                                    Icon="{ui:SymbolIcon WrenchScrewdriver24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.SaveBackupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_SaveBackup}"
                                    Icon="{ui:SymbolIcon FolderZip24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.ImportSaveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_ImportSave}"
                                    Icon="{ui:SymbolIcon ArrowImport24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.OpenStorePageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_OpenStore}"
                                    Icon="{ui:SymbolIcon Globe24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.OpenInSteamCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_OpenInSteam}"
                                    Icon="{ui:SymbolIcon Open24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.RevealFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_Reveal}"
                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.CopyAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_CopyAppId}"
                                    Icon="{ui:SymbolIcon Copy24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Header="{x:Static res:Strings.Manage_RemoveGame}"
                                    Icon="{ui:SymbolIcon Delete24}" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <Grid.Tag>
                            <Binding ElementName="Root" Path="DataContext" />
                        </Grid.Tag>

                        <!-- GPU-composited hover & selection overlays (no Width/Height/Margin animations) -->
                        <Border
                            x:Name="HoverOverlay"
                            Background="{StaticResource SurfaceTintBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border
                            Background="{StaticResource AccentTintBrush}"
                            BorderBrush="{StaticResource AccentOutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="{DynamicResource SpaceAll4}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Multi-select checkbox -->
                            <CheckBox
                                Grid.Column="0"
                                MinWidth="0"
                                Margin="{DynamicResource SpaceLeft4}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Static res:Strings.Manage_Select}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                ToolTip="{x:Static res:Strings.Manage_Select}" />

                            <!-- Compact 36x20 Steam-library thumbnail (zero HTTP: shares cached BitmapImage) -->
                            <Border
                                Grid.Column="1"
                                Width="36"
                                Height="20"
                                Margin="{DynamicResource SpaceLeft8}"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceCardHoverBrush}"
                                ClipToBounds="True"
                                CornerRadius="{DynamicResource RadiusSmall}">
                                <Image
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Source="{Binding Cover}"
                                    Stretch="UniformToFill" />
                            </Border>

                            <!-- Title + subtle AppID (Steam-style active/installed emphasis vs muted) -->
                            <Grid Grid.Column="2" Margin="{DynamicResource SpaceLeft12}" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeBody}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="{DynamicResource SpaceLeft8}"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Text="{Binding AppIdText}" />
                            </Grid>

                            <!-- Right: Installed pill, save-location marker, compact dates, hover/focus remove -->
                            <StackPanel
                                Grid.Column="3"
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Border
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SuccessInsetBrush}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            Foreground="{StaticResource SuccessTextBrush}"
                                            Symbol="CheckmarkCircle24" />
                                        <TextBlock
                                            Margin="{DynamicResource SpaceLeft4}"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource SuccessTextBrush}"
                                            Text="{x:Static res:Strings.Manage_Badge_Installed}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Margin="{DynamicResource SpaceLeft8}"
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceInsetBrush}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    ToolTip="{Binding SaveLocationsTooltip}"
                                    Visibility="{Binding HasSaveLocations, Converter={StaticResource BoolToVis}}">
                                    <ui:SymbolIcon
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Symbol="Save24" />
                                </Border>

                                <TextBlock
                                    Margin="{DynamicResource SpaceLeft12}"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Text="{Binding AddedLabel}" />

                                <ui:Button
                                    Margin="{DynamicResource SpaceLeft8}"
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Static res:Strings.Manage_RemoveGame}"
                                    Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Icon="{ui:SymbolIcon Delete24}"
                                    ToolTip="{x:Static res:Strings.Manage_RemoveGame}">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Setter Property="Appearance" Value="Transparent" />
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowRoot}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
