<UserControl
    x:Class="LuaToolsGui.Views.BuildsDetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:BuildsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <!-- Full-width Detail state of Depots: top back/actions bar, game summary card,
         active preset switcher, and wide depot/DLC list + download picker. -->
    <UserControl.Resources>

        <!-- Borderless, hover-highlight button used as a clickable depot/DLC row (opens SteamDB). -->
        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="{DynamicResource SpaceAll8}" />
            <Setter Property="Margin" Value="{DynamicResource SpaceAll4}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One depot/DLC row: on/off switch, clickable → SteamDB block, and Lock tickbox. -->
        <DataTemplate x:Key="DepotRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="52" VerticalAlignment="Center">
                    <ui:ToggleSwitch
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.ToggleEnabledCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        IsChecked="{Binding IsEnabled, Mode=OneWay}"
                        IsEnabled="{Binding CanEnable}"
                        ToolTip="{x:Static res:Strings.Builds_Depot_EnableTip}"
                        Visibility="{Binding IsInLua, Converter={StaticResource BoolToVis}}" />
                </Border>

                <Button
                    Grid.Column="1"
                    Command="{Binding DataContext.OpenSteamDbCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource RowButtonStyle}"
                    ToolTip="{x:Static res:Strings.Confirm_OpenSteamDb}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="{DynamicResource FontSizeBody}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Grid.Column="1"
                                Margin="{DynamicResource SpaceLeft8}"
                                Padding="{DynamicResource SpaceAll4}"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceInsetBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Visibility="{Binding IsDlc, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentSoftBrush}"
                                    Text="DLC" />
                            </Border>
                            <Border
                                Grid.Column="1"
                                Margin="{DynamicResource SpaceLeft8}"
                                Padding="{DynamicResource SpaceAll4}"
                                VerticalAlignment="Center"
                                Background="{StaticResource WarningInsetBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource WarningSoftBrush}"
                                    Text="{x:Static res:Strings.Confirm_Shared}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Margin="{DynamicResource SpaceTop4}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{StaticResource TextDimBrush}"
                            Text="{Binding Meta}" />
                        <TextBlock
                            Margin="{DynamicResource SpaceTop4}"
                            FontFamily="Consolas"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Text="{Binding ManifestLabel}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding HasManifest, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            Margin="{DynamicResource SpaceTop4}"
                            FontFamily="Consolas"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{StaticResource WarningSoftBrush}"
                            Text="{Binding OutdatedLabel}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding IsOutdated, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Button>

                <CheckBox
                    Grid.Column="2"
                    MinWidth="0"
                    Margin="{DynamicResource SpaceLeft12}"
                    VerticalAlignment="Center"
                    Command="{Binding DataContext.ToggleLockCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    Content="{x:Static res:Strings.Builds_Depot_Lock}"
                    FontSize="{DynamicResource FontSizeCaption}"
                    IsChecked="{Binding IsLocked, Mode=OneWay}"
                    ToolTip="{x:Static res:Strings.Builds_Depot_LockTip}"
                    Visibility="{Binding CanLock, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- One entry in the build switcher -->
        <DataTemplate x:Key="VariantRowTemplate">
            <Grid Margin="{DynamicResource SpaceAll4}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="{DynamicResource FontSizeBody}"
                        FontWeight="SemiBold"
                        Text="{Binding Label}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="{DynamicResource FontSizeCaption}"
                        Foreground="{StaticResource TextDimBrush}"
                        Text="{Binding Meta}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Margin="{DynamicResource SpaceLeft8}"
                    Padding="{DynamicResource SpaceAll4}"
                    VerticalAlignment="Center"
                    Background="{StaticResource SuccessInsetBrush}"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontSize="{DynamicResource FontSizeCaption}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SuccessTextBrush}"
                        Text="{x:Static res:Strings.Builds_Active}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Full-width navigation + game-level actions -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button
                Command="{Binding BackToGridCommand}"
                Content="{x:Static res:Strings.Builds_BackToList}"
                Icon="{ui:SymbolIcon ChevronLeft24}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding SaveInPlaceCommand}"
                    Content="{Binding SaveInPlaceLabel}"
                    Icon="{ui:SymbolIcon Save24}"
                    Visibility="{Binding HasEditBase, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    Margin="{DynamicResource SpaceLeft8}"
                    Command="{Binding SaveAsPresetCommand}"
                    Content="{x:Static res:Strings.Builds_Action_SaveAsNew}"
                    Icon="{ui:SymbolIcon Bookmark24}"
                    Visibility="{Binding HasEditBase, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    Margin="{DynamicResource SpaceLeft8}"
                    Command="{Binding OpenInManageCommand}"
                    Content="{x:Static res:Strings.Nav_Manage}"
                    Icon="{ui:SymbolIcon Games24}"
                    IsEnabled="{Binding HasSelection}" />
                <ui:Button
                    Margin="{DynamicResource SpaceLeft8}"
                    Appearance="Danger"
                    Command="{Binding OpenRemoveFilesCommand}"
                    Content="{x:Static res:Strings.Builds_RemoveFiles}"
                    Icon="{ui:SymbolIcon Delete24}" />
                <ui:Button
                    Margin="{DynamicResource SpaceLeft8}"
                    Command="{Binding RefreshCommand}"
                    Content="{x:Static res:Strings.Manage_Refresh}"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
            </StackPanel>
        </Grid>

        <!-- Row 1: Game identity banner (cover + title + AppID + latest Steam build) -->
        <Border
            Grid.Row="1"
            Margin="{DynamicResource SpaceTop12}"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="184"
                    Height="86"
                    Background="{StaticResource SurfaceCardHoverBrush}"
                    ClipToBounds="True"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    DataContext="{Binding ActiveGame}">
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="{DynamicResource SpaceLeft16}"
                    VerticalAlignment="Center"
                    DataContext="{Binding ActiveGame}">
                    <TextBlock
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource TextTitle}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Margin="{DynamicResource SpaceTop4}"
                        Foreground="{StaticResource TextMutedBrush}"
                        Style="{StaticResource TextCaption}"
                        Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                    <Border
                        Margin="{DynamicResource SpaceTop8}"
                        Padding="{DynamicResource SpaceAll4}"
                        HorizontalAlignment="Left"
                        Background="{StaticResource WarningInsetBrush}"
                        BorderBrush="{StaticResource WarningOutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Visibility="{Binding SavedBuildsOnly, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            FontSize="{DynamicResource FontSizeCaption}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource WarningSoftBrush}"
                            Text="{x:Static res:Strings.Builds_SavedBuildsNoLua}" />
                    </Border>
                </StackPanel>

                <Border
                    Grid.Column="2"
                    Margin="{DynamicResource SpaceLeft12}"
                    Padding="{DynamicResource SpaceAll8}"
                    VerticalAlignment="Top"
                    Background="{StaticResource SurfaceInsetBrush}"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Visibility="{Binding LatestBuildLabel, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock
                        FontSize="{DynamicResource FontSizeCaption}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AccentSoftBrush}"
                        Text="{Binding LatestBuildLabel}" />
                </Border>
            </Grid>
        </Border>

        <!-- Row 2: Active preset switcher & preset-scoped actions -->
        <Border
            Grid.Row="2"
            Margin="{DynamicResource SpaceTop12}"
            Padding="{DynamicResource SpaceAll12}"
            Background="{StaticResource SurfaceCardBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMedium}">
            <StackPanel>
                <TextBlock
                    FontSize="{DynamicResource FontSizeCaption}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{x:Static res:Strings.Builds_ActiveBuild}" />

                <ComboBox
                    Margin="{DynamicResource SpaceTop8}"
                    HorizontalContentAlignment="Stretch"
                    ItemTemplate="{StaticResource VariantRowTemplate}"
                    ItemsSource="{Binding Variants}"
                    SelectedItem="{Binding SelectedVariant}" />

                <!-- Inline rename -->
                <Grid Margin="{DynamicResource SpaceTop8}" Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        PlaceholderText="{x:Static res:Strings.Builds_RenamePlaceholder}"
                        Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="{DynamicResource SpaceLeft8}"
                        Appearance="Primary"
                        Command="{Binding CommitRenameCommand}"
                        Content="{x:Static res:Strings.Builds_Action_Save}" />
                    <ui:Button
                        Grid.Column="2"
                        Margin="{DynamicResource SpaceLeft8}"
                        Command="{Binding CancelRenameCommand}"
                        Content="{x:Static res:Strings.Builds_Action_Cancel}" />
                </Grid>

                <UniformGrid
                    Margin="{DynamicResource SpaceTop8}"
                    Columns="4"
                    Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}">
                    <ui:Button
                        Margin="{DynamicResource SpaceAll4}"
                        HorizontalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding ApplyCommand}"
                        Content="{x:Static res:Strings.Builds_Action_Apply}"
                        Icon="{ui:SymbolIcon Checkmark24}"
                        IsEnabled="{Binding CanApply}" />
                    <ui:Button
                        Margin="{DynamicResource SpaceAll4}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding StartRenameCommand}"
                        Content="{x:Static res:Strings.Builds_Action_Rename}"
                        Icon="{ui:SymbolIcon Rename24}"
                        IsEnabled="{Binding CanRename}" />
                    <ui:Button
                        Margin="{DynamicResource SpaceAll4}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding EditCommand}"
                        Content="{x:Static res:Strings.Builds_Action_Edit}"
                        Icon="{ui:SymbolIcon Edit24}" />
                    <ui:Button
                        Margin="{DynamicResource SpaceAll4}"
                        HorizontalAlignment="Stretch"
                        Appearance="Danger"
                        Command="{Binding DeleteVariantCommand}"
                        Content="{x:Static res:Strings.Builds_Action_DeletePreset}"
                        Icon="{ui:SymbolIcon Delete24}"
                        IsEnabled="{Binding CanDelete}"
                        ToolTipService.ShowOnDisabled="True">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="ToolTip" Value="{x:Static res:Strings.Builds_Delete_ActiveTip}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Row 3A: Raw lua editor -->
        <Grid Grid.Row="3" Margin="{DynamicResource SpaceTop12}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                FontSize="{DynamicResource FontSizeCaption}"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="{x:Static res:Strings.Builds_Editor_Title}" />
            <TextBox
                Grid.Row="1"
                Margin="{DynamicResource SpaceTop8}"
                AcceptsReturn="True"
                AcceptsTab="True"
                Background="{StaticResource ShadowBrush}"
                FontFamily="Consolas"
                FontSize="{DynamicResource FontSizeCaption}"
                HorizontalScrollBarVisibility="Auto"
                Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                VerticalScrollBarVisibility="Auto" />
            <StackPanel
                Grid.Row="2"
                Margin="{DynamicResource SpaceTop8}"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Command="{Binding CancelEditCommand}"
                    Content="{x:Static res:Strings.Builds_Action_Cancel}" />
                <ui:Button
                    Margin="{DynamicResource SpaceLeft8}"
                    Command="{Binding SaveAsPresetCommand}"
                    Content="{x:Static res:Strings.Builds_Action_SaveAsPreset}"
                    Icon="{ui:SymbolIcon Bookmark24}" />
                <ui:Button
                    Margin="{DynamicResource SpaceLeft8}"
                    Appearance="Primary"
                    Command="{Binding SaveEditCommand}"
                    Content="{x:Static res:Strings.Builds_Action_Save}"
                    Icon="{ui:SymbolIcon Save24}" />
            </StackPanel>
        </Grid>

        <!-- Row 3B: Wide Depot / DLC breakdown + Depot download picker -->
        <Grid
            Grid.Row="3"
            Margin="{DynamicResource SpaceTop12}"
            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="{x:Static res:Strings.Builds_Depot_Search}"
                    Text="{Binding DepotSearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button
                    Grid.Column="1"
                    Margin="{DynamicResource SpaceLeft8}"
                    Command="{Binding StartDepotDownloadCommand}"
                    Content="{x:Static res:Strings.Builds_Depot_Download}"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    ToolTip="{x:Static res:Strings.Builds_Depot_PickHint}" />
            </Grid>

            <TextBlock
                Grid.Row="1"
                Margin="{DynamicResource SpaceTop12}"
                VerticalAlignment="Top"
                FontSize="{DynamicResource FontSizeCaption}"
                Foreground="{StaticResource TextDimBrush}"
                Text="{x:Static res:Strings.Builds_Depot_NoMatch}"
                TextWrapping="Wrap"
                Visibility="{Binding HasNoDepotMatches, Converter={StaticResource BoolToVis}}" />

            <ScrollViewer
                Grid.Row="1"
                Margin="{DynamicResource SpaceTop8}"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="{DynamicResource SpaceAll4}">
                    <StackPanel
                        Margin="{DynamicResource SpaceTop4}"
                        Orientation="Horizontal"
                        Visibility="{Binding IsLoadingDepots, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing
                            Width="16"
                            Height="16"
                            IsIndeterminate="True" />
                        <TextBlock
                            Margin="{DynamicResource SpaceLeft8}"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{x:Static res:Strings.Manage_LoadingDepotInfo}" />
                    </StackPanel>
                    <TextBlock
                        FontSize="{DynamicResource FontSizeCaption}"
                        Foreground="{StaticResource DangerBrush}"
                        Text="{Binding DepotError}"
                        TextWrapping="Wrap"
                        Visibility="{Binding DepotError, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock
                        Margin="{DynamicResource SpaceTop4}"
                        FontSize="{DynamicResource FontSizeCaption}"
                        Foreground="{StaticResource AccentBrush}"
                        Text="{x:Static res:Strings.Builds_Depot_InactiveNote}"
                        TextWrapping="Wrap"
                        Visibility="{Binding EditingInactiveBuild, Converter={StaticResource BoolToVis}}" />

                    <!-- In lua -->
                    <StackPanel Visibility="{Binding HasInLua, Converter={StaticResource BoolToVis}}">
                        <Button
                            Padding="0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ToggleInLuaCommand}"
                            Cursor="Hand">
                            <TextBlock
                                FontSize="{DynamicResource FontSizeBody}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding InLuaToggleLabel, Mode=OneWay}" />
                                <Run Foreground="{StaticResource TextDimBrush}" Text="{Binding InLuaCount, StringFormat='({0})', Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                        <ItemsControl
                            Margin="{DynamicResource SpaceTop8}"
                            ItemTemplate="{StaticResource DepotRowTemplate}"
                            ItemsSource="{Binding InLua}"
                            Visibility="{Binding IsInLuaExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Missing -->
                    <StackPanel Margin="{DynamicResource SpaceTop8}" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                        <Button
                            Padding="0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ToggleMissingCommand}"
                            Cursor="Hand">
                            <TextBlock
                                FontSize="{DynamicResource FontSizeBody}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource WarningSoftBrush}">
                                <Run Text="{Binding MissingToggleLabel, Mode=OneWay}" />
                                <Run Foreground="{StaticResource TextDimBrush}" Text="{Binding MissingCount, StringFormat='({0})', Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                        <StackPanel Visibility="{Binding IsMissingExpanded, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="{DynamicResource SpaceTop4}"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Foreground="{StaticResource TextDimBrush}"
                                Text="{x:Static res:Strings.Manage_MissingHint}"
                                TextWrapping="Wrap" />
                            <ItemsControl
                                Margin="{DynamicResource SpaceTop8}"
                                ItemTemplate="{StaticResource DepotRowTemplate}"
                                ItemsSource="{Binding Missing}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Unknown -->
                    <StackPanel Margin="{DynamicResource SpaceTop8}" Visibility="{Binding HasUnknown, Converter={StaticResource BoolToVis}}">
                        <Button
                            Padding="0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ToggleUnknownCommand}"
                            Cursor="Hand">
                            <TextBlock
                                FontSize="{DynamicResource FontSizeBody}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding UnknownToggleLabel, Mode=OneWay}" />
                                <Run Foreground="{StaticResource TextDimBrush}" Text="{Binding UnknownCount, StringFormat='({0})', Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                        <StackPanel Visibility="{Binding IsUnknownExpanded, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="{DynamicResource SpaceTop4}"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Foreground="{StaticResource TextDimBrush}"
                                Text="{x:Static res:Strings.Manage_UnknownHint}"
                                TextWrapping="Wrap" />
                            <ItemsControl
                                Margin="{DynamicResource SpaceTop8}"
                                ItemTemplate="{StaticResource DepotRowTemplate}"
                                ItemsSource="{Binding Unknown}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Download strip -->
            <Border
                Grid.Row="2"
                Margin="{DynamicResource SpaceTop8}"
                Padding="{DynamicResource SpaceAll12}"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Visibility="{Binding IsDepotStripVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock
                        FontSize="{DynamicResource FontSizeCaption}"
                        Foreground="{StaticResource DangerBrush}"
                        Text="{Binding DepotDownloadError}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasDepotError, Converter={StaticResource BoolToVis}}" />

                    <Grid Visibility="{Binding HasDepotResult, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{StaticResource SuccessTextBrush}"
                            Text="{Binding DepotDownloadDone}"
                            TextWrapping="Wrap" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="{DynamicResource SpaceLeft8}"
                            AutomationProperties.Name="{x:Static res:Strings.Nav_Downloads}"
                            Command="{Binding OpenDownloadsCommand}"
                            Content="{x:Static res:Strings.Nav_Downloads}"
                            Icon="{ui:SymbolIcon ArrowDownload24}" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="{DynamicResource SpaceLeft8}"
                            AutomationProperties.Name="{x:Static res:Strings.Builds_Depot_OpenFolder}"
                            Command="{Binding OpenDepotFolderCommand}"
                            Content="{x:Static res:Strings.Builds_Depot_OpenFolder}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Picker overlay -->
            <views:BuildsDepotPicker
                Grid.Row="0"
                Grid.RowSpan="3"
                Visibility="{Binding IsDepotPickerOpen, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
