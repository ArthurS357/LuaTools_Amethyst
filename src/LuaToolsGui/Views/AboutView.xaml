<UserControl
    x:Class="LuaToolsGui.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <!-- Page header + cards come from Themes/Controls.xaml (PageHeaderStyle, CardStyle), type sizes from
         Typography.xaml and spacing from Spacing.xaml, so this page reads as part of the same app as Home.
         Every colour comes from Themes/Colors.xaml — no literals.
         This is also the support page: the version, the update feed the updater will really use and where
         the settings live stay on the first screen, in the first two cards. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="8,16,16,24">

                <HeaderedContentControl Header="{x:Static res:Strings.About_Title}" Style="{StaticResource PageHeaderStyle}" />

                <!-- What this is, and WHICH build (the line a support request starts from) -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                Foreground="{StaticResource AccentBrush}"
                                Symbol="Info24" />
                            <TextBlock
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                Style="{StaticResource TextSubtitle}"
                                Text="{x:Static res:Strings.About_What_Header}" />
                        </StackPanel>
                        <TextBlock
                            Margin="{DynamicResource SpaceTop12}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Style="{StaticResource TextBody}"
                            Text="{x:Static res:Strings.About_What_Body}" />

                        <!-- Version -->
                        <TextBlock
                            Margin="{DynamicResource SpaceTop16}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextDimBrush}"
                            Text="{x:Static res:Strings.About_Version_Header}" />
                        <TextBlock
                            Margin="{DynamicResource SpaceTop4}"
                            FontSize="{DynamicResource FontSizeTitle}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}">
                            <Run Text="{Binding ProductName, Mode=OneWay}" />
                            <Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Margin="{DynamicResource SpaceTop16}" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                Foreground="{StaticResource AccentBrush}"
                                Symbol="ArrowSync24" />
                            <TextBlock
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                Style="{StaticResource TextSubtitle}"
                                Text="{x:Static res:Strings.About_Updates_Header}" />
                        </StackPanel>

                        <TextBlock
                            Margin="{DynamicResource SpaceTop12}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Style="{StaticResource TextBody}"
                            Text="{Binding UpdateStateText}" />

                        <!-- Resolved feed: what the updater will ACTUALLY use, not what settings.json says -->
                        <TextBlock
                            Margin="{DynamicResource SpaceTop16}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextDimBrush}"
                            Text="{x:Static res:Strings.About_Updates_Sources}" />
                        <Border
                            Margin="{DynamicResource SpaceTop4}"
                            Padding="{DynamicResource SpaceAll8}"
                            Background="{StaticResource SurfaceGhostBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="{DynamicResource FontSizeBody}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding UpdateSource}"
                                TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Margin="{DynamicResource SpaceTop16}" Orientation="Horizontal">
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding CheckForUpdatesCommand}"
                                Content="{x:Static res:Strings.About_Check_Button}"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                IsEnabled="{Binding IsIdle}" />
                            <ui:Button
                                Margin="{DynamicResource SpaceLeft8}"
                                Command="{Binding OpenRepositoryCommand}"
                                Content="{x:Static res:Strings.About_OpenRepo}"
                                Icon="{ui:SymbolIcon Open24}" />
                        </StackPanel>

                        <TextBlock
                            Margin="{DynamicResource SpaceTop12}"
                            Foreground="{StaticResource TextMutedBrush}"
                            Style="{StaticResource TextBody}"
                            Text="{Binding CheckResult}"
                            Visibility="{Binding CheckResult, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!-- Configuring updates by hand -->
                <Border Margin="{DynamicResource SpaceTop16}" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextMutedBrush}"
                                Symbol="Settings24" />
                            <TextBlock
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                Style="{StaticResource TextSubtitle}"
                                Text="{x:Static res:Strings.About_Config_Header}" />
                        </StackPanel>

                        <TextBlock
                            Margin="{DynamicResource SpaceTop12}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Style="{StaticResource TextBody}"
                            Text="{x:Static res:Strings.About_Config_Body}" />

                        <Border
                            Margin="{DynamicResource SpaceTop12}"
                            Padding="{DynamicResource SpaceAll8}"
                            Background="{StaticResource SurfaceGhostBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="{DynamicResource FontSizeBody}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding SettingsFolder}"
                                TextWrapping="Wrap" />
                        </Border>

                        <ui:Button
                            Margin="{DynamicResource SpaceTop12}"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenSettingsFolderCommand}"
                            Content="{x:Static res:Strings.About_OpenSettings}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </StackPanel>
                </Border>

                <!-- Changelog. Collapsed by default so it can't push "what this build is" below the fold.
                     Entries come from Resources/Changelog.cs — compiled in, so this renders identically
                     offline and cannot fail to load. -->
                <Border Margin="{DynamicResource SpaceTop16}" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                Foreground="{StaticResource AccentBrush}"
                                Symbol="History24" />
                            <TextBlock
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                Style="{StaticResource TextSubtitle}"
                                Text="{x:Static res:Strings.About_Changelog_Title}" />
                        </StackPanel>

                        <ui:Button
                            Margin="{DynamicResource SpaceTop12}"
                            HorizontalAlignment="Left"
                            Command="{Binding ToggleChangelogCommand}"
                            Content="{Binding ChangelogToggleText}"
                            Icon="{ui:SymbolIcon ChevronDown24}" />

                        <ItemsControl
                            Margin="{DynamicResource SpaceTop16}"
                            ItemsSource="{Binding Changelog}"
                            Visibility="{Binding IsChangelogOpen, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Padding="8,4"
                                                Background="{StaticResource AccentBadgeBrush}"
                                                BorderBrush="{StaticResource AccentOutlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSmall}">
                                                <TextBlock
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    Text="{Binding Version}" />
                                            </Border>
                                            <TextBlock
                                                Margin="{DynamicResource SpaceLeft12}"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                Foreground="{StaticResource TextDimBrush}"
                                                Text="{Binding Released}" />
                                        </StackPanel>

                                        <TextBlock
                                            Margin="{DynamicResource SpaceTop8}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Style="{StaticResource TextBody}"
                                            Text="{Binding Summary}" />

                                        <ItemsControl Margin="{DynamicResource SpaceTop8}" ItemsSource="{Binding Highlights}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="{DynamicResource SpaceTop4}" Orientation="Horizontal">
                                                        <TextBlock
                                                            Margin="0,0,8,0"
                                                            Foreground="{StaticResource AccentSoftBrush}"
                                                            Text="•" />
                                                        <TextBlock
                                                            MaxWidth="620"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Style="{StaticResource TextBody}"
                                                            Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
