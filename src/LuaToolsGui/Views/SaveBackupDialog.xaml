<ui:FluentWindow
    x:Class="LuaToolsGui.Views.SaveBackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    Title="{x:Static res:Strings.Saves_Title}"
    Width="560"
    Height="520"
    d:DataContext="{d:DesignInstance Type=vm:SaveBackupViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Saves_Title}" />

        <Grid x:Name="Root" Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="17"
                    FontWeight="Bold"
                    Text="{Binding GameName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11.5"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="11"
                    Foreground="{StaticResource WarningSoftBrush}"
                    Text="{x:Static res:Strings.Saves_Note}"
                    TextWrapping="Wrap" />
                <ui:Button
                    Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Command="{Binding CreateCommand}"
                    Content="{x:Static res:Strings.Saves_Create}"
                    Icon="{ui:SymbolIcon FolderZip24}"
                    IsEnabled="{Binding NotBusy}" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="12"
                Foreground="{StaticResource TextMutedBrush}"
                Text="{x:Static res:Strings.Saves_Empty}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <ListBox
                Grid.Row="1"
                Margin="0,12,0,0"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Items}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12.5"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Text="{Binding Subtitle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button
                                    Command="{Binding DataContext.RestoreCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="{x:Static res:Strings.Saves_Restore}"
                                    IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
                                <ui:Button
                                    Margin="6,0,0,0"
                                    Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="{x:Static res:Strings.Saves_Delete}"
                                    Foreground="{StaticResource DangerBrush}"
                                    IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ui:Button
                Grid.Row="2"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="{x:Static res:Strings.Saves_Close}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
