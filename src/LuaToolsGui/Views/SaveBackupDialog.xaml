<ui:FluentWindow
    x:Class="LuaToolsGui.Views.SaveBackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    Title="{x:Static res:Strings.Saves_Title}"
    Width="560"
    Height="660"
    d:DataContext="{d:DesignInstance Type=vm:SaveBackupViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Saves_Title}" />

        <Grid x:Name="Root" Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock
                    Style="{StaticResource TextSubtitle}"
                    Text="{Binding GameName}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Margin="{DynamicResource SpaceTop4}"
                    Style="{StaticResource TextCaption}"
                    Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                <TextBlock
                    Margin="{DynamicResource SpaceTop12}"
                    Style="{StaticResource TextBodyStrong}"
                    Text="{x:Static res:Strings.Saves_Locations_Title}" />
                <TextBlock
                    Margin="{DynamicResource SpaceTop4}"
                    Style="{StaticResource TextCaption}"
                    Text="{x:Static res:Strings.Saves_Locations_None}"
                    Visibility="{Binding HasNoLocations, Converter={StaticResource BoolToVis}}" />
                <ItemsControl
                    MaxHeight="130"
                    Margin="{DynamicResource SpaceTop4}"
                    ItemsSource="{Binding Locations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox
                                Margin="{DynamicResource SpaceTop4}"
                                IsChecked="{Binding IsSelected}"
                                IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="{DynamicResource FontSizeBody}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Location.Path}" />
                                    <TextBlock
                                        Foreground="{StaticResource TextDimBrush}"
                                        Style="{StaticResource TextCaption}"
                                        Text="{Binding Subtitle}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Margin="{DynamicResource SpaceTop8}"
                    HorizontalAlignment="Left"
                    Command="{Binding AddFolderCommand}"
                    Content="{x:Static res:Strings.Saves_AddFolder}"
                    Icon="{ui:SymbolIcon FolderAdd24}"
                    IsEnabled="{Binding NotBusy}" />
                <ui:Button
                    Margin="{DynamicResource SpaceTop12}"
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Command="{Binding CreateCommand}"
                    Content="{x:Static res:Strings.Saves_Create}"
                    Icon="{ui:SymbolIcon FolderZip24}"
                    IsEnabled="{Binding NotBusy}" />
                <ui:Button
                    Margin="{DynamicResource SpaceTop8}"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ImportCommand}"
                    Content="{x:Static res:Strings.Saves_Import}"
                    Icon="{ui:SymbolIcon ArrowImport24}"
                    IsEnabled="{Binding NotBusy}" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Margin="{DynamicResource SpaceTop24}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Style="{StaticResource TextCaption}"
                Text="{x:Static res:Strings.Saves_Empty}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <ListBox
                Grid.Row="1"
                Margin="{DynamicResource SpaceTop12}"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Items}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <!-- Rows are not selectable or tab stops here: the buttons inside them are. -->
                    <Style BasedOn="{StaticResource ListItemStyle}" TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeBody}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{StaticResource TextDimBrush}"
                                    Style="{StaticResource TextCaption}"
                                    Text="{Binding Subtitle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button
                                    Command="{Binding DataContext.RestoreCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="{x:Static res:Strings.Saves_Restore}"
                                    IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
                                <ui:Button
                                    Margin="{DynamicResource SpaceLeft8}"
                                    Appearance="Danger"
                                    Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="{x:Static res:Strings.Saves_Delete}"
                                    IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ui:Button
                Grid.Row="2"
                Margin="{DynamicResource SpaceTop16}"
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="{x:Static res:Strings.Saves_Close}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
