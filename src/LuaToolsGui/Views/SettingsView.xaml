<UserControl
    x:Class="LuaToolsGui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:LuaToolsGui.Views"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="8,16,8,24">
            <HeaderedContentControl Header="{x:Static res:Strings.Settings_Title}" Style="{StaticResource PageHeaderStyle}" />

            <!-- Account. The first header sits right under the page header, which already leaves the gap. -->
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionHeaderStyle}"
                Text="{x:Static res:Strings.Settings_Section_Account}" />
            <!-- One card holds the account row(s) + the lua.tools hint. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Signed-in account -->
                    <StackPanel Visibility="{Binding IsRealUser, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                CornerRadius="20">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextBodyStrong}" Text="{Binding DisplayName}" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Email}" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="2"
                                Margin="{DynamicResource SpaceLeft12}"
                                Command="{Binding SignOutCommand}"
                                Content="{x:Static res:Strings.Settings_SignOut}"
                                Icon="{ui:SymbolIcon SignOut24}" />
                        </Grid>

                        <!-- Bot-provisioned: prompt to re-link the full lua.tools account. -->
                        <Border
                            Margin="{DynamicResource SpaceTop12}"
                            Padding="{DynamicResource SpaceAll12}"
                            Background="{StaticResource WarningTintBrush}"
                            BorderBrush="{StaticResource WarningOutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Visibility="{Binding ShowBotLinkBanner, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Settings_BotLink_Title}" />
                                        <TextBlock
                                            Margin="{DynamicResource SpaceTop4}"
                                            Style="{StaticResource TextCaption}"
                                            Text="{x:Static res:Strings.Settings_BotLink_Body}" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="{DynamicResource SpaceLeft8}"
                                        VerticalAlignment="Top"
                                        Command="{Binding DismissBotBannerCommand}"
                                        Content="{x:Static res:Strings.Settings_BotLink_Dismiss}" />
                                </Grid>
                                <StackPanel Margin="{DynamicResource SpaceTop12}" Orientation="Horizontal">
                                    <ui:TextBox
                                        Width="120"
                                        CharacterCasing="Upper"
                                        MaxLength="6"
                                        PlaceholderText="{x:Static res:Strings.Settings_BotCode_Placeholder}"
                                        Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Margin="{DynamicResource SpaceLeft8}"
                                        Command="{Binding SignInWithCodeCommand}"
                                        Content="{x:Static res:Strings.Settings_BotCode_Redeem}"
                                        Icon="{ui:SymbolIcon Link24}"
                                        IsEnabled="{Binding CanRedeemCode}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="{DynamicResource SpaceTop8}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Style="{StaticResource TextCaption}"
                                    Text="{Binding CodeError}"
                                    Visibility="{Binding CodeError, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Guest -->
                    <StackPanel Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">

                        <!-- Login-required banner: shown when redirected from a protected action. -->
                        <Border
                            Margin="0,0,0,12"
                            Padding="{DynamicResource SpaceAll12}"
                            Background="{StaticResource InfoTintBrush}"
                            BorderBrush="{StaticResource InfoOutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Visibility="{Binding LoginRequiredMessage, Converter={StaticResource NullToCollapsed}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon
                                        FontSize="{DynamicResource FontSizeSubtitle}"
                                        Foreground="{StaticResource InfoBrush}"
                                        Symbol="Info24" />
                                    <TextBlock
                                        Margin="{DynamicResource SpaceLeft8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource TextBody}"
                                        Text="{Binding LoginRequiredMessage}" />
                                </StackPanel>
                                <!-- Glyph-only: IconButtonStyle makes the ToolTip the accessible name as well,
                                     and the explicit Name below is what AccessibilityDangerTests looks for. -->
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="{DynamicResource SpaceLeft8}"
                                    AutomationProperties.Name="{x:Static res:Strings.Settings_BotLink_Dismiss}"
                                    Command="{Binding DismissLoginRequiredCommand}"
                                    Content="✕"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="{x:Static res:Strings.Settings_BotLink_Dismiss}" />
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Settings_BrowsingAsGuest}" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="{x:Static res:Strings.Settings_GuestHint}" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                Appearance="Primary"
                                Command="{Binding SignInCommand}"
                                Content="{x:Static res:Strings.Settings_SignInDiscord}"
                                Icon="{ui:SymbolIcon Person24}" />
                        </Grid>

                        <!-- Discord bot code: redeem a /login code without the browser flow. -->
                        <Border Margin="{DynamicResource SpaceTop12}" Style="{StaticResource RowDividerStyle}" />
                        <TextBlock
                            Margin="{DynamicResource SpaceTop12}"
                            Style="{StaticResource TextCaption}"
                            Text="{x:Static res:Strings.Settings_BotCode_Hint}" />
                        <StackPanel Margin="{DynamicResource SpaceTop8}" Orientation="Horizontal">
                            <ui:TextBox
                                x:Name="CodeBox"
                                Width="120"
                                CharacterCasing="Upper"
                                MaxLength="6"
                                PlaceholderText="{x:Static res:Strings.Settings_BotCode_Placeholder}"
                                Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Margin="{DynamicResource SpaceLeft8}"
                                Command="{Binding SignInWithCodeCommand}"
                                Content="{x:Static res:Strings.Settings_BotCode_Redeem}"
                                Icon="{ui:SymbolIcon Key24}"
                                IsEnabled="{Binding CanRedeemCode}" />
                        </StackPanel>
                        <TextBlock
                            Margin="{DynamicResource SpaceTop8}"
                            Foreground="{StaticResource DangerBrush}"
                            Style="{StaticResource TextCaption}"
                            Text="{Binding CodeError}"
                            Visibility="{Binding CodeError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hubcap API key -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Section_Hubcap}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Active key: stats card -->
                    <StackPanel Visibility="{Binding HubcapIsKeyConfigured, Converter={StaticResource BoolToVis}}">
                        <!-- Key-expiry warning. Deliberately the FIRST thing in the configured block and
                             not a tooltip or a hover state: the expiry date was already on the usage line
                             below, and being present is exactly what it was not — a date among numbers is
                             read as decoration. Collapsed unless HubcapExpiryWarning is non-null, which is
                             also the only thing that decides the wording, so the row and its text cannot
                             disagree. A failed stats call leaves it null, so a dropped connection never
                             invents a warning about a healthy key. -->
                        <Border
                            Margin="0,0,0,12"
                            Padding="{DynamicResource SpaceAll8}"
                            Background="{StaticResource SurfaceGhostBrush}"
                            BorderBrush="{Binding HubcapExpiryWarningColor, Converter={StaticResource ResourceKeyToBrush}}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Visibility="{Binding HubcapExpiryWarning, Converter={StaticResource NullToCollapsed}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Icon carries no information the text doesn't; it is there so the row
                                     reads as an alert at a glance rather than as one more line of copy. -->
                                <ui:SymbolIcon
                                    VerticalAlignment="Top"
                                    FontSize="{DynamicResource FontSizeSubtitle}"
                                    Foreground="{Binding HubcapExpiryWarningColor, Converter={StaticResource ResourceKeyToBrush}}"
                                    Symbol="Warning24" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="{DynamicResource SpaceLeft8}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Style="{StaticResource TextCaption}"
                                    Text="{Binding HubcapExpiryWarning}" />
                            </Grid>
                        </Border>
                        <!-- Active badge + Refresh -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                HorizontalAlignment="Left"
                                Appearance="Secondary"
                                Command="{Binding RefreshHubcapStatsCommand}"
                                Content="{x:Static res:Strings.Settings_HubcapRefresh}"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                Grid.Column="1"
                                Appearance="Danger"
                                Command="{Binding ClearHubcapKeyCommand}"
                                Content="{x:Static res:Strings.Settings_HubcapClear}"
                                Icon="{ui:SymbolIcon Dismiss24}" />
                        </Grid>
                        <!-- Usage progress card -->
                        <Border
                            Margin="{DynamicResource SpaceTop12}"
                            Padding="{DynamicResource SpaceAll12}"
                            Background="{StaticResource SurfaceGhostBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Visibility="{Binding ShowHubcapStats, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Real ProgressBar (Fluent-styled, same as PluginView/ModeView/FixesView).
                                     HubcapUsagePercent is 0.0–1.0, so Maximum="1"; ProgressBar clamps past it.
                                     Indeterminate (animated) until stats load, so the card is never blank. -->
                                <ProgressBar
                                    Height="6"
                                    IsIndeterminate="{Binding HubcapStatsPending}"
                                    Maximum="1"
                                    Minimum="0"
                                    Value="{Binding HubcapUsagePercent, Mode=OneWay}" />
                                <TextBlock
                                    Margin="{DynamicResource SpaceTop8}"
                                    Style="{StaticResource TextBody}"
                                    Text="{Binding HubcapStatsText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Key input: only while NO key is saved. Once configured, the Refresh/Clear buttons +
                         usage card above are the whole story; "Clear" is how you swap keys (it resets
                         HubcapIsKeyConfigured, bringing this block back). The onboarding copy below reads
                         wrong when a key already exists, hence the collapse. -->
                    <StackPanel Visibility="{Binding HubcapIsKeyConfigured, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Settings_HubcapKey}" />
                        <TextBlock
                            Margin="{DynamicResource SpaceTop4}"
                            Style="{StaticResource TextCaption}"
                            Text="{x:Static res:Strings.Settings_HubcapKey_Hint}" />
                        <Grid Margin="{DynamicResource SpaceTop8}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- PasswordBox, not TextBox. The key is a bearer credential: typed or pasted
                                 in plain sight it is readable by anyone behind the user, by a screen share,
                                 and by any screenshot of the Settings page. Masking costs nothing here
                                 because the field is write-only in practice — a saved key is never read
                                 back into it (HubcapKeyInput starts blank and is cleared on save), so this
                                 box only ever holds what the user is entering right now.

                                 RevealButtonEnabled stays on: a 100-character key pasted from a website is
                                 exactly the case where a user needs to confirm it arrived intact, and the
                                 reveal is a deliberate act on a value they are holding in the clipboard
                                 anyway. Removing it would trade a real usability loss for no secrecy the
                                 clipboard has not already given away.

                                 Password is a plain DP with a change callback, so the binding needs an
                                 explicit Mode=TwoWay — it does not default to one. -->
                            <ui:PasswordBox
                                FontFamily="Consolas"
                                Password="{Binding HubcapKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{x:Static res:Strings.Settings_HubcapKeyPlaceholder}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="{DynamicResource SpaceLeft8}"
                                Appearance="Primary"
                                Command="{Binding ValidateAndSaveHubcapKeyCommand}"
                                Content="{x:Static res:Strings.Settings_HubcapValidate}"
                                IsEnabled="{Binding CanEditHubcapKey}" />
                        </Grid>
                        <!-- Error text (only ever set by the two ValidateAndSaveHubcapKeyAsync failure paths,
                             so it can never be orphaned by this collapse). -->
                        <TextBlock
                            Margin="{DynamicResource SpaceTop8}"
                            Foreground="{Binding HubcapKeyStatusColor, Converter={StaticResource ResourceKeyToBrush}}"
                            Style="{StaticResource TextCaption}"
                            Text="{Binding HubcapKeyStatus}"
                            Visibility="{Binding HubcapKeyStatus, Converter={StaticResource NullToCollapsed}}" />
                        <!-- "Get a key" link -->
                        <TextBlock
                            Margin="{DynamicResource SpaceTop8}"
                            Foreground="{StaticResource TextDimBrush}"
                            Style="{StaticResource TextCaption}">
                            <Run Text="{x:Static res:Strings.Settings_HubcapGetKey}" />
                            <Hyperlink Command="{Binding OpenHubcapCommand}" Foreground="{StaticResource AccentBrush}">hubcapmanifest.com</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Install behavior (Auto Update Apps + FastFetch) -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Section_Install}" />
            <Border Padding="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Auto Update Apps -->
                    <Grid Margin="{DynamicResource SpaceAll16}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Settings_AutoUpdateApps}" />
                            <TextBlock
                                Margin="{DynamicResource SpaceTop4}"
                                Style="{StaticResource TextCaption}"
                                Text="{x:Static res:Strings.Settings_AutoUpdateApps_Hint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="{DynamicResource SpaceLeft12}"
                            VerticalAlignment="Center"
                            IsChecked="{Binding AutoUpdateApps, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDividerStyle}" />
                    <!-- FastFetch (same persisted setting as the Add screen's toggle) -->
                    <Grid Margin="{DynamicResource SpaceAll16}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Add_FastFetch}" />
                            <TextBlock
                                Margin="{DynamicResource SpaceTop4}"
                                Style="{StaticResource TextCaption}"
                                Text="{x:Static res:Strings.Add_FastFetch_Hint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="{DynamicResource SpaceLeft12}"
                            VerticalAlignment="Center"
                            IsChecked="{Binding FastFetch, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network (Cloudflare DoH fallback mode). Applies live: SettingsService publishes it to the
                 shared DnsFallbackSession and the HTTP handler reads the mode on every request. -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Section_Network}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Settings_Dns}" />
                    <ComboBox
                        Margin="{DynamicResource SpaceTop8}"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Static res:Strings.Settings_Dns}"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding DnsModeOptions}"
                        SelectedItem="{Binding SelectedDnsMode}" />
                    <TextBlock
                        Margin="{DynamicResource SpaceTop8}"
                        Style="{StaticResource TextCaption}"
                        Text="{x:Static res:Strings.Settings_Dns_Hint}" />
                </StackPanel>
            </Border>

            <!-- General (language) -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Section_General}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Settings_Language}" />
                    <ComboBox
                        Margin="{DynamicResource SpaceTop8}"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding LanguageOptions}"
                        SelectedItem="{Binding SelectedLanguage}" />
                    <TextBlock
                        Margin="{DynamicResource SpaceTop8}"
                        Style="{StaticResource TextCaption}"
                        Text="{x:Static res:Strings.Settings_Language_Hint}" />

                    <!-- Accent colour. Unlike the language above this needs no relaunch: App mutates the
                         palette brush objects in place, so views holding them by StaticResource repaint.
                         That only works because Themes/Colors.xaml declares each Colour through
                         {DynamicResource} — a brush with a literal colour is frozen by WPF as soon as
                         Application.Resources owns the dictionary, and a frozen brush never repaints.

                         Picking does NOT apply. The button beside the box does, and it is disabled unless
                         the picker differs from what is painted, so "already applied" reads off the
                         control instead of being discovered by clicking and seeing nothing happen. -->
                    <TextBlock
                        Margin="{DynamicResource SpaceTop16}"
                        Style="{StaticResource TextBodyStrong}"
                        Text="{x:Static res:Strings.Settings_Accent}" />
                    <StackPanel Margin="{DynamicResource SpaceTop8}" Orientation="Horizontal">
                        <ComboBox
                            MinWidth="220"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding AccentOptions}"
                            SelectedItem="{Binding SelectedAccent}" />
                        <!-- IsEnabled is not bound: a Button driven by a Command already disables itself
                             from CanExecute, and binding it as well would give the same state two owners. -->
                        <ui:Button
                            Margin="{DynamicResource SpaceLeft8}"
                            Appearance="Primary"
                            Command="{Binding ApplyAccentChangeCommand}"
                            Content="{x:Static res:Strings.Settings_Accent_Apply}"
                            Icon="{ui:SymbolIcon Checkmark24}" />
                    </StackPanel>
                    <TextBlock
                        Margin="{DynamicResource SpaceTop8}"
                        Style="{StaticResource TextCaption}"
                        Text="{x:Static res:Strings.Settings_Accent_Hint}" />

                    <!-- Glass effect. Applies live, like the accent (MainWindow.ApplyGlass); off = the solid
                         window, also what Windows 10 and high contrast always get (Themes/GlassPolicy.cs). -->
                    <Grid Margin="{DynamicResource SpaceTop16}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Settings_Glass}" />
                            <TextBlock
                                Margin="{DynamicResource SpaceTop4}"
                                Style="{StaticResource TextCaption}"
                                Text="{x:Static res:Strings.Settings_Glass_Hint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="{DynamicResource SpaceLeft12}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static res:Strings.Settings_Glass}"
                            IsChecked="{Binding EnableGlassmorphism, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Steam -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Section_Steam}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Settings_SteamLocation}" />
                    <Grid Margin="{DynamicResource SpaceTop8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            IsReadOnly="True"
                            Text="{Binding SteamPath, Mode=OneWay}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="{DynamicResource SpaceLeft8}"
                            Command="{Binding OverrideSteamFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Change}" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="{DynamicResource SpaceLeft8}"
                            Command="{Binding OpenSteamFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Open}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="{DynamicResource SpaceLeft8}"
                            Command="{Binding ClearSteamOverrideCommand}"
                            Content="{x:Static res:Strings.Settings_ResetToAuto}"
                            Visibility="{Binding IsSteamOverridden, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock
                        Margin="{DynamicResource SpaceTop8}"
                        Foreground="{StaticResource TextDimBrush}"
                        Style="{StaticResource TextCaption}"
                        Text="{Binding SteamSource}" />
                    <TextBlock
                        Margin="{DynamicResource SpaceTop8}"
                        Foreground="{StaticResource DangerBrush}"
                        Style="{StaticResource TextCaption}"
                        Text="{Binding SteamWarning}"
                        Visibility="{Binding SteamWarning, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock
                        Margin="{DynamicResource SpaceTop16}"
                        Style="{StaticResource TextBodyStrong}"
                        Text="{x:Static res:Strings.Settings_SaveBackupFolder}" />
                    <Grid Margin="{DynamicResource SpaceTop8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            IsReadOnly="True"
                            Text="{Binding SaveBackupFolder, Mode=OneWay}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="{DynamicResource SpaceLeft8}"
                            Command="{Binding ChangeSaveBackupFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Change}" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="{DynamicResource SpaceLeft8}"
                            Command="{Binding OpenSaveBackupFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Open}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="{DynamicResource SpaceLeft8}"
                            Command="{Binding ResetSaveBackupFolderCommand}"
                            Content="{x:Static res:Strings.Settings_ResetToAuto}"
                            Visibility="{Binding IsSaveBackupFolderCustom, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock
                        Margin="{DynamicResource SpaceTop8}"
                        Style="{StaticResource TextCaption}"
                        Text="{x:Static res:Strings.Settings_SaveBackupFolder_Hint}" />

                    <TextBlock
                        Margin="{DynamicResource SpaceTop16}"
                        Style="{StaticResource TextBodyStrong}"
                        Text="{x:Static res:Strings.Settings_CustomSaveFolders}" />
                    <TextBlock
                        Margin="{DynamicResource SpaceTop4}"
                        Style="{StaticResource TextCaption}"
                        Text="{x:Static res:Strings.Settings_CustomSaveFolders_Hint}" />
                    <ItemsControl Margin="{DynamicResource SpaceTop8}" ItemsSource="{Binding CustomSaveFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{DynamicResource SpaceTop4}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        MinWidth="80"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Text="{Binding AppId}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Text="{Binding Path}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Path}" />
                                    <ui:Button
                                        Grid.Column="2"
                                        Margin="{DynamicResource SpaceLeft8}"
                                        Command="{Binding DataContext.RemoveCustomSaveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{x:Static res:Strings.Settings_CustomSaveFolders_Remove}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="{DynamicResource SpaceTop8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            PlaceholderText="{x:Static res:Strings.Settings_CustomSaveFolders_AppId}"
                            Text="{Binding NewCustomSaveAppId, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="{DynamicResource SpaceLeft8}"
                            Command="{Binding AddCustomSaveFolderCommand}"
                            Content="{x:Static res:Strings.Settings_CustomSaveFolders_Add}"
                            Icon="{ui:SymbolIcon FolderAdd24}" />
                    </Grid>
                    <TextBlock
                        Margin="{DynamicResource SpaceTop8}"
                        Foreground="{StaticResource DangerBrush}"
                        Style="{StaticResource TextCaption}"
                        Text="{Binding CustomSaveFolderError}"
                        Visibility="{Binding CustomSaveFolderError, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>

            <!-- Startup -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Section_Startup}" />
            <Border Padding="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Start with Windows -->
                    <Grid Margin="{DynamicResource SpaceAll16}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Settings_StartWithWindows}" />
                            <TextBlock
                                Margin="{DynamicResource SpaceTop4}"
                                Style="{StaticResource TextCaption}"
                                Text="{x:Static res:Strings.Settings_StartWithWindows_Hint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="{DynamicResource SpaceLeft12}"
                            VerticalAlignment="Center"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDividerStyle}" />
                    <!-- Minimize to System Tray -->
                    <Grid Margin="{DynamicResource SpaceAll16}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Settings_MinimizeToTray}" />
                            <TextBlock
                                Margin="{DynamicResource SpaceTop4}"
                                Style="{StaticResource TextCaption}"
                                Text="{x:Static res:Strings.Settings_MinimizeToTray_Hint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="{DynamicResource SpaceLeft12}"
                            VerticalAlignment="Center"
                            IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Maintenance (SettingsBackupsSection): own view-model (BackupCleanupViewModel), set as its
                 DataContext from code-behind. -->
            <local:SettingsBackupsSection x:Name="BackupsSection" />

            <!-- The "Community" section held a single toggle: donate Steam decryption keys. That feature
                 was removed (it uploaded keys over plain HTTP and defaulted to on), so the whole section
                 goes with it rather than leaving an empty card. -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
