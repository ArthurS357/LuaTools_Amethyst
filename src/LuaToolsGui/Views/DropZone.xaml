<UserControl
    x:Class="LuaToolsGui.Views.DropZone"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DropInstallViewModel}"
    AllowDrop="True"
    DragEnter="OnDragEnter"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop"
    mc:Ignorable="d">

    <Grid>
        <!-- The drop box -->
        <Border
            MinHeight="92"
            Padding="16,14"
            CornerRadius="10"
            SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceGhostBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SurfacePressedBrush}" />
                    <Setter Property="BorderThickness" Value="1.4" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentBadgeBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ui:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="22"
                    Foreground="{StaticResource AccentBrush}"
                    Symbol="ArrowDownload24" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{x:Static res:Strings.Drop_Title}" />
                    <!-- The box also takes a dragged SteamDB / Steam store link (installs that appid) —
                         a separate line because Drop_Title is already translated into 29 languages and
                         rewording it would leave every one of them describing the old behaviour. -->
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="{x:Static res:Strings.Drop_LinkHint}" />

                    <!-- Alternative to dragging: pick files from a dialog. Reuses the same install path. -->
                    <ui:Button
                        Margin="0,8,0,0"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        Click="OnBrowseClick"
                        Content="{x:Static res:Strings.Drop_BrowseFiles}"
                        FontSize="11.5"
                        Icon="{ui:SymbolIcon FolderOpen24}" />

                    <!-- Result banner (inline under the hint) -->
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Text="{Binding ResultText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
