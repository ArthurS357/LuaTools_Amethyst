<UserControl
    x:Class="LuaToolsGui.Views.ManageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:themes="clr-namespace:LuaToolsGui.Themes"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DataContext="{d:DesignInstance Type=vm:ManageViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Filter/sort ComboBox item display: shows the localized label while the bound value stays the
             English key (so ManageViewModel's switch/equality logic is untouched). -->
        <DataTemplate x:Key="FilterOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
        </DataTemplate>

        <!-- The depot/DLC breakdown (RowButtonStyle + DepotRowTemplate) moved to BuildsView, which shows
             it per build along with each depot's manifest pin. -->
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <HeaderedContentControl
            Grid.Row="0"
            Header="{x:Static res:Strings.Manage_Title}"
            Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding ShowLaunchOverridesCommand}"
                    Content="{x:Static res:Strings.Launch_Overrides_Title}" />
                <ui:Button
                    Command="{Binding RefreshCommand}"
                    Content="{x:Static res:Strings.Manage_Refresh}"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
            </StackPanel>
        </HeaderedContentControl>

        <!-- Search + View mode toggle + Filters toggle -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <views:ViewModeToggle
                Grid.Column="1"
                Margin="{DynamicResource SpaceLeft8}"
                ViewMode="{Binding ViewMode, Mode=TwoWay}" />
            <ui:Button
                Grid.Column="2"
                Margin="{DynamicResource SpaceLeft8}"
                Command="{Binding ToggleFilterPanelCommand}"
                Content="{x:Static res:Strings.Manage_Filters}"
                Icon="{ui:SymbolIcon Filter24}" />
        </Grid>

        <!-- Collapsible filter panel -->
        <Border
            Grid.Row="2"
            Margin="{DynamicResource SpaceTop8}"
            Style="{StaticResource CardStyle}"
            Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Dropdown row (left) + Clear button (right) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" Text="{x:Static res:Strings.Manage_Filter_Type}" />
                            <ComboBox MinWidth="120" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" Text="{x:Static res:Strings.Manage_Filter_Genre}" />
                            <ComboBox MinWidth="140" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding GenreOptions}" SelectedItem="{Binding SelectedGenre}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" Text="{x:Static res:Strings.Manage_Filter_Year}" />
                            <ComboBox MinWidth="90" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" Text="{x:Static res:Strings.Manage_Filter_Price}" />
                            <ComboBox MinWidth="90" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding PriceOptions}" SelectedItem="{Binding SelectedPrice}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" Text="{x:Static res:Strings.Manage_Filter_Content}" />
                            <ComboBox MinWidth="120" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding ContentOptions}" SelectedItem="{Binding SelectedContent}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" Text="{x:Static res:Strings.Manage_Filter_SortBy}" />
                            <ComboBox MinWidth="150" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Clear filters: right-aligned, vertically centered in the row. -->
                    <ui:Button
                        Grid.Column="1"
                        Margin="{DynamicResource SpaceLeft12}"
                        VerticalAlignment="Center"
                        Command="{Binding ClearFiltersCommand}"
                        Content="{x:Static res:Strings.Manage_ClearFilters}"
                        FontSize="{DynamicResource FontSizeCaption}"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- "Still fetching details" notice -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding HasPendingDetails, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="{DynamicResource SpaceLeft8}"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSizeCaption}"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="{Binding FilterPendingText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Virtualized Grid / Steam-style List container (zero extra I/O when toggling mode) -->
        <Grid
            Grid.Row="3"
            Margin="{DynamicResource SpaceTop12}"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
            <vwp:VirtualizingItemsControl
                x:Name="TileScroller"
                ItemsSource="{Binding GridItems}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}"
                VirtualizingPanel.CacheLength="1,1"
                VirtualizingPanel.CacheLengthUnit="Page"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <vwp:VirtualizingItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel
                            Orientation="Horizontal"
                            SpacingMode="StartAndEndOnly"
                            StretchItems="False" />
                    </ItemsPanelTemplate>
                </vwp:VirtualizingItemsControl.ItemsPanel>
                <vwp:VirtualizingItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="TileRoot"
                            Width="248"
                            Height="208"
                            Margin="0,0,12,12"
                            themes:Motion.EnableSmoothHover="True"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            CornerRadius="{DynamicResource RadiusLarge}"
                            DataContextChanged="Tile_DataContextChanged"
                            Loaded="Tile_Loaded"
                            MouseLeftButtonUp="Tile_Click">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.PlayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{Binding PlayLabel}"
                                    Icon="{ui:SymbolIcon Play24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_ViewDetails}"
                                    Icon="{ui:SymbolIcon Info24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.ManageBuildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_ManageBuild}"
                                    Icon="{ui:SymbolIcon BranchFork24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.UpdateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_Update}"
                                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.RemoveDrmCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_RemoveDrm}"
                                    Icon="{ui:SymbolIcon WrenchScrewdriver24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.SaveBackupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_SaveBackup}"
                                    Icon="{ui:SymbolIcon FolderZip24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.ImportSaveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_ImportSave}"
                                    Icon="{ui:SymbolIcon ArrowImport24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.OpenStorePageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_OpenStore}"
                                    Icon="{ui:SymbolIcon Globe24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.OpenInSteamCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_OpenInSteam}"
                                    Icon="{ui:SymbolIcon Open24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.RevealFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_Reveal}"
                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.CopyAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_CopyAppId}"
                                    Icon="{ui:SymbolIcon Copy24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Header="{x:Static res:Strings.Manage_RemoveGame}"
                                    Icon="{ui:SymbolIcon Delete24}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <!-- Tag carries the page VM so the ContextMenu (outside the visual tree) can reach its commands. -->
                        <Border.Tag>
                            <Binding ElementName="Root" Path="DataContext" />
                        </Border.Tag>
                        <Grid>
                        <StackPanel>
                            <!-- Cover (with a hover delete button) -->
                            <Border
                                Height="116"
                                Background="{StaticResource SurfaceCardHoverBrush}"
                                CornerRadius="10,10,0,0"
                                ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    <!-- Installed badge: Steam's manifest says the game is fully on disk -->
                                    <Border
                                        Margin="6,0,0,6"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource SuccessScrimBrush}"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                Foreground="White"
                                                Symbol="CheckmarkCircle24" />
                                            <TextBlock
                                                Margin="{DynamicResource SpaceLeft4}"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{x:Static res:Strings.Manage_Badge_Installed}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Save icon: saves were found for this game (Steam userdata, Documents, AppData…) -->
                                    <Border
                                        Margin="0,0,6,6"
                                        Padding="5,3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource ScrimPanelBrush}"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        ToolTip="{Binding SaveLocationsTooltip}"
                                        Visibility="{Binding HasSaveLocations, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            Foreground="White"
                                            Symbol="Save24" />
                                    </Border>
                                    <!-- Selection toggle: matches the delete button; shows on hover or while selected -->
                                    <ui:Button
                                        Margin="6,6,0,0"
                                        Padding="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Click="ToggleSelect_Click"
                                        Icon="{ui:SymbolIcon Checkmark24}"
                                        ToolTip="{x:Static res:Strings.Manage_Select}">
                                        <ui:Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="Background" Value="{StaticResource ScrimPanelBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="Background" Value="{StaticResource SuccessScrimBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <ui:Button
                                        Margin="0,6,6,0"
                                        Padding="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource DangerScrimBrush}"
                                        Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        ToolTip="{x:Static res:Strings.Manage_RemoveGame}">
                                        <ui:Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <!-- Reveal on tile hover -->
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </Grid>
                            </Border>
                            <!-- Info -->
                            <StackPanel Margin="12,10,12,12">
                                <TextBlock
                                    Height="36"
                                    FontSize="{DynamicResource FontSizeBody}"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="{DynamicResource SpaceTop4}"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                                <TextBlock
                                    Margin="{DynamicResource SpaceTop4}"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{StaticResource TextDisabledBrush}"
                                    Text="{Binding AddedReleaseLabel}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <Border
                            x:Name="HoverOverlay"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusLarge}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </vwp:VirtualizingItemsControl.ItemTemplate>
        </vwp:VirtualizingItemsControl>
            <views:ManageListView
                x:Name="GameListView"
                Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Loading state (first run downloads the Steam app list) -->
        <StackPanel
            Grid.Row="3"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing
                Width="20"
                Height="20"
                IsIndeterminate="True" />
            <TextBlock
                Margin="{DynamicResource SpaceLeft12}"
                VerticalAlignment="Center"
                FontSize="{DynamicResource FontSizeBody}"
                Foreground="{StaticResource TextMutedBrush}"
                Text="{x:Static res:Strings.Manage_LoadingGames}" />
        </StackPanel>

        <!-- Empty state -->
        <StackPanel
            Grid.Row="3"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="{StaticResource TextDisabledBrush}"
                Symbol="Games24" />
            <TextBlock
                Margin="{DynamicResource SpaceTop8}"
                HorizontalAlignment="Center"
                FontSize="{DynamicResource FontSizeBody}"
                Foreground="{StaticResource TextMutedBrush}"
                Text="{Binding EmptyMessage}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Selection action bar: floats at the bottom while one or more tiles are selected -->
        <Border
            Grid.Row="3"
            Margin="0,0,0,16"
            Padding="8,8,12,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{StaticResource SurfaceOverlayBrush}"
            BorderBrush="{StaticResource BorderProminentBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusLarge}"
            Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Opacity="0.5"
                    ShadowDepth="2"
                    Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="8,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeBody}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding SelectionLabel}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding ClearSelectionCommand}"
                    Content="{x:Static res:Strings.Manage_Clear}"
                    Icon="{ui:SymbolIcon Dismiss24}" />
                <ui:Button
                    Appearance="Danger"
                    Command="{Binding DeleteSelectedCommand}"
                    Content="{x:Static res:Strings.Manage_DeleteSelected}"
                    Icon="{ui:SymbolIcon Delete24}" />
            </StackPanel>
        </Border>

        <!-- Pager bar: page numbers centered across the full width (so they sit under the grid's middle),
             with results-per-page overlaid at the right. Shown once tiles are present. -->
        <Grid
            Grid.Row="4"
            Margin="0,12,0,2"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">

            <!-- Centered group: ‹ prev | page numbers (fixed-width zone) | › next. The numbers live in a
                 fixed-width column so ‹/› never move — you can rapid-click them without re-aiming — and
                 the whole group is centered on the bar (independent of the right-side dropdown). -->
            <Grid
                HorizontalAlignment="Center"
                Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    Margin="2,0"
                    Padding="8,4"
                    Command="{Binding PrevPageCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Pager_Prev}"
                    Content="‹"
                    FontSize="{DynamicResource FontSizeBody}"
                    IsEnabled="{Binding CanGoPrev}"
                    ToolTip="{x:Static res:Strings.Pager_Prev}" />
                <ItemsControl Grid.Column="1" HorizontalAlignment="Center" ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Ellipsis gap (sentinel 0): non-clickable "…" -->
                                <TextBlock
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Text="…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Page-number button -->
                                <ui:Button
                                    Margin="2,0"
                                    Padding="8,4"
                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding}"
                                    FontSize="{DynamicResource FontSizeBody}">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Style.Triggers>
                                                <!-- Hide the button for the ellipsis sentinel (0) -->
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <!-- Highlight the active page -->
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualityMulti}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Grid.Column="2"
                    Margin="2,0"
                    Padding="8,4"
                    Command="{Binding NextPageCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Pager_Next}"
                    Content="›"
                    FontSize="{DynamicResource FontSizeBody}"
                    IsEnabled="{Binding CanGoNext}"
                    ToolTip="{x:Static res:Strings.Pager_Next}" />
            </Grid>

            <!-- Right: results-per-page (overlaid at the right edge, doesn't shift the centered pager) -->
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeCaption}"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{x:Static res:Strings.Manage_ResultsPerPage}" />
                <ComboBox
                    MinWidth="72"
                    ItemTemplate="{StaticResource FilterOptionTemplate}"
                    ItemsSource="{Binding PageSizeOptions}"
                    SelectedItem="{Binding SelectedPageSize}" />
            </StackPanel>
        </Grid>

        <!-- Detail flyout: dim scrim + slide-in panel from the right (ManageDetailFlyout) -->
        <views:ManageDetailFlyout
            Grid.Row="0"
            Grid.RowSpan="5"
            Margin="-8,-16,-16,-8"
            Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
