<UserControl
    x:Class="LuaToolsGui.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Clickable stat tile: the card look, with a hover brighten (same idiom as the recent cards). -->
        <Style x:Key="CardTileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Padding="16,14" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource BorderProminentBrush}" />
                            </Trigger>
                            <!-- A custom template drops the chrome that would otherwise show focus, and WPF's
                                 dotted adorner is close to invisible on these surfaces. Tab order is useless
                                 if the user cannot see where they are. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="B" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Clickable status row: transparent, hover brighten. -->
        <Style x:Key="StatusRowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="B"
                            Padding="6,5"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceTintBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceTintBrush}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer x:Name="Root" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="8,16,16,24">

            <!-- Greeting · which build this is · re-read every status on demand -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{x:Static res:Strings.Home_Welcome}"
                    TextTrimming="CharacterEllipsis" />

                <Border
                    Grid.Column="1"
                    Margin="12,0,8,0"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="{StaticResource AccentTintBrush}"
                    BorderBrush="{StaticResource AccentOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ToolTip="{x:Static res:Strings.Home_Version}">
                    <TextBlock
                        AutomationProperties.Name="{x:Static res:Strings.Home_Version}"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AccentBrush}"
                        Text="{Binding VersionLabel, Mode=OneTime}" />
                </Border>

                <ui:Button
                    Grid.Column="2"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static res:Strings.Home_Refresh}"
                    Command="{Binding RefreshStatusCommand}"
                    Content="{x:Static res:Strings.Home_Refresh}"
                    Icon="{ui:SymbolIcon ArrowClockwise24}"
                    ToolTip="{x:Static res:Strings.Home_RefreshTip}" />
            </Grid>

            <!-- Stat tiles (clickable) -->
            <UniformGrid Margin="0,18,0,0" Columns="2" Rows="1">
                <!-- Luas on board → Manage -->
                <Button Margin="0,0,6,0" Command="{Binding OpenManageCommand}" Style="{StaticResource CardTileButton}">
                    <StackPanel>
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="{Binding GameCount}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{x:Static res:Strings.Home_LuasOnBoard}" />
                    </StackPanel>
                </Button>
                <!-- Plugin status → Plugin page (+ inline Install when not installed) -->
                <Button Margin="6,0,0,0" Command="{Binding OpenPluginCommand}" Style="{StaticResource CardTileButton}">
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextDimBrush}"
                            Text="{x:Static res:Strings.Home_PluginStatus}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{Binding PluginStatusColor, Converter={StaticResource ResourceKeyToBrush}}"
                            Text="{Binding PluginStatusText}"
                            TextTrimming="CharacterEllipsis" />
                        <ui:Button
                            Margin="0,10,0,0"
                            Padding="10,4"
                            Appearance="Primary"
                            Command="{Binding InstallPluginCommand}"
                            Content="{x:Static res:Strings.Plugin_Btn_Install}"
                            IsEnabled="{Binding NotInstallingPlugin}"
                            Visibility="{Binding ShowPluginInstall, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Status: Steam + account -->
            <Border
                Margin="0,12,0,0"
                Padding="10,8"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <!-- Steam: where it is, and whether it is up right now → Settings -->
                    <Button
                        AutomationProperties.Name="{x:Static res:Strings.Home_SteamState}"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Symbol="Games24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SteamFound}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding SteamStatus}"
                                TextTrimming="CharacterEllipsis" />
                            <!-- Running/closed is a separate fact from "installed here", and it is the one
                                 that decides whether an install can write to the Steam folder at all. The
                                 word carries it, not the colour alone. -->
                            <Border
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                CornerRadius="5"
                                Visibility="{Binding SteamFound, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceTintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SteamRunning}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" Text="{Binding SteamRunningText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SteamRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Button>

                    <Separator Margin="0,10" Background="{StaticResource SurfaceTintBrush}" />

                    <!-- Account → Settings -->
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{StaticResource AccentBrush}"
                                Symbol="Person24" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding AccountStatus}" />
                        </Grid>
                    </Button>

                    <Separator Margin="0,10" Background="{StaticResource SurfaceTintBrush}" />

                    <!-- Whichever backend owns the proxy DLLs — a Mode OR AmethystTool → Mode -->
                    <Button
                        AutomationProperties.Name="{x:Static res:Strings.Home_Backend}"
                        Command="{Binding OpenModeCommand}"
                        Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Symbol="Options24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveBackend}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding ModeStatus}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>

                    <Separator Margin="0,10" Background="{StaticResource SurfaceTintBrush}" />

                    <!-- What this fork does NOT do. Stated here rather than only on About: it is the
                         reason the fork exists, and a user should not have to go looking. → About -->
                    <Button
                        AutomationProperties.Name="{x:Static res:Strings.Home_Privacy}"
                        Command="{Binding OpenAboutCommand}"
                        Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Symbol="ShieldCheckmark24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelfUpdateDisabled}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding PrivacyText}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Quick actions: the three pages reached from Home most often. Plain buttons, not cards —
                 they are verbs, and giving them tile weight would compete with the stats above. -->
            <TextBlock
                Margin="2,18,0,0"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextDimBrush}"
                Text="{x:Static res:Strings.Home_QuickActions}" />
            <UniformGrid Margin="0,8,0,0" Columns="3" Rows="1">
                <ui:Button
                    Margin="0,0,4,0"
                    Padding="10,7"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding OpenModeCommand}"
                    Content="{x:Static res:Strings.Home_Action_Mode}"
                    Icon="{ui:SymbolIcon Options24}"
                    ToolTip="{x:Static res:Strings.Home_Action_Mode_Tip}" />
                <ui:Button
                    Margin="4,0"
                    Padding="10,7"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding OpenPluginCommand}"
                    Content="{x:Static res:Strings.Home_Action_Plugin}"
                    Icon="{ui:SymbolIcon PuzzlePiece24}"
                    ToolTip="{x:Static res:Strings.Home_Action_Plugin_Tip}" />
                <ui:Button
                    Margin="4,0,0,0"
                    Padding="10,7"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding OpenAboutCommand}"
                    Content="{x:Static res:Strings.Home_Action_Updates}"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    ToolTip="{x:Static res:Strings.Home_Action_Updates_Tip}" />
            </UniformGrid>

            <!-- Drag-and-drop install -->
            <views:DropZone Margin="0,12,0,0" DataContext="{Binding Drop}" />

            <!-- Recently added -->
            <StackPanel Margin="0,22,0,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{x:Static res:Strings.Home_RecentlyAdded}" />
                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,12,12"
                                Padding="0"
                                Command="{Binding DataContext.OpenGameCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                ToolTip="{x:Static res:Strings.Home_ViewDetails}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Card"
                                            Width="170"
                                            Background="{StaticResource SurfaceCardBrush}"
                                            BorderBrush="{StaticResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <StackPanel>
                                                <Border
                                                    Height="80"
                                                    Background="{StaticResource SurfaceCardHoverBrush}"
                                                    ClipToBounds="True"
                                                    CornerRadius="10,10,0,0">
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock
                                                    Margin="10,8,10,10"
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderProminentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!-- Drag-and-drop overwrite confirm (the DropZone's own flow), page-spanning. -->
    <views:ConfirmOverlay DataContext="{Binding Drop}" />
    </Grid>
</UserControl>
