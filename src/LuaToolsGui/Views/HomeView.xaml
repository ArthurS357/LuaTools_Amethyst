<UserControl
    x:Class="LuaToolsGui.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Clickable stat tile: the card look, with a hover brighten (same idiom as the recent cards).
             Keyboard focus is WPF-UI's focus ring (FocusVisualStyle), drawn outside the border: the old
             trigger thickened the border 1 -> 2 on focus and moved the tile by 2 px, and it also fired on a
             mouse click. A custom template drops the chrome that would otherwise show focus, which is why
             the ring has to be asked for here. -->
        <Style x:Key="CardTileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="B"
                            Padding="{DynamicResource SpaceAll16}"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusLarge}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource BorderProminentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Clickable status row: transparent, hover brighten, same focus ring as the tiles. -->
        <Style x:Key="StatusRowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="B"
                            Padding="{DynamicResource SpaceAll8}"
                            Background="Transparent"
                            CornerRadius="{DynamicResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer x:Name="Root" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="8,16,16,24">

            <!-- Greeting (page header) · which build this is · re-read every status on demand -->
            <HeaderedContentControl Header="{x:Static res:Strings.Home_Welcome}" Style="{StaticResource PageHeaderStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="{StaticResource AccentTintBrush}"
                        BorderBrush="{StaticResource AccentOutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMedium}"
                        ToolTip="{x:Static res:Strings.Home_Version}">
                        <TextBlock
                            AutomationProperties.Name="{x:Static res:Strings.Home_Version}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="{Binding VersionLabel, Mode=OneTime}" />
                    </Border>
                    <ui:Button
                        Margin="{DynamicResource SpaceLeft8}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static res:Strings.Home_Refresh}"
                        Command="{Binding RefreshStatusCommand}"
                        Content="{x:Static res:Strings.Home_Refresh}"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        ToolTip="{x:Static res:Strings.Home_RefreshTip}" />
                </StackPanel>
            </HeaderedContentControl>

            <!-- Stat tiles (clickable). A spacer column, not margins, makes the gutter. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Luas on board → Manage -->
                <Button Command="{Binding OpenManageCommand}" Style="{StaticResource CardTileButton}">
                    <StackPanel>
                        <TextBlock
                            FontSize="{DynamicResource FontSizeHeader}"
                            FontWeight="Bold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="{Binding GameCount}" />
                        <TextBlock
                            Margin="{DynamicResource SpaceTop4}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{x:Static res:Strings.Home_LuasOnBoard}" />
                    </StackPanel>
                </Button>
                <!-- Plugin status → Plugin page (+ inline Install when not installed) -->
                <Button
                    Grid.Column="2"
                    Command="{Binding OpenPluginCommand}"
                    Style="{StaticResource CardTileButton}">
                    <StackPanel>
                        <TextBlock
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{StaticResource TextDimBrush}"
                            Text="{x:Static res:Strings.Home_PluginStatus}" />
                        <TextBlock
                            Margin="{DynamicResource SpaceTop4}"
                            FontSize="{DynamicResource FontSizeSubtitle}"
                            FontWeight="SemiBold"
                            Foreground="{Binding PluginStatusColor, Converter={StaticResource ResourceKeyToBrush}}"
                            Text="{Binding PluginStatusText}"
                            TextTrimming="CharacterEllipsis" />
                        <ui:Button
                            Margin="{DynamicResource SpaceTop12}"
                            Appearance="Primary"
                            Command="{Binding InstallPluginCommand}"
                            Content="{x:Static res:Strings.Plugin_Btn_Install}"
                            IsEnabled="{Binding NotInstallingPlugin}"
                            Visibility="{Binding ShowPluginInstall, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Status: Steam + account -->
            <Border
                Margin="{DynamicResource SpaceTop8}"
                Padding="{DynamicResource SpaceAll8}"
                Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Steam: where it is, and whether it is up right now → Settings -->
                    <Button
                        AutomationProperties.Name="{x:Static res:Strings.Home_SteamState}"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeSubtitle}"
                                Symbol="Games24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SteamFound}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock
                                Grid.Column="1"
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeBody}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding SteamStatus}"
                                TextTrimming="CharacterEllipsis" />
                            <!-- Running/closed is a separate fact from "installed here", and it is the one
                                 that decides whether an install can write to the Steam folder at all. The
                                 word carries it, not the colour alone. -->
                            <Border
                                Grid.Column="2"
                                Margin="{DynamicResource SpaceLeft8}"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Visibility="{Binding SteamFound, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceTintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SteamRunning}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{Binding SteamRunningText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SteamRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Button>

                    <Border Margin="{DynamicResource SpaceAll8}" Style="{StaticResource RowDividerStyle}" />

                    <!-- Account → Settings -->
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeSubtitle}"
                                Foreground="{StaticResource AccentBrush}"
                                Symbol="Person24" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeBody}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding AccountStatus}" />
                        </Grid>
                    </Button>

                    <Border Margin="{DynamicResource SpaceAll8}" Style="{StaticResource RowDividerStyle}" />

                    <!-- Whichever backend owns the proxy DLLs — a Mode OR AmethystTool → Mode -->
                    <Button
                        AutomationProperties.Name="{x:Static res:Strings.Home_Backend}"
                        Command="{Binding OpenModeCommand}"
                        Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeSubtitle}"
                                Symbol="Options24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveBackend}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock
                                Grid.Column="1"
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeBody}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding ModeStatus}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>

                    <Border Margin="{DynamicResource SpaceAll8}" Style="{StaticResource RowDividerStyle}" />

                    <!-- What this fork does NOT do. Stated here rather than only on About: it is the
                         reason the fork exists, and a user should not have to go looking. → About -->
                    <Button
                        AutomationProperties.Name="{x:Static res:Strings.Home_Privacy}"
                        Command="{Binding OpenAboutCommand}"
                        Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeSubtitle}"
                                Symbol="ShieldCheckmark24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelfUpdateDisabled}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock
                                Grid.Column="1"
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeBody}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding PrivacyText}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Quick actions: the three pages reached from Home most often. Plain buttons, not cards —
                 they are verbs, and giving them tile weight would compete with the stats above. -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Home_QuickActions}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding OpenModeCommand}"
                    Content="{x:Static res:Strings.Home_Action_Mode}"
                    Icon="{ui:SymbolIcon Options24}"
                    ToolTip="{x:Static res:Strings.Home_Action_Mode_Tip}" />
                <ui:Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding OpenPluginCommand}"
                    Content="{x:Static res:Strings.Home_Action_Plugin}"
                    Icon="{ui:SymbolIcon PuzzlePiece24}"
                    ToolTip="{x:Static res:Strings.Home_Action_Plugin_Tip}" />
                <ui:Button
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding OpenAboutCommand}"
                    Content="{x:Static res:Strings.Home_Action_Updates}"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    ToolTip="{x:Static res:Strings.Home_Action_Updates_Tip}" />
            </Grid>

            <!-- Drag-and-drop install -->
            <views:DropZone Margin="{DynamicResource SpaceTop16}" DataContext="{Binding Drop}" />

            <!-- Recently added -->
            <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Home_RecentlyAdded}" />
                <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,12,12"
                                Padding="0"
                                Command="{Binding DataContext.OpenGameCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                FocusVisualStyle="{StaticResource DefaultControlFocusVisualStyle}"
                                ToolTip="{x:Static res:Strings.Home_ViewDetails}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Card"
                                            Width="170"
                                            Background="{StaticResource SurfaceCardBrush}"
                                            BorderBrush="{StaticResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusLarge}">
                                            <StackPanel>
                                                <Border
                                                    Height="80"
                                                    Background="{StaticResource SurfaceCardHoverBrush}"
                                                    ClipToBounds="True"
                                                    CornerRadius="12,12,0,0">
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock
                                                    Margin="12,8,12,12"
                                                    FontSize="{DynamicResource FontSizeBody}"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderProminentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!-- Drag-and-drop overwrite confirm (the DropZone's own flow), page-spanning. -->
    <views:ConfirmOverlay DataContext="{Binding Drop}" />
    </Grid>
</UserControl>
