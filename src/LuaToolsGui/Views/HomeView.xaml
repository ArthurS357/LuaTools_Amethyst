<UserControl
    x:Class="LuaToolsGui.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Clickable stat tile: the card look, with a hover brighten (same idiom as the recent cards). -->
        <Style x:Key="CardTileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Padding="16,14" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource BorderProminentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Clickable status row: transparent, hover brighten. -->
        <Style x:Key="StatusRowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Padding="6,5" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer x:Name="Root" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="8,16,16,24">

            <!-- Greeting -->
            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Home_Welcome}" />

            <!-- Stat tiles (clickable) -->
            <UniformGrid Margin="0,18,0,0" Columns="2" Rows="1">
                <!-- Luas on board → Manage -->
                <Button Margin="0,0,6,0" Command="{Binding OpenManageCommand}" Style="{StaticResource CardTileButton}">
                    <StackPanel>
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="{Binding GameCount}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{x:Static res:Strings.Home_LuasOnBoard}" />
                    </StackPanel>
                </Button>
                <!-- Plugin status → Plugin page (+ inline Install when not installed) -->
                <Button Margin="6,0,0,0" Command="{Binding OpenPluginCommand}" Style="{StaticResource CardTileButton}">
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextDimBrush}"
                            Text="{x:Static res:Strings.Home_PluginStatus}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{Binding PluginStatusColor, Converter={StaticResource ResourceKeyToBrush}}"
                            Text="{Binding PluginStatusText}"
                            TextTrimming="CharacterEllipsis" />
                        <ui:Button
                            Margin="0,10,0,0"
                            Padding="10,4"
                            Appearance="Primary"
                            Command="{Binding InstallPluginCommand}"
                            Content="{x:Static res:Strings.Plugin_Btn_Install}"
                            IsEnabled="{Binding NotInstallingPlugin}"
                            Visibility="{Binding ShowPluginInstall, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Status: Steam + account -->
            <Border
                Margin="0,12,0,0"
                Padding="10,8"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <!-- Steam → Settings -->
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Symbol="Games24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SteamFound}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding SteamStatus}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>

                    <Separator Margin="0,10" Background="{StaticResource SurfaceTintBrush}" />

                    <!-- Account → Settings -->
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{StaticResource AccentBrush}"
                                Symbol="Person24" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding AccountStatus}" />
                        </Grid>
                    </Button>

                    <Separator Margin="0,10" Background="{StaticResource SurfaceTintBrush}" />

                    <!-- Active mode → Mode -->
                    <Button Command="{Binding OpenModeCommand}" Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{StaticResource AccentBrush}"
                                Symbol="Options24" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding ModeStatus}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Drag-and-drop install -->
            <views:DropZone Margin="0,12,0,0" DataContext="{Binding Drop}" />

            <!-- Recently added -->
            <StackPanel Margin="0,22,0,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{x:Static res:Strings.Home_RecentlyAdded}" />
                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,12,12"
                                Padding="0"
                                Command="{Binding DataContext.OpenGameCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                ToolTip="{x:Static res:Strings.Home_ViewDetails}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Card"
                                            Width="170"
                                            Background="{StaticResource SurfaceCardBrush}"
                                            BorderBrush="{StaticResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <StackPanel>
                                                <Border
                                                    Height="80"
                                                    Background="{StaticResource SurfaceCardHoverBrush}"
                                                    ClipToBounds="True"
                                                    CornerRadius="10,10,0,0">
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock
                                                    Margin="10,8,10,10"
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderProminentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!-- Drag-and-drop overwrite confirm (the DropZone's own flow), page-spanning. -->
    <views:ConfirmOverlay DataContext="{Binding Drop}" />
    </Grid>
</UserControl>
