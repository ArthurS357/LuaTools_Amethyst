<UserControl
    x:Class="LuaToolsGui.Views.ModeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ModeViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Fixed bottom dock (shared progress) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="8,16,16,8">

                <!-- Header -->
                <HeaderedContentControl
                    Header="{x:Static res:Strings.Mode_Title}"
                    Style="{StaticResource PageHeaderStyle}"
                    Tag="{x:Static res:Strings.Mode_Subtitle}">
                    <ui:Button
                        Command="{Binding CheckForUpdatesCommand}"
                        Content="{x:Static res:Strings.Mode_CheckForUpdates}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        IsEnabled="{Binding NotBusy}" />
                </HeaderedContentControl>

                <!-- AmethystTool, first on the page. A Mode, not a plugin: it writes the same dwmapi.dll /
                     xinput1_4.dll next to steam.exe that every card below does, so it competes for the same
                     slot. It is not in the ItemsControl because the ordering is fixed (it leads) and because
                     it reports versions, a backup folder and an install record,
                     which a ModeCardViewModel has nowhere to put — hence its own template and its own view
                     model, bound through Amethyst. Progress goes to the page's docked bar, not to a bar of
                     its own; confirmation goes through the page's overlay, not a MessageBox. -->
                <Border
                    DataContext="{Binding Amethyst}"
                    KeyboardNavigation.TabNavigation="Local"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource AccentBrush}"
                                    Symbol="Wrench24" />
                                <TextBlock
                                    Margin="{DynamicResource SpaceLeft12}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource TextSubtitle}"
                                    Text="{x:Static res:Strings.Amethyst_CardTitle}" />
                                <!-- Recommended: unconditional, this template is the AmethystTool card only. -->
                                <Border
                                    Margin="{DynamicResource SpaceLeft12}"
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SuccessTintBrush}"
                                    CornerRadius="{DynamicResource RadiusSmall}">
                                    <TextBlock
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource SuccessTextBrush}"
                                        Text="{x:Static res:Strings.Mode_Recommended}" />
                                </Border>
                                <!-- IsActive, NOT IsInstalled: installing a Mode overwrites the two proxy
                                     DLLs but leaves AmethystTool.dll and amethysttool.toml in place, so the
                                     files stay present after the slot has moved on. Binding this badge to
                                     file presence is what used to light ACTIVE here and on a Mode card at
                                     the same time. -->
                                <Border
                                    Margin="{DynamicResource SpaceLeft12}"
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AccentBadgeBrush}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentSoftBrush}"
                                        Text="{x:Static res:Strings.Mode_Active}" />
                                </Border>
                                <Border
                                    Margin="{DynamicResource SpaceLeft8}"
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource WarningTintBrush}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource WarningBrush}"
                                        Text="{x:Static res:Strings.Mode_UpdateAvailable}" />
                                </Border>
                            </StackPanel>

                            <TextBlock
                                Margin="{DynamicResource SpaceTop8}"
                                Foreground="{StaticResource TextDimBrush}"
                                Style="{StaticResource TextCaption}"
                                Text="{x:Static res:Strings.Amethyst_Description}" />

                            <!-- Status line, worded like the cards above it. -->
                            <TextBlock
                                Margin="{DynamicResource SpaceTop8}"
                                Foreground="{StaticResource TextMutedBrush}"
                                Style="{StaticResource TextBody}"
                                Text="{Binding Status}" />

                            <!-- Installed version, and where it is going if an update is pending. -->
                            <StackPanel Margin="{DynamicResource SpaceTop8}" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeBody}"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Text="{x:Static res:Strings.Plugin_Row_InstalledVersion}" />
                                <TextBlock
                                    Margin="{DynamicResource SpaceLeft8}"
                                    FontSize="{DynamicResource FontSizeBody}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding InstalledVersion}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        Margin="{DynamicResource SpaceLeft8}"
                                        FontSize="{DynamicResource FontSizeBody}"
                                        Foreground="{StaticResource TextDimBrush}"
                                        Text="&#x2192;" />
                                    <TextBlock
                                        Margin="{DynamicResource SpaceLeft8}"
                                        FontSize="{DynamicResource FontSizeBody}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource WarningBrush}"
                                        Text="{Binding LatestVersion}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Installed, but placed before install records existed: say why Uninstall is
                                 unavailable instead of leaving a button that does nothing. -->
                            <TextBlock
                                Margin="{DynamicResource SpaceTop8}"
                                Foreground="{StaticResource TextDimBrush}"
                                Style="{StaticResource TextCaption}"
                                Text="{x:Static res:Strings.Mode_Uninstall_NoRecord}"
                                Visibility="{Binding ShowNoRecordHint, Converter={StaticResource BoolToVis}}" />

                            <!-- Offline / rate-limit line. -->
                            <TextBlock
                                Margin="{DynamicResource SpaceTop8}"
                                Foreground="{StaticResource WarningStrongBrush}"
                                Style="{StaticResource TextCaption}"
                                Text="{Binding StatusLine}"
                                Visibility="{Binding StatusLine, Converter={StaticResource NullToCollapsed}}" />

                            <!-- Where the files this install displaced were kept. -->
                            <TextBlock
                                Margin="{DynamicResource SpaceTop8}"
                                Foreground="{StaticResource InfoBrush}"
                                Style="{StaticResource TextCaption}"
                                Text="{Binding BackupLine}"
                                Visibility="{Binding BackupLine, Converter={StaticResource NullToCollapsed}}" />

                            <!-- Denuvo Mode (Aliases): [compatibility] denuvo_aliases in amethysttool.toml.
                                 IsChecked is ONE-WAY on purpose: the click runs the command, and only a
                                 successful write moves the bound value, so a failed write snaps the switch
                                 back. Enabled only with AmethystTool installed and its toml present, and
                                 never while the page is busy (an install replaces that very file). -->
                            <Border
                                Margin="{DynamicResource SpaceTop12}"
                                Padding="{DynamicResource SpaceTop12}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TextBodyStrong}" Text="{x:Static res:Strings.Amethyst_Denuvo_Label}" />
                                        <TextBlock
                                            Margin="{DynamicResource SpaceTop4}"
                                            Foreground="{StaticResource TextDimBrush}"
                                            Style="{StaticResource TextCaption}"
                                            Text="{x:Static res:Strings.Amethyst_Denuvo_Hint}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch
                                        Grid.Column="1"
                                        Margin="{DynamicResource SpaceLeft12}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.HelpText="{x:Static res:Strings.Amethyst_Denuvo_Hint}"
                                        AutomationProperties.Name="{x:Static res:Strings.Amethyst_Denuvo_Label}"
                                        Command="{Binding ToggleDenuvoAliasesCommand}"
                                        IsChecked="{Binding DenuvoAliasesEnabled, Mode=OneWay}"
                                        IsEnabled="{Binding DataContext.CanToggleDenuvoAliases, ElementName=Root}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="{DynamicResource SpaceLeft16}" VerticalAlignment="Center">
                            <ui:Button
                                MinWidth="120"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                AutomationProperties.Name="{Binding InstallButtonText}"
                                Command="{Binding DataContext.InstallAmethystCommand, ElementName=Root}"
                                Content="{Binding InstallButtonText}"
                                IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InstallIsPrimary}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button
                                Margin="{DynamicResource SpaceTop8}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                AutomationProperties.Name="{x:Static res:Strings.Mode_Btn_Uninstall}"
                                Appearance="Danger"
                                Command="{Binding DataContext.UninstallAmethystCommand, ElementName=Root}"
                                Content="{x:Static res:Strings.Mode_Btn_Uninstall}"
                                Icon="{ui:SymbolIcon Delete24}"
                                IsEnabled="{Binding DataContext.CanUninstallAmethyst, ElementName=Root}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Mode cards -->
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="{DynamicResource SpaceTop12}" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource AccentBrush}"
                                                Symbol="Wrench24" />
                                            <TextBlock
                                                Margin="{DynamicResource SpaceLeft12}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource TextSubtitle}"
                                                Text="{Binding Title}" />
                                            <!-- BetterSteamTools: blue "Upstream" badge (the project AmethystTool forks). -->
                                            <Border
                                                Margin="{DynamicResource SpaceLeft12}"
                                                Padding="{DynamicResource SpaceAll4}"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource InfoTintBrush}"
                                                CornerRadius="{DynamicResource RadiusSmall}"
                                                Visibility="{Binding IsUpstream, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource InfoBrush}"
                                                    Text="{x:Static res:Strings.Mode_Badge_Upstream}" />
                                            </Border>
                                            <!-- Nightly: amber "Experimental" badge. -->
                                            <Border
                                                Margin="{DynamicResource SpaceLeft12}"
                                                Padding="{DynamicResource SpaceAll4}"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource WarningTintBrush}"
                                                CornerRadius="{DynamicResource RadiusSmall}"
                                                Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource WarningBrush}"
                                                    Text="{x:Static res:Strings.Mode_Experimental}" />
                                            </Border>
                                            <Border
                                                Margin="{DynamicResource SpaceLeft8}"
                                                Padding="{DynamicResource SpaceAll4}"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource AccentBadgeBrush}"
                                                CornerRadius="{DynamicResource RadiusSmall}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource AccentSoftBrush}"
                                                    Text="{x:Static res:Strings.Mode_Active}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            Margin="{DynamicResource SpaceTop8}"
                                            Foreground="{StaticResource TextDimBrush}"
                                            Style="{StaticResource TextCaption}"
                                            Text="{Binding Description}" />
                                        <!-- Third-party warning: telemetry + DonateKeys (BetterSteamTools card only). -->
                                        <StackPanel
                                            Margin="{DynamicResource SpaceTop8}"
                                            Orientation="Horizontal"
                                            Visibility="{Binding ShowPrivacyWarning, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon
                                                VerticalAlignment="Top"
                                                Foreground="{StaticResource WarningBrush}"
                                                Symbol="Warning24" />
                                            <TextBlock
                                                MaxWidth="560"
                                                Margin="{DynamicResource SpaceLeft8}"
                                                Foreground="{StaticResource WarningBrush}"
                                                Style="{StaticResource TextBody}"
                                                Text="{x:Static res:Strings.Mode_Warn_Telemetry}" />
                                        </StackPanel>
                                        <TextBlock
                                            Margin="{DynamicResource SpaceTop8}"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Style="{StaticResource TextBody}"
                                            Text="{Binding StatusText}" />
                                        <!-- Active, but nothing recorded: say why Uninstall is disabled. -->
                                        <TextBlock
                                            Margin="{DynamicResource SpaceTop8}"
                                            Foreground="{StaticResource TextDimBrush}"
                                            Style="{StaticResource TextCaption}"
                                            Text="{x:Static res:Strings.Mode_Uninstall_NoRecord}"
                                            Visibility="{Binding ShowNoRecordHint, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="{DynamicResource SpaceLeft16}"
                                        VerticalAlignment="Center">
                                        <ui:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding DataContext.InstallCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding ButtonText}"
                                            IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
                                        <!-- Active mode only: takes the files it recorded back out. -->
                                        <ui:Button
                                            Margin="{DynamicResource SpaceTop8}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Appearance="Danger"
                                            Command="{Binding DataContext.UninstallModeCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="{x:Static res:Strings.Mode_Btn_Uninstall}"
                                            Icon="{ui:SymbolIcon Delete24}"
                                            IsEnabled="{Binding DataContext.CanUninstallMode, ElementName=Root}"
                                            Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Fixed bottom dock: shared progress. -->
        <StackPanel Grid.Row="1" MaxWidth="760" Margin="8,0,16,16">

            <!-- Shared progress while installing/switching -->
            <ProgressBar
                Height="6"
                Margin="{DynamicResource SpaceTop4}"
                IsIndeterminate="{Binding IsProgressIndeterminate}"
                Maximum="100"
                Value="{Binding Progress}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        </StackPanel>

        <!-- Steam-shutdown confirmation overlay (covers the whole page, both rows) -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="{StaticResource ScrimBrush}"
            Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
            <Border
                MaxWidth="420"
                Margin="{DynamicResource SpaceAll8}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceOverlayBrush}"
                BorderBrush="{StaticResource BorderProminentBrush}"
                Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextSubtitle}" Text="{Binding ConfirmTitle}" />
                    <TextBlock
                        Margin="{DynamicResource SpaceTop8}"
                        Foreground="{StaticResource TextMutedBrush}"
                        Style="{StaticResource TextBody}"
                        Text="{Binding ConfirmBody}" />
                    <StackPanel
                        Margin="{DynamicResource SpaceTop16}"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding CancelConfirmCommand}"
                            Content="{x:Static res:Strings.Mode_Cancel}" />
                        <ui:Button
                            Margin="{DynamicResource SpaceLeft8}"
                            Appearance="Primary"
                            Command="{Binding ConfirmCommand}"
                            Content="{x:Static res:Strings.Mode_CloseSteamContinue}"
                            Icon="{ui:SymbolIcon Power24}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
