<UserControl
    x:Class="LuaToolsGui.Views.ConfirmOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DropInstallViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One diff row: clickable → SteamDB. Real name on top, "id · size · OS · lang" below, DLC/SHARED chip right. -->
        <DataTemplate x:Key="DiffRowTemplate">
            <Button
                Margin="{DynamicResource SpaceTop4}"
                Padding="{DynamicResource SpaceAll8}"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding DataContext.OpenSteamDbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Cursor="Hand"
                FocusVisualStyle="{StaticResource DefaultControlFocusVisualStyle}"
                ToolTip="{x:Static res:Strings.Confirm_OpenSteamDb}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource RadiusMedium}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="{DynamicResource FontSizeBody}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{StaticResource TextDimBrush}"
                                        Style="{StaticResource TextCaption}"
                                        Text="{Binding Meta}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Margin="{DynamicResource SpaceLeft8}"
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource SurfaceInsetBrush}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Visibility="{Binding IsDlc, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentSoftBrush}"
                                        Text="DLC" />
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="{DynamicResource SpaceLeft8}"
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource WarningInsetBrush}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource WarningSoftBrush}"
                                        Text="{x:Static res:Strings.Confirm_Shared}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- In-window overlay (dim scrim + centered card). Same pattern as the Add-page confirm dialog,
         NOT a Popup — a Popup gets a system drop-shadow around its rectangular surface ("boxed glow"). -->
    <Grid
        Background="{StaticResource ScrimBrush}"
        Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
        <Border
            MaxWidth="460"
            MaxHeight="560"
            Margin="{DynamicResource SpaceAll8}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource SurfaceOverlayBrush}"
            BorderBrush="{StaticResource BorderProminentBrush}"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource TextSubtitle}" Text="{Binding ConfirmTitle}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="{DynamicResource SpaceTop4}"
                    Style="{StaticResource TextCaption}"
                    Text="{x:Static res:Strings.Confirm_ReviewChanges}" />

                <ScrollViewer
                    Grid.Row="2"
                    Margin="{DynamicResource SpaceTop12}"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Foreground="{StaticResource TextDimBrush}"
                            Style="{StaticResource TextBody}"
                            Text="{Binding ConfirmNoChanges}"
                            Visibility="{Binding ConfirmNoChanges, Converter={StaticResource NullToCollapsed}}" />

                        <StackPanel Visibility="{Binding HasAdded, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Foreground="{StaticResource SuccessTextBrush}"
                                Style="{StaticResource TextBodyStrong}"
                                Text="{Binding Added.Count, StringFormat={x:Static res:Strings.Confirm_Adding}}" />
                            <ItemsControl
                                Margin="{DynamicResource SpaceTop4}"
                                ItemTemplate="{StaticResource DiffRowTemplate}"
                                ItemsSource="{Binding Added}" />
                        </StackPanel>

                        <StackPanel Margin="{DynamicResource SpaceTop12}" Visibility="{Binding HasRemoved, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Foreground="{StaticResource WarningSoftBrush}"
                                Style="{StaticResource TextBodyStrong}"
                                Text="{Binding Removed.Count, StringFormat={x:Static res:Strings.Confirm_Removing}}" />
                            <ItemsControl
                                Margin="{DynamicResource SpaceTop4}"
                                ItemTemplate="{StaticResource DiffRowTemplate}"
                                ItemsSource="{Binding Removed}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    Grid.Row="3"
                    Margin="{DynamicResource SpaceTop16}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding CancelOverwriteCommand}"
                        Content="{x:Static res:Strings.Confirm_Skip}" />
                    <ui:Button
                        Margin="{DynamicResource SpaceLeft8}"
                        Appearance="Primary"
                        Command="{Binding ConfirmOverwriteCommand}"
                        Content="{x:Static res:Strings.Confirm_Replace}"
                        Icon="{ui:SymbolIcon ArrowDownload24}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
