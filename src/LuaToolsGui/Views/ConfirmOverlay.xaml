<UserControl
    x:Class="LuaToolsGui.Views.ConfirmOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DropInstallViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One diff row: clickable → SteamDB. Real name on top, "id · size · OS · lang" below, DLC/SHARED chip right. -->
        <DataTemplate x:Key="DiffRowTemplate">
            <Button
                Margin="0,0,0,2"
                Padding="6,4"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding DataContext.OpenSteamDbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Cursor="Hand"
                ToolTip="{x:Static res:Strings.Confirm_OpenSteamDb}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        FontSize="10.5"
                                        Foreground="{StaticResource TextDimBrush}"
                                        Text="{Binding Meta}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Margin="8,1,0,0"
                                    Padding="5,1"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource SurfaceInsetBrush}"
                                    CornerRadius="4"
                                    Visibility="{Binding IsDlc, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="9.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentSoftBrush}"
                                        Text="DLC" />
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="8,1,0,0"
                                    Padding="5,1"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource WarningInsetBrush}"
                                    CornerRadius="4"
                                    Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="9.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource WarningSoftBrush}"
                                        Text="{x:Static res:Strings.Confirm_Shared}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- In-window overlay (dim scrim + centered card). Same pattern as the Add-page confirm dialog,
         NOT a Popup — a Popup gets a system drop-shadow around its rectangular surface ("boxed glow"). -->
    <Grid
        Background="{StaticResource ScrimBrush}"
        Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
        <Border
            MaxWidth="460"
            MaxHeight="560"
            Margin="8"
            Padding="18"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource SurfaceOverlayBrush}"
            BorderBrush="{StaticResource BorderProminentBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{Binding ConfirmTitle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{x:Static res:Strings.Confirm_ReviewChanges}" />

                <ScrollViewer
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            FontSize="12.5"
                            Foreground="{StaticResource TextDimBrush}"
                            Text="{Binding ConfirmNoChanges}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ConfirmNoChanges, Converter={StaticResource NullToCollapsed}}" />

                        <StackPanel Visibility="{Binding HasAdded, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SuccessTextBrush}"
                                Text="{Binding Added.Count, StringFormat={x:Static res:Strings.Confirm_Adding}}" />
                            <ItemsControl
                                Margin="0,6,0,0"
                                ItemTemplate="{StaticResource DiffRowTemplate}"
                                ItemsSource="{Binding Added}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasRemoved, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource WarningSoftBrush}"
                                Text="{Binding Removed.Count, StringFormat={x:Static res:Strings.Confirm_Removing}}" />
                            <ItemsControl
                                Margin="0,6,0,0"
                                ItemTemplate="{StaticResource DiffRowTemplate}"
                                ItemsSource="{Binding Removed}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    Grid.Row="3"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding CancelOverwriteCommand}"
                        Content="{x:Static res:Strings.Confirm_Skip}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ConfirmOverwriteCommand}"
                        Content="{x:Static res:Strings.Confirm_Replace}"
                        Icon="{ui:SymbolIcon ArrowDownload24}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
