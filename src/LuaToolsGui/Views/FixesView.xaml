<UserControl
    x:Class="LuaToolsGui.Views.FixesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DataContext="{d:DesignInstance Type=vm:FixesViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Page-size ComboBox item display: shows the localized label while the bound value stays the
             English key (mirrors ManageView; FilterOptionDisplay is a global converter). -->
        <DataTemplate x:Key="FilterOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <HeaderedContentControl
            Grid.Row="0"
            Header="{x:Static res:Strings.Fixes_Title}"
            Style="{StaticResource PageHeaderStyle}">
            <ui:Button
                Command="{Binding RefreshCommand}"
                Content="{x:Static res:Strings.Manage_Refresh}"
                Icon="{ui:SymbolIcon ArrowSync24}" />
        </HeaderedContentControl>

        <!-- Search, then the installed-without-fix banner and the library warning (each only when shown) -->
        <StackPanel Grid.Row="1">
            <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <!-- Offline copy of the catalog (lua.tools unreachable): says the app is fine, just not live. -->
            <Border
                Margin="{DynamicResource SpaceTop12}"
                Padding="{DynamicResource SpaceAll12}"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Visibility="{Binding ShowOfflineBanner, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    Foreground="{StaticResource TextMutedBrush}"
                    Style="{StaticResource TextBody}"
                    Text="{Binding OfflineBannerText}" />
            </Border>
            <!-- Installed games with no fix in the catalog (#33). Closable: the close button sets IsOpen false,
                 which the view model persists (settings.json FixesOrphanBannerDismissed) so it stays closed. -->
            <ui:InfoBar
                Margin="{DynamicResource SpaceTop12}"
                IsClosable="True"
                IsOpen="{Binding ShowBanner, Mode=TwoWay}"
                Severity="Warning"
                Title="{Binding BannerText}">
                <!-- Content, not Message: Message is a string property and a ScrollViewer there throws on load. -->
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding BannerNames}" TextWrapping="Wrap" />
                </ScrollViewer>
            </ui:InfoBar>
            <Border
                Margin="{DynamicResource SpaceTop12}"
                Padding="{DynamicResource SpaceAll12}"
                Background="{StaticResource WarningTintBrush}"
                BorderBrush="{StaticResource WarningStrongBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Visibility="{Binding ShowLibraryWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    Foreground="{StaticResource WarningBrush}"
                    Style="{StaticResource TextBody}"
                    Text="{x:Static res:Strings.Fixes_Warn_LibraryFailed}" />
            </Border>
        </StackPanel>

        <!-- "My games" toggle + tag filter pills (shown once the listing is loaded and non-empty) -->
        <StackPanel
            Grid.Row="2"
            Margin="{DynamicResource SpaceTop12}"
            Orientation="Horizontal"
            Visibility="{Binding CanFilter, Converter={StaticResource BoolToVis}}">
            <ToggleButton
                Margin="{DynamicResource SpaceAll4}"
                Cursor="Hand"
                FocusVisualStyle="{StaticResource DefaultControlFocusVisualStyle}"
                IsChecked="{Binding MyGamesOnly}"
                ToolTip="{Binding MyGamesHint}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Pill"
                            Padding="{DynamicResource SpaceAll8}"
                            Background="{StaticResource AccentTintBrush}"
                            BorderBrush="{StaticResource AccentOutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}">
                            <TextBlock
                                x:Name="PillText"
                                FontSize="{DynamicResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentBrush}"
                                Text="{x:Static res:Strings.Fixes_MyGames}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Active: filled accent, exactly like a selected tag pill. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentTintStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="{DynamicResource SpaceAll4}"
                            Command="{Binding DataContext.SelectTagCommand, ElementName=Root}"
                            CommandParameter="{Binding Id}"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource DefaultControlFocusVisualStyle}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Pill"
                                        Padding="{DynamicResource SpaceAll8}"
                                        Background="{StaticResource AccentTintBrush}"
                                        BorderBrush="{StaticResource AccentOutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}">
                                        <TextBlock
                                            x:Name="PillText"
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource AccentBrush}"
                                            Text="{Binding Name}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Active: filled accent. -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentTintStrongBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Loading -->
        <ContentControl
            Grid.Row="3"
            Content="{x:Static res:Strings.Fixes_Loading}"
            Style="{StaticResource LoadingStateStyle}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <!-- Empty -->
        <HeaderedContentControl
            Grid.Row="3"
            Header="{Binding EmptyMessage}"
            Style="{StaticResource EmptyStateStyle}"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <!-- Game grid -->
        <vwp:VirtualizingItemsControl
            x:Name="GameScroller"
            Grid.Row="3"
            Margin="{DynamicResource SpaceTop12}"
            ItemsSource="{Binding Items}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Standard">
            <vwp:VirtualizingItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly" StretchItems="False" />
                </ItemsPanelTemplate>
            </vwp:VirtualizingItemsControl.ItemsPanel>
            <vwp:VirtualizingItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Width="248"
                        Height="180"
                        Margin="{DynamicResource SpaceAll8}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Command="{Binding DataContext.OpenGameCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        FocusVisualStyle="{StaticResource DefaultControlFocusVisualStyle}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource RadiusLarge}">
                                    <StackPanel>
                                        <!-- Top corners only (no token for a partial radius); ClipToBounds keeps the cover inside them. -->
                                        <Border Height="116" Background="{StaticResource SurfaceCardHoverBrush}" ClipToBounds="True" CornerRadius="12,12,0,0">
                                            <!-- 248-wide tile: 2x would be 496, past header.jpg's 460, so cap at 460 (see the converter). -->
                                            <Grid>
                                                <Image Source="{Binding Cover, Converter={StaticResource ImagePathToSource}, ConverterParameter=460}" Stretch="UniformToFill" />
                                                <!-- Installed badge: same as ManageView (Steam's manifest says the game is fully on disk) -->
                                                <Border
                                                    Margin="{DynamicResource SpaceAll8}"
                                                    Padding="{DynamicResource SpaceAll4}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Background="{StaticResource SuccessScrimBrush}"
                                                    CornerRadius="{DynamicResource RadiusSmall}"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon
                                                            VerticalAlignment="Center"
                                                            FontSize="{DynamicResource FontSizeCaption}"
                                                            Foreground="White"
                                                            Symbol="CheckmarkCircle24" />
                                                        <TextBlock
                                                            Margin="{DynamicResource SpaceLeft4}"
                                                            VerticalAlignment="Center"
                                                            FontSize="{DynamicResource FontSizeCaption}"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{x:Static res:Strings.Manage_Badge_Installed}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="{DynamicResource SpaceAll12}">
                                            <TextBlock
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Style="{StaticResource TextBodyStrong}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Margin="{DynamicResource SpaceTop4}"
                                                Foreground="{StaticResource TextDimBrush}"
                                                Style="{StaticResource TextCaption}"
                                                Text="{Binding FixCountLabel}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </vwp:VirtualizingItemsControl.ItemTemplate>
        </vwp:VirtualizingItemsControl>

        <!-- Pager bar: page numbers centered across the full width, with results-per-page overlaid at the
             right. Shown once game cards are present. Numbered like ManageView's pager (not PagerTemplate,
             which only has prev / label / next). -->
        <Grid
            Grid.Row="4"
            Margin="{DynamicResource SpaceTop12}"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">

            <!-- Centered group: ‹ prev | page numbers (fixed-width zone) | › next. -->
            <Grid
                HorizontalAlignment="Center"
                Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    Padding="{DynamicResource SpaceAll8}"
                    AutomationProperties.Name="{x:Static res:Strings.Pager_Prev}"
                    Command="{Binding PrevPageCommand}"
                    Content="‹"
                    FontSize="{DynamicResource FontSizeBody}"
                    IsEnabled="{Binding CanGoPrev}"
                    ToolTip="{x:Static res:Strings.Pager_Prev}" />
                <ItemsControl Grid.Column="1" HorizontalAlignment="Center" ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Ellipsis gap (sentinel 0): non-clickable "…" -->
                                <TextBlock
                                    Margin="{DynamicResource SpaceLeft8}"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Text="…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Page-number button -->
                                <ui:Button
                                    Margin="{DynamicResource SpaceLeft4}"
                                    Padding="{DynamicResource SpaceAll8}"
                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding}"
                                    FontSize="{DynamicResource FontSizeBody}">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Style.Triggers>
                                                <!-- Hide the button for the ellipsis sentinel (0) -->
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <!-- Highlight the active page -->
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualityMulti}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Grid.Column="2"
                    Margin="{DynamicResource SpaceLeft4}"
                    Padding="{DynamicResource SpaceAll8}"
                    AutomationProperties.Name="{x:Static res:Strings.Pager_Next}"
                    Command="{Binding NextPageCommand}"
                    Content="›"
                    FontSize="{DynamicResource FontSizeBody}"
                    IsEnabled="{Binding CanGoNext}"
                    ToolTip="{x:Static res:Strings.Pager_Next}" />
            </Grid>

            <!-- Right: results-per-page (overlaid at the right edge, doesn't shift the centered pager) -->
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource TextCaption}"
                    Text="{x:Static res:Strings.Manage_ResultsPerPage}" />
                <ComboBox
                    MinWidth="72"
                    Margin="{DynamicResource SpaceLeft8}"
                    ItemTemplate="{StaticResource FilterOptionTemplate}"
                    ItemsSource="{Binding PageSizeOptions}"
                    SelectedItem="{Binding SelectedPageSize}" />
            </StackPanel>
        </Grid>

        <!-- ── Detail flyout ─────────────────────────────────────────── -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Margin="-8,-16,-16,-8"
            Background="{StaticResource ScrimSoftBrush}"
            Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="Transparent" MouseLeftButtonUp="Scrim_Click" />
            <Border
                Width="420"
                HorizontalAlignment="Right"
                Background="{StaticResource SurfaceOverlayBrush}"
                BorderBrush="{StaticResource SurfaceActiveBrush}"
                BorderThickness="1,0,0,0">
                <Grid Margin="{DynamicResource SpaceAll24}" DataContext="{Binding SelectedGame}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Close -->
                    <ui:Button
                        HorizontalAlignment="Right"
                        Click="Close_Click"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{x:Static res:Strings.Saves_Close}" />

                    <!-- Game header -->
                    <StackPanel Grid.Row="1" Margin="{DynamicResource SpaceTop4}">
                        <Border Height="150" Background="{StaticResource SurfaceCardHoverBrush}" ClipToBounds="True" CornerRadius="{DynamicResource RadiusMedium}">
                            <Image Source="{Binding Cover, Converter={StaticResource ImagePathToSource}}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Margin="{DynamicResource SpaceTop12}" Style="{StaticResource TextSubtitle}" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding AppId, StringFormat='App ID: {0}'}" />
                    </StackPanel>

                    <!-- Fixes list -->
                    <ScrollViewer Grid.Row="2" Margin="{DynamicResource SpaceTop12}" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding DataContext, ElementName=Root}">
                        <StackPanel>
                            <!-- Loading fixes -->
                            <ContentControl
                                Content="{x:Static res:Strings.Common_Loading}"
                                Style="{StaticResource LoadingStateStyle}"
                                Visibility="{Binding IsLoadingFixes, Converter={StaticResource BoolToVis}}" />

                            <!-- Per-game tag filter (only when this game's fixes span multiple tags) -->
                            <ItemsControl
                                ItemsSource="{Binding FixTags}"
                                Visibility="{Binding HasFixTags, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="{DynamicResource SpaceAll4}"
                                            Command="{Binding DataContext.SelectFixTagCommand, ElementName=Root}"
                                            CommandParameter="{Binding Id}"
                                            Cursor="Hand"
                                            FocusVisualStyle="{StaticResource DefaultControlFocusVisualStyle}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="Pill"
                                                        Padding="{DynamicResource SpaceAll8}"
                                                        Background="{StaticResource AccentTintBrush}"
                                                        BorderBrush="{StaticResource AccentOutlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusSmall}">
                                                        <TextBlock x:Name="PillText" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Name}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentTintStrongBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Fixes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="{DynamicResource SpaceTop12}" Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource TextBodyStrong}"
                                                           Text="{Binding Title, StringFormat={x:Static res:Strings.Fixes_Build}}" />
                                                <TextBlock Margin="{DynamicResource SpaceTop4}" Style="{StaticResource TextCaption}" Text="{Binding DateLabel}" />

                                                <!-- Tag chips -->
                                                <ItemsControl Margin="{DynamicResource SpaceTop8}" ItemsSource="{Binding Tags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="{DynamicResource SpaceAll4}" Padding="{DynamicResource SpaceAll4}" Background="{StaticResource SurfaceInsetBrush}" CornerRadius="{DynamicResource RadiusSmall}">
                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftBrush}" Text="{Binding Name}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <markdig:MarkdownViewer
                                                    Margin="{DynamicResource SpaceTop4}"
                                                    Markdown="{Binding Description}"
                                                    PreviewMouseWheel="Markdown_PreviewMouseWheel"
                                                    Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}">
                                                    <markdig:MarkdownViewer.Resources>
                                                        <!-- Compact, dark-themed overrides — the library defaults are
                                                             document-sized (huge headings) and too big for the flyout. -->
                                                        <Style x:Key="{x:Static markdig:Styles.DocumentStyleKey}" TargetType="{x:Type FlowDocument}">
                                                            <Setter Property="FontFamily" Value="Segoe UI" />
                                                            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Setter Property="PagePadding" Value="0" />
                                                        </Style>
                                                        <Style x:Key="{x:Static markdig:Styles.ParagraphStyleKey}" TargetType="{x:Type Paragraph}">
                                                            <Setter Property="Margin" Value="0,0,0,6" />
                                                            <Setter Property="LineHeight" Value="18" />
                                                        </Style>
                                                        <Style x:Key="{x:Static markdig:Styles.Heading1StyleKey}" TargetType="{x:Type Paragraph}">
                                                            <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                            <Setter Property="Margin" Value="0,8,0,4" />
                                                        </Style>
                                                        <Style x:Key="{x:Static markdig:Styles.Heading2StyleKey}" TargetType="{x:Type Paragraph}">
                                                            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                            <Setter Property="Margin" Value="0,8,0,3" />
                                                        </Style>
                                                        <Style x:Key="{x:Static markdig:Styles.Heading3StyleKey}" TargetType="{x:Type Paragraph}">
                                                            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Setter Property="Margin" Value="0,6,0,2" />
                                                        </Style>
                                                        <Style x:Key="{x:Static markdig:Styles.HyperlinkStyleKey}" TargetType="{x:Type Hyperlink}">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="TextDecorations" Value="{x:Null}" />
                                                        </Style>
                                                        <Style x:Key="{x:Static markdig:Styles.CodeStyleKey}" TargetType="{x:Type Run}">
                                                            <Setter Property="FontFamily" Value="Consolas" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                                                        </Style>
                                                    </markdig:MarkdownViewer.Resources>
                                                </markdig:MarkdownViewer>

                                                <!-- Download buttons -->
                                                <StackPanel Margin="{DynamicResource SpaceTop12}" Orientation="Horizontal">
                                                    <ui:Button
                                                        Command="{Binding DataContext.DownloadManifestCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static res:Strings.Fixes_Manifest}"
                                                        Icon="{ui:SymbolIcon Document24}"
                                                        IsEnabled="{Binding CanDownloadManifest}"
                                                        Visibility="{Binding HasManifest, Converter={StaticResource BoolToVis}}" />
                                                    <ui:Button
                                                        Margin="{DynamicResource SpaceLeft8}"
                                                        Appearance="Primary"
                                                        Command="{Binding DataContext.DownloadFixCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static res:Strings.Fixes_Fix}"
                                                        Icon="{ui:SymbolIcon Wrench24}"
                                                        IsEnabled="{Binding CanDownloadFix}"
                                                        ToolTip="{Binding FixHint}"
                                                        Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}" />
                                                    <ui:Button
                                                        Margin="{DynamicResource SpaceLeft8}"
                                                        Command="{Binding DataContext.RevertFixCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static res:Strings.Fixes_Revert}"
                                                        Icon="{ui:SymbolIcon ArrowUndo24}"
                                                        IsEnabled="{Binding CanRevert}"
                                                        Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}" />
                                                    <ui:Button
                                                        Margin="{DynamicResource SpaceLeft8}"
                                                        Command="{Binding DataContext.CancelDownloadCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static res:Strings.Downloads_Action_Cancel}"
                                                        Visibility="{Binding CanCancelDownload, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <ProgressBar
                                                    Height="4"
                                                    Margin="{DynamicResource SpaceTop8}"
                                                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                    Maximum="100"
                                                    Value="{Binding DownloadProgress, Mode=OneWay}"
                                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock
                                                    Margin="{DynamicResource SpaceTop4}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Style="{StaticResource TextCaption}"
                                                    Text="{Binding DownloadStatus}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{Binding DownloadStatus, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Progress while downloading -->
                    <ProgressBar
                        Grid.Row="3"
                        Height="6"
                        Margin="{DynamicResource SpaceTop12}"
                        IsIndeterminate="{Binding DataContext.IsProgressIndeterminate, ElementName=Root}"
                        Maximum="100"
                        Value="{Binding DataContext.Progress, ElementName=Root}"
                        Visibility="{Binding DataContext.IsBusy, ElementName=Root, Converter={StaticResource BoolToVis}}" />

                    <!--
                        Revert confirmation (in-flyout card, same pattern as ModeView). Bindings go through
                        ElementName=Root because this Grid's DataContext is SelectedGame, not the view model.
                    -->
                    <Grid
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Margin="-24"
                        Background="{StaticResource ScrimBrush}"
                        Visibility="{Binding DataContext.IsConfirmingRevert, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <Border
                            MaxWidth="360"
                            Margin="{DynamicResource SpaceAll16}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceOverlayBrush}"
                            BorderBrush="{StaticResource BorderProminentBrush}"
                            Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock
                                    Style="{StaticResource TextSubtitle}"
                                    Text="{Binding DataContext.ConfirmRevertTitle, ElementName=Root}" />
                                <TextBlock
                                    Margin="{DynamicResource SpaceTop8}"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Style="{StaticResource TextBody}"
                                    Text="{Binding DataContext.ConfirmRevertBody, ElementName=Root}" />
                                <StackPanel
                                    Margin="{DynamicResource SpaceTop16}"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Command="{Binding DataContext.CancelRevertConfirmCommand, ElementName=Root}"
                                        Content="{x:Static res:Strings.Fixes_Revert_Cancel}" />
                                    <ui:Button
                                        Margin="{DynamicResource SpaceLeft8}"
                                        Appearance="Danger"
                                        Command="{Binding DataContext.ConfirmRevertCommand, ElementName=Root}"
                                        Content="{x:Static res:Strings.Fixes_Revert}"
                                        Icon="{ui:SymbolIcon ArrowUndo24}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
