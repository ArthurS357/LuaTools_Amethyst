<ui:FluentWindow
    x:Class="LuaToolsGui.Views.LaunchOverridesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    Title="{x:Static res:Strings.Launch_Overrides_Title}"
    Width="820"
    Height="520"
    d:DataContext="{d:DesignInstance Type=vm:LaunchOverridesViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Launch_Overrides_Title}" />

        <Grid x:Name="Root" Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{StaticResource TextMutedBrush}"
                Text="{x:Static res:Strings.Launch_Overrides_Empty}"
                Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}" />

            <ListBox
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Rows}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LaunchOverrideRow}">
                        <Grid Tag="{Binding DataContext, ElementName=Root}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding}"
                                        Header="{x:Static res:Strings.Downloads_Action_ShowInFolder}" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Text="{Binding Overrides}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Overrides}" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.ShowInFolderCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="{x:Static res:Strings.Downloads_Action_ShowInFolder}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer -->
            <StackPanel
                Grid.Row="1"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:ProgressRing
                    Width="20"
                    Height="20"
                    Margin="0,0,10,0"
                    IsIndeterminate="True"
                    Visibility="{Binding RestoreAllCommand.IsRunning, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding RestoreAllCommand}"
                    Content="{x:Static res:Strings.Launch_RestoreAll}"
                    Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}" />
                <ui:Button Click="Close_Click" Content="{x:Static res:Strings.Saves_Close}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
