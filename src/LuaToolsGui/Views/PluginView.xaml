<UserControl
    x:Class="LuaToolsGui.Views.PluginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:PluginViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="8,16,16,24">

                <!-- Header -->
                <HeaderedContentControl
                    Header="{x:Static res:Strings.Plugin_Title}"
                    Style="{StaticResource PageHeaderStyle}"
                    Tag="{x:Static res:Strings.Plugin_Subtitle}" />

                <!-- Status card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                Foreground="{StaticResource InfoBrush}"
                                Symbol="PuzzlePiece24" />
                            <TextBlock
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                Style="{StaticResource TextSubtitle}"
                                Text="{x:Static res:Strings.Plugin_CardTitle}" />
                            <Border
                                Margin="{DynamicResource SpaceLeft12}"
                                Padding="{DynamicResource SpaceAll4}"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentBadgeBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentSoftBrush}"
                                    Text="{x:Static res:Strings.Plugin_Status_Installed}" />
                            </Border>
                            <Border
                                Margin="{DynamicResource SpaceLeft8}"
                                Padding="{DynamicResource SpaceAll4}"
                                VerticalAlignment="Center"
                                Background="{StaticResource WarningTintBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource WarningBrush}"
                                    Text="{x:Static res:Strings.Plugin_Badge_UpdateAvailable}" />
                            </Border>
                        </StackPanel>

                        <!-- Status rows: each has a leading colored status glyph so state reads at a glance.
                             Rows breathe through a top margin on every cell (SpaceTop4), not a pair of literals. -->
                        <Grid Margin="{DynamicResource SpaceTop16}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Version -->
                            <ui:SymbolIcon Grid.Row="0" Grid.Column="0" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{StaticResource TextDimBrush}" Symbol="Tag24" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" Foreground="{StaticResource TextDimBrush}" Text="{x:Static res:Strings.Plugin_Row_InstalledVersion}" />
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding InstalledVersion}" />
                                <!-- Update available: arrow to the newer tag, amber. -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Margin="{DynamicResource SpaceLeft8}" FontSize="{DynamicResource FontSizeBody}" Foreground="{StaticResource TextDimBrush}" Text="→" />
                                    <TextBlock Margin="{DynamicResource SpaceLeft8}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="{Binding LatestVersion}" />
                                </StackPanel>
                                <!-- Up to date pill, green. -->
                                <Border Margin="{DynamicResource SpaceLeft8}" Padding="{DynamicResource SpaceAll4}" Background="{StaticResource SuccessTintBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        Visibility="{Binding ShowUpToDate, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" Text="{x:Static res:Strings.Plugin_Status_UpToDate}" />
                                </Border>
                            </StackPanel>

                            <!-- Frontend -->
                            <Grid Grid.Row="1" Grid.Column="0" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center">
                                <ui:SymbolIcon FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{StaticResource SuccessTextBrush}" Symbol="CheckmarkCircle24" Visibility="{Binding FrontendInstalled, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{StaticResource TextDimBrush}" Symbol="DismissCircle24" Visibility="{Binding FrontendInstalled, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" Foreground="{StaticResource TextDimBrush}" Text="{x:Static res:Strings.Plugin_Row_Frontend}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding FrontendStatus}" />

                            <!-- Loader (winmm.dll) -->
                            <Grid Grid.Row="2" Grid.Column="0" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center">
                                <ui:SymbolIcon FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{StaticResource SuccessTextBrush}" Symbol="CheckmarkCircle24" Visibility="{Binding DllOk, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{StaticResource WarningBrush}" Symbol="Warning24" Visibility="{Binding DllOutOfDate, Converter={StaticResource BoolToVis}}" />
                                <!-- Installed, but nothing was published to compare it against (offline, or
                                     the active source is broken). Neutral on purpose: amber here would be
                                     asserting the file is stale, which is exactly what is not known. -->
                                <ui:SymbolIcon FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{StaticResource TextDimBrush}" Symbol="Info24" Visibility="{Binding DllUnknown, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{StaticResource TextDimBrush}" Symbol="DismissCircle24" Visibility="{Binding DllNotInstalled, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" Foreground="{StaticResource TextDimBrush}" Text="{x:Static res:Strings.Plugin_Row_Loader}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DllStatus}" />

                            <!-- Source: the creator this install comes from. Chosen by the user in the
                                 cards below and never changed on their behalf, so this row states a fact
                                 about the install rather than reporting where a fallback ended up. -->
                            <ui:SymbolIcon Grid.Row="3" Grid.Column="0" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{StaticResource TextDimBrush}" Symbol="CloudArrowDown24" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="{DynamicResource SpaceTop4}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" Foreground="{StaticResource TextDimBrush}" Text="{x:Static res:Strings.Plugin_Row_Source}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="2"
                                Margin="{DynamicResource SpaceTop4}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Static res:Strings.Plugin_Row_Source}"
                                FontSize="{DynamicResource FontSizeBody}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding ActiveSource}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!-- The active source cannot serve an install. An ERROR, not a nudge: nothing has
                             switched to the other creator, so this is what tells the user their plugin is
                             stuck and that picking another source below is the way out. -->
                        <Border
                            Margin="{DynamicResource SpaceTop16}"
                            Padding="{DynamicResource SpaceAll12}"
                            Background="{StaticResource AlertTintStrongBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Visibility="{Binding ActiveSourceError, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    VerticalAlignment="Top"
                                    FontSize="{DynamicResource FontSizeSubtitle}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Symbol="ErrorCircle24" />
                                <TextBlock
                                    Margin="{DynamicResource SpaceLeft12}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.LiveSetting="Assertive"
                                    Foreground="{StaticResource DangerBrush}"
                                    Style="{StaticResource TextBody}"
                                    Text="{Binding ActiveSourceError}" />
                            </StackPanel>
                        </Border>

                        <!-- Millennium coexisting info -->
                        <Border
                            Margin="{DynamicResource SpaceTop16}"
                            Padding="{DynamicResource SpaceAll12}"
                            Background="{StaticResource InfoTintBrush}"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Visibility="{Binding MillenniumCoexisting, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Foreground="{StaticResource InfoBrush}"
                                Style="{StaticResource TextCaption}"
                                Text="{x:Static res:Strings.Plugin_Millennium_Coexisting}" />
                        </Border>

                        <!-- Buttons -->
                        <StackPanel Margin="{DynamicResource SpaceTop16}" Orientation="Horizontal">
                            <ui:Button
                                MinWidth="120"
                                HorizontalContentAlignment="Center"
                                Command="{Binding InstallCommand}"
                                Content="{Binding InstallButtonText}"
                                IsEnabled="{Binding NotBusy}">
                                <!-- Primary (green) only when there's something to do (Install/Update);
                                     a healthy "Reinstall" stays secondary. -->
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InstallIsPrimary}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button
                                MinWidth="110"
                                Margin="{DynamicResource SpaceLeft8}"
                                HorizontalContentAlignment="Center"
                                Appearance="Danger"
                                Command="{Binding UninstallCommand}"
                                Content="{x:Static res:Strings.Plugin_Btn_Uninstall}"
                                IsEnabled="{Binding CanUninstall}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />
                            <ui:Button
                                Margin="{DynamicResource SpaceLeft8}"
                                HorizontalContentAlignment="Center"
                                Command="{Binding CheckForUpdatesCommand}"
                                Content="{x:Static res:Strings.Plugin_Btn_CheckForUpdates}"
                                IsEnabled="{Binding NotBusy}" />
                        </StackPanel>

                        <!-- Progress -->
                        <ProgressBar
                            Height="6"
                            Margin="{DynamicResource SpaceTop16}"
                            IsIndeterminate="{Binding IsProgressIndeterminate}"
                            Maximum="100"
                            Value="{Binding Progress}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                        <!-- Status line (offline/errors) -->
                        <TextBlock
                            Margin="{DynamicResource SpaceTop12}"
                            Foreground="{StaticResource WarningStrongBrush}"
                            Style="{StaticResource TextCaption}"
                            Text="{Binding StatusLine}"
                            Visibility="{Binding StatusLine, Converter={StaticResource NullToCollapsed}}" />

                    </StackPanel>
                </Border>

                <!-- ── Plugin sources ──────────────────────────────────────────────────────────
                     One card per creator, laid out exactly like the Mode page's cards: same border,
                     padding, ACTIVE badge and right-hand action column. Both pages answer the same
                     question — which of several mutually exclusive things is the installed one — so
                     they are deliberately the same control, not two takes on it.

                     There is no fallback behind this list: the active card is what gets installed, and
                     a broken source shows its reason here instead of quietly handing the install to the
                     other creator. -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Plugin_Sources_Header}" />
                <TextBlock
                    Foreground="{StaticResource TextMutedBrush}"
                    Style="{StaticResource TextCaption}"
                    Text="{x:Static res:Strings.Plugin_Sources_Subtitle}" />

                <ItemsControl
                    AutomationProperties.Name="{x:Static res:Strings.Plugin_Sources_Header}"
                    ItemsSource="{Binding Sources}"
                    KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- The active card is outlined in the accent rather than only badged:
                                 the badge alone puts the whole signal on an 11px word, and the
                                 outline is what makes "which one am I on" readable without it. -->
                            <Border Margin="{DynamicResource SpaceTop12}">
                                <Border.Style>
                                    <Style BasedOn="{StaticResource CardStyle}" TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentOutlineBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource AccentBrush}"
                                                Symbol="PuzzlePiece24" />
                                            <TextBlock
                                                Margin="{DynamicResource SpaceLeft12}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource TextSubtitle}"
                                                Text="{Binding Slug}" />
                                            <Border
                                                Margin="{DynamicResource SpaceLeft12}"
                                                Padding="{DynamicResource SpaceAll4}"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource AccentBadgeBrush}"
                                                CornerRadius="{DynamicResource RadiusSmall}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    AutomationProperties.Name="{x:Static res:Strings.Plugin_Source_Active}"
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource AccentSoftBrush}"
                                                    Text="{x:Static res:Strings.Plugin_Source_Active}" />
                                            </Border>
                                            <!-- Which entry a user who has never chosen is on. -->
                                            <Border
                                                Margin="{DynamicResource SpaceLeft8}"
                                                Padding="{DynamicResource SpaceAll4}"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource SurfaceStrongBrush}"
                                                CornerRadius="{DynamicResource RadiusSmall}"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="{x:Static res:Strings.Plugin_Source_Default}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock
                                            Margin="{DynamicResource SpaceTop8}"
                                            Foreground="{StaticResource TextDimBrush}"
                                            Style="{StaticResource TextCaption}"
                                            Text="{Binding Creator}" />

                                        <TextBlock
                                            Margin="{DynamicResource SpaceTop8}"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Style="{StaticResource TextBody}"
                                            Text="{Binding StatusText}" />

                                        <!-- What this source publishes right now. -->
                                        <StackPanel Margin="{DynamicResource SpaceTop8}" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="{DynamicResource FontSizeBody}"
                                                Foreground="{StaticResource TextDimBrush}"
                                                Text="{x:Static res:Strings.Plugin_Source_LatestVersion}" />
                                            <TextBlock
                                                Margin="{DynamicResource SpaceLeft8}"
                                                FontSize="{DynamicResource FontSizeBody}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="{Binding LatestVersion}" />
                                        </StackPanel>

                                        <!-- Why this source cannot be installed from. Stated on the card
                                             it belongs to, so choosing between sources is informed. -->
                                        <TextBlock
                                            Margin="{DynamicResource SpaceTop8}"
                                            Foreground="{StaticResource WarningStrongBrush}"
                                            Style="{StaticResource TextCaption}"
                                            Text="{Binding ProblemText}"
                                            Visibility="{Binding ProblemText, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="{DynamicResource SpaceLeft16}" VerticalAlignment="Center">
                                        <!-- Switching is the only action a non-active card offers; the
                                             active one is driven by the Install/Update button above,
                                             which is the same split the Mode page uses. -->
                                        <ui:Button
                                            MinWidth="140"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="{x:Static res:Strings.Plugin_Btn_Activate}"
                                            Command="{Binding DataContext.ActivateCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="{x:Static res:Strings.Plugin_Btn_Activate}"
                                            Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                            IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}"
                                            Visibility="{Binding ShowActivate, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- "What this does" — fills the page and explains the plugin at a glance. -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Plugin_About_Header}" />

                <StackPanel>
                    <Border Margin="{DynamicResource SpaceTop8}" Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" VerticalAlignment="Center" Background="{StaticResource AccentTintHoverBrush}" CornerRadius="{DynamicResource RadiusMedium}">
                                <ui:SymbolIcon FontSize="{DynamicResource FontSizeTitle}" Foreground="{StaticResource AccentBrush}" Symbol="AddCircle24" />
                            </Border>
                            <TextBlock Margin="{DynamicResource SpaceLeft12}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource TextBody}" Text="{x:Static res:Strings.Plugin_Feature_StoreButton}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="{DynamicResource SpaceTop8}" Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" VerticalAlignment="Center" Background="{StaticResource AccentTintHoverBrush}" CornerRadius="{DynamicResource RadiusMedium}">
                                <ui:SymbolIcon FontSize="{DynamicResource FontSizeTitle}" Foreground="{StaticResource AccentBrush}" Symbol="ArrowSync24" />
                            </Border>
                            <TextBlock Margin="{DynamicResource SpaceLeft12}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource TextBody}" Text="{x:Static res:Strings.Plugin_Feature_AutoUpdate}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="{DynamicResource SpaceTop8}" Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" VerticalAlignment="Center" Background="{StaticResource AccentTintHoverBrush}" CornerRadius="{DynamicResource RadiusMedium}">
                                <ui:SymbolIcon FontSize="{DynamicResource FontSizeTitle}" Foreground="{StaticResource AccentBrush}" Symbol="PuzzlePiece24" />
                            </Border>
                            <TextBlock Margin="{DynamicResource SpaceLeft12}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource TextBody}" Text="{x:Static res:Strings.Plugin_Feature_Millennium}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock
                    Margin="{DynamicResource SpaceTop12}"
                    Foreground="{StaticResource TextDimBrush}"
                    Style="{StaticResource TextCaption}"
                    Text="{x:Static res:Strings.Plugin_Footer}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
