<ui:FluentWindow
    x:Class="LuaToolsGui.Views.LaunchOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    Title="{x:Static res:Strings.Launch_Title}"
    Width="820"
    Height="600"
    d:DataContext="{d:DesignInstance Type=vm:LaunchOptionsViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Launch_Title}" />

        <Grid x:Name="Root" Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    Style="{StaticResource TextSubtitle}"
                    Text="{Binding GameName}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Margin="{DynamicResource SpaceTop4}"
                    Style="{StaticResource TextCaption}"
                    Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
            </StackPanel>

            <!-- Loading (indexing the 373 MB cache takes a couple of seconds) -->
            <ContentControl
                Grid.Row="1"
                Content="{x:Static res:Strings.Launch_Loading}"
                Style="{StaticResource LoadingStateStyle}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <HeaderedContentControl
                Grid.Row="1"
                Header="{Binding Error}"
                Style="{StaticResource ErrorStateStyle}"
                Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

            <!-- Editor -->
            <Grid Grid.Row="1" Margin="{DynamicResource SpaceTop16}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding Error}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Entry list + list actions -->
                <Border Padding="{DynamicResource SpaceAll8}" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}"
                            ItemsSource="{Binding Entries}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding Selected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="{DynamicResource FontSizeBody}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{StaticResource TextDimBrush}"
                                            Style="{StaticResource TextCaption}"
                                            Text="{Binding Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <UniformGrid
                            Grid.Row="1"
                            Margin="{DynamicResource SpaceTop8}"
                            Columns="4">
                            <ui:Button
                                HorizontalAlignment="Stretch"
                                Command="{Binding AddEntryCommand}"
                                Content="{x:Static res:Strings.Launch_Add}" />
                            <ui:Button
                                Margin="{DynamicResource SpaceLeft4}"
                                HorizontalAlignment="Stretch"
                                Appearance="Danger"
                                Command="{Binding DeleteEntryCommand}"
                                Content="{x:Static res:Strings.Launch_Delete}"
                                IsEnabled="{Binding HasSelection}" />
                            <ui:Button
                                Margin="{DynamicResource SpaceLeft4}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_MoveUp}"
                                Command="{Binding MoveUpCommand}"
                                Content="↑"
                                IsEnabled="{Binding HasSelection}"
                                ToolTip="{x:Static res:Strings.Downloads_Action_MoveUp}" />
                            <ui:Button
                                Margin="{DynamicResource SpaceLeft4}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_MoveDown}"
                                Command="{Binding MoveDownCommand}"
                                Content="↓"
                                IsEnabled="{Binding HasSelection}"
                                ToolTip="{x:Static res:Strings.Downloads_Action_MoveDown}" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Fields for the selected entry -->
                <ScrollViewer
                    Grid.Column="1"
                    Margin="{DynamicResource SpaceLeft16}"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        Margin="{DynamicResource SpaceAll4}"
                        DataContext="{Binding Selected}"
                        Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                        <TextBlock
                            Style="{StaticResource TextCaption}"
                            Text="{x:Static res:Strings.Launch_Field_Executable}" />
                        <ui:TextBox Margin="{DynamicResource SpaceTop4}" Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="{DynamicResource SpaceTop12}"
                            Style="{StaticResource TextCaption}"
                            Text="{x:Static res:Strings.Launch_Field_Arguments}" />
                        <ui:TextBox Margin="{DynamicResource SpaceTop4}" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="{DynamicResource SpaceTop12}"
                            Style="{StaticResource TextCaption}"
                            Text="{x:Static res:Strings.Launch_Field_WorkingDir}" />
                        <ui:TextBox Margin="{DynamicResource SpaceTop4}" Text="{Binding WorkingDir, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="{DynamicResource SpaceTop12}"
                            Style="{StaticResource TextCaption}"
                            Text="{x:Static res:Strings.Launch_Field_Description}" />
                        <ui:TextBox Margin="{DynamicResource SpaceTop4}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="{DynamicResource SpaceTop12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    Style="{StaticResource TextCaption}"
                                    Text="{x:Static res:Strings.Launch_Field_Os}" />
                                <ComboBox
                                    Margin="{DynamicResource SpaceTop4}"
                                    HorizontalAlignment="Stretch"
                                    IsEditable="True"
                                    ItemsSource="{Binding DataContext.OsOptions, ElementName=Root}"
                                    Text="{Binding OsList, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="{DynamicResource SpaceLeft12}">
                                <TextBlock
                                    Style="{StaticResource TextCaption}"
                                    Text="{x:Static res:Strings.Launch_Field_Type}" />
                                <ComboBox
                                    Margin="{DynamicResource SpaceTop4}"
                                    HorizontalAlignment="Stretch"
                                    IsEditable="True"
                                    ItemsSource="{Binding DataContext.TypeOptions, ElementName=Root}"
                                    Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="{DynamicResource SpaceTop12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    Style="{StaticResource TextCaption}"
                                    Text="{x:Static res:Strings.Launch_Field_BetaKey}" />
                                <ComboBox
                                    Margin="{DynamicResource SpaceTop4}"
                                    HorizontalAlignment="Stretch"
                                    IsEditable="True"
                                    ItemsSource="{Binding DataContext.BranchOptions, ElementName=Root}"
                                    Text="{Binding BetaKey, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{x:Static res:Strings.Launch_Field_BetaKey_Tip}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="{DynamicResource SpaceLeft12}">
                                <TextBlock
                                    Style="{StaticResource TextCaption}"
                                    Text="{x:Static res:Strings.Launch_Field_OwnsDlc}" />
                                <ui:TextBox Margin="{DynamicResource SpaceTop4}" Text="{Binding OwnsDlc, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="{DynamicResource SpaceTop16}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Foreground="{StaticResource TextDimBrush}"
                        Style="{StaticResource TextCaption}"
                        Text="{Binding InstallPath, StringFormat={x:Static res:Strings.Launch_InstallPath}}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        Visibility="{Binding InstallPath, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock
                        Margin="{DynamicResource SpaceTop4}"
                        Foreground="{StaticResource WarningSoftBrush}"
                        Style="{StaticResource TextCaption}"
                        Text="{x:Static res:Strings.Launch_SteamRestartNote}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Writing appinfo.vdf (Steam closing + ~373 MB rewrite) runs off the UI thread now -->
                    <ui:ProgressRing
                        Width="20"
                        Height="20"
                        IsIndeterminate="True"
                        Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        Margin="{DynamicResource SpaceLeft12}"
                        Command="{Binding ShowInFolderCommand}"
                        Content="{x:Static res:Strings.Downloads_Action_ShowInFolder}" />
                    <ui:Button
                        Margin="{DynamicResource SpaceLeft8}"
                        Command="{Binding RestoreCommand}"
                        Content="{x:Static res:Strings.Launch_Restore}"
                        IsEnabled="{Binding CanRestore}"
                        ToolTip="{x:Static res:Strings.Launch_Restore_Tip}" />
                    <ui:Button
                        Margin="{DynamicResource SpaceLeft8}"
                        Command="{Binding CancelCommand}"
                        Content="{x:Static res:Strings.Builds_Action_Cancel}" />
                    <ui:Button
                        Margin="{DynamicResource SpaceLeft8}"
                        Appearance="Primary"
                        Command="{Binding SaveCommand}"
                        Content="{x:Static res:Strings.Builds_Action_Save}"
                        IsEnabled="{Binding CanSave}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
