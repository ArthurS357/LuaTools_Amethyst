<ui:FluentWindow
    x:Class="LuaToolsGui.Views.LaunchOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    Title="{x:Static res:Strings.Launch_Title}"
    Width="820"
    Height="600"
    d:DataContext="{d:DesignInstance Type=vm:LaunchOptionsViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Launch_Title}" />

        <Grid x:Name="Root" Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="17"
                    FontWeight="Bold"
                    Text="{Binding GameName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11.5"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
            </StackPanel>

            <!-- Loading (indexing the 373 MB cache takes a couple of seconds) -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ui:ProgressRing
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{x:Static res:Strings.Launch_Loading}" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Margin="0,20,0,0"
                VerticalAlignment="Top"
                FontSize="12"
                Foreground="{StaticResource DangerBrush}"
                Text="{Binding Error}"
                TextWrapping="Wrap"
                Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

            <!-- Editor -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding Error}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Entry list + list actions -->
                <Border
                    Padding="8"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox
                            Margin="-4,0,-4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Entries}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding Selected}">
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,5" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="12.5"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="10.5"
                                            Foreground="{StaticResource TextDimBrush}"
                                            Text="{Binding Subtitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <UniformGrid
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            Columns="4">
                            <ui:Button
                                Margin="0,0,3,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding AddEntryCommand}"
                                Content="{x:Static res:Strings.Launch_Add}" />
                            <ui:Button
                                Margin="3,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DeleteEntryCommand}"
                                Content="{x:Static res:Strings.Launch_Delete}"
                                IsEnabled="{Binding HasSelection}" />
                            <ui:Button
                                Margin="3,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding MoveUpCommand}"
                                Content="↑"
                                IsEnabled="{Binding HasSelection}" />
                            <ui:Button
                                Margin="3,0,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding MoveDownCommand}"
                                Content="↓"
                                IsEnabled="{Binding HasSelection}" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Fields for the selected entry -->
                <ScrollViewer
                    Grid.Column="1"
                    Margin="14,0,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        Margin="0,0,6,0"
                        DataContext="{Binding Selected}"
                        Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{x:Static res:Strings.Launch_Field_Executable}" />
                        <ui:TextBox Margin="0,4,0,0" Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="11.5"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{x:Static res:Strings.Launch_Field_Arguments}" />
                        <ui:TextBox Margin="0,4,0,0" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="11.5"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{x:Static res:Strings.Launch_Field_WorkingDir}" />
                        <ui:TextBox Margin="0,4,0,0" Text="{Binding WorkingDir, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="11.5"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{x:Static res:Strings.Launch_Field_Description}" />
                        <ui:TextBox Margin="0,4,0,0" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{x:Static res:Strings.Launch_Field_Os}" />
                                <ComboBox
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    IsEditable="True"
                                    ItemsSource="{Binding DataContext.OsOptions, ElementName=Root}"
                                    Text="{Binding OsList, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{x:Static res:Strings.Launch_Field_Type}" />
                                <ComboBox
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    IsEditable="True"
                                    ItemsSource="{Binding DataContext.TypeOptions, ElementName=Root}"
                                    Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{x:Static res:Strings.Launch_Field_BetaKey}" />
                                <ComboBox
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    IsEditable="True"
                                    ItemsSource="{Binding DataContext.BranchOptions, ElementName=Root}"
                                    Text="{Binding BetaKey, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{x:Static res:Strings.Launch_Field_BetaKey_Tip}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{x:Static res:Strings.Launch_Field_OwnsDlc}" />
                                <ui:TextBox Margin="0,4,0,0" Text="{Binding OwnsDlc, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource TextDimBrush}"
                        Text="{Binding InstallPath, StringFormat={x:Static res:Strings.Launch_InstallPath}}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding InstallPath, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="10.5"
                        Foreground="{StaticResource WarningSoftBrush}"
                        Text="{x:Static res:Strings.Launch_SteamRestartNote}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding RestoreCommand}"
                        Content="{x:Static res:Strings.Launch_Restore}"
                        IsEnabled="{Binding IsModded}"
                        ToolTip="{x:Static res:Strings.Launch_Restore_Tip}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding CancelCommand}"
                        Content="{x:Static res:Strings.Builds_Action_Cancel}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Command="{Binding SaveCommand}"
                        Content="{x:Static res:Strings.Builds_Action_Save}"
                        IsEnabled="{Binding CanSave}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
