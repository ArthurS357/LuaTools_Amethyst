<UserControl
    x:Class="LuaToolsGui.Views.DownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:downloads="clr-namespace:LuaToolsGui.Services.Downloads"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DownloadsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <!-- Layout, spacing and tokens deliberately mirror AboutView/PluginView so this page reads as part of
         the same app. Every colour comes from Themes/Colors.xaml — no literals. -->
    <UserControl.Resources>

        <!--  One live queue row: cover, title/source, progress + metrics, action buttons.  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type downloads:DownloadItem}">
            <Border
                Margin="0,0,0,8"
                Padding="14"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="10">

                <!--  The row's own DataContext is the item, so the commands are reached through the page.  -->
                <Border.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                </Border.Tag>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CopyAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Downloads_Action_CopyAppId}"
                            Icon="{ui:SymbolIcon Copy24}"
                            Visibility="{Binding CanCopyAppId, Converter={StaticResource BoolToVis}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Downloads_Action_ShowInFolder}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Visibility="{Binding CanShowInFolder, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Cover. The placeholder fill keeps the row height stable while the art loads.  -->
                    <Border
                        Width="92"
                        Height="43"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceInsetBrush}"
                        CornerRadius="6">
                        <Image
                            Source="{Binding CoverPath, Converter={StaticResource ImagePathToSource}}"
                            Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />

                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding SubTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="6,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextDimBrush}"
                                Text="·" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding StatusLabel}" />
                        </StackPanel>

                        <!--  "Action required": the download is done but waiting on a confirmation.  -->
                        <Border
                            Margin="0,6,0,0"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource WarningTintBrush}"
                            CornerRadius="4"
                            Visibility="{Binding NeedsAction, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource WarningBrush}"
                                Text="{x:Static res:Strings.Downloads_ActionRequired}" />
                        </Border>

                        <!--  Multi-step detail, e.g. a depot job's "Depot 3 of 12 · Downloading".  -->
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextDimBrush}"
                            Text="{Binding Detail}"
                            Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />

                        <ProgressBar
                            Height="4"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="{Binding Title}"
                            IsIndeterminate="{Binding IsIndeterminate}"
                            Maximum="100"
                            Value="{Binding Percent, Mode=OneWay}"
                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />

                        <!--  Size · rate · ETA. Each hides itself when it has nothing to say.  -->
                        <StackPanel
                            Margin="0,5,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding SizeLabel}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextDimBrush}"
                                Text="{Binding RateLabel}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextDimBrush}"
                                Text="{Binding EtaLabel}" />
                        </StackPanel>

                        <!--  Outcome line. Red only for a real failure; a cancel is not an error.  -->
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="11"
                            Text="{Binding Message}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!--  Actions. Each button shows only in the states where it means something.  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_Review}"
                            Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Downloads_Action_Review}"
                            Visibility="{Binding NeedsAction, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_Pause}"
                            Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon Pause24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_Pause}"
                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Appearance="Primary"
                            AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_Resume}"
                            Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Downloads_Action_Resume}"
                            Icon="{ui:SymbolIcon Play24}"
                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_MoveUp}"
                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon ChevronUp24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_MoveUp}"
                            Visibility="{Binding CanReorder, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_MoveDown}"
                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon ChevronDown24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_MoveDown}"
                            Visibility="{Binding CanReorder, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_Cancel}"
                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Downloads_Action_Cancel}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_Retry}"
                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Downloads_Action_Retry}"
                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_Remove}"
                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_Remove}"
                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  One history row: compact, no progress.  -->
        <DataTemplate x:Key="HistoryItemTemplate" DataType="{x:Type downloads:DownloadHistoryEntry}">
            <!--  Transparent, not unset: a null Background is not hit-tested, so the right-click would only
                  register over the text rather than anywhere on the row.  -->
            <Border Padding="12,8" Background="Transparent">
                <Border.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                </Border.Tag>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CopyHistoryAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Downloads_Action_CopyAppId}"
                            Icon="{ui:SymbolIcon Copy24}"
                            Visibility="{Binding CanCopyAppId, Converter={StaticResource BoolToVis}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.ShowHistoryInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Downloads_Action_ShowInFolder}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Visibility="{Binding CanShowInFolder, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding SubTitle}" />
                            <TextBlock
                                Margin="6,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextDimBrush}"
                                Text="·" />
                            <TextBlock
                                FontSize="11"
                                Text="{Binding StatusLabel}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                Margin="6,0,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextDimBrush}"
                                Text="{Binding SizeLabel}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextDimBrush}"
                        Text="{Binding WhenLabel}" />
                    <!--  Always visible, matching the queue rows above. Removing a history row deletes a
                          record, never a file, so it acts immediately with no prompt.  -->
                    <ui:Button
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="6,3"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_Remove}"
                        Command="{Binding DataContext.RemoveHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="{x:Static res:Strings.Downloads_Action_Remove}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" Margin="8,16,16,24">

                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{x:Static res:Strings.Downloads_Title}" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="13"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{x:Static res:Strings.Downloads_Subtitle}"
                    TextWrapping="Wrap" />

                <!--  Empty state: nothing queued AND nothing in history.  -->
                <Border
                    Margin="0,18,0,0"
                    Padding="24"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="28"
                            Foreground="{DynamicResource TextDimBrush}"
                            Symbol="ArrowDownload24" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{x:Static res:Strings.Downloads_Empty}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Queue  -->
                <TextBlock
                    Margin="0,20,0,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Static res:Strings.Downloads_Section_Active}"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemTemplate="{StaticResource QueueItemTemplate}" ItemsSource="{Binding Queue.Items}" />

                <!--  History  -->
                <Grid Margin="0,20,0,10" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Static res:Strings.Downloads_Section_History}" />
                    <ui:Button
                        HorizontalAlignment="Right"
                        Appearance="Secondary"
                        AutomationProperties.Name="{x:Static res:Strings.Downloads_Action_ClearHistory}"
                        Command="{Binding ClearHistoryCommand}"
                        Content="{x:Static res:Strings.Downloads_Action_ClearHistory}" />
                </Grid>
                <Border
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemTemplate="{StaticResource HistoryItemTemplate}" ItemsSource="{Binding Queue.History}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
