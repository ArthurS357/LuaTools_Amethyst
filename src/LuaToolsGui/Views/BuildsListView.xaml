<UserControl
    x:Class="LuaToolsGui.Views.BuildsListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:themes="clr-namespace:LuaToolsGui.Themes"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:BuildsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root" MinHeight="36">
        <ListBox
            x:Name="GameList"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource ListItemStyle}"
            ItemsSource="{Binding ListItems}"
            PreviewKeyDown="List_PreviewKeyDown"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionMode="Single"
            VirtualizingPanel.CacheLength="1,1"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid
                        x:Name="RowRoot"
                        MinHeight="34"
                        themes:Motion.EnableSmoothHover="True"
                        Background="Transparent"
                        Cursor="Hand"
                        DataContextChanged="Row_DataContextChanged"
                        Loaded="Row_Loaded"
                        MouseLeftButtonUp="Row_Click">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_ViewDetails}"
                                    Icon="{ui:SymbolIcon Info24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Header="{x:Static res:Strings.Builds_RemoveGame_Tip}"
                                    Icon="{ui:SymbolIcon Delete24}" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <Grid.Tag>
                            <Binding ElementName="Root" Path="DataContext" />
                        </Grid.Tag>
                        <!-- GPU-composited hover overlay -->
                        <Border
                            x:Name="HoverOverlay"
                            Background="{StaticResource SurfaceTintBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <Grid Margin="{DynamicResource SpaceAll4}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Compact 36x20 Steam-library thumbnail (reuses decoded cache, zero extra HTTP) -->
                            <Border
                                Grid.Column="0"
                                Width="36"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceCardHoverBrush}"
                                ClipToBounds="True"
                                CornerRadius="{DynamicResource RadiusSmall}">
                                <Image
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Source="{Binding Cover}"
                                    Stretch="UniformToFill" />
                            </Border>

                            <!-- Title + subtle AppID (active lua highlighted vs muted stored-only) -->
                            <Grid Grid.Column="1" Margin="{DynamicResource SpaceLeft12}" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeBody}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SavedBuildsOnly}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasActiveLua}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="{DynamicResource SpaceLeft8}"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Text="{Binding AppIdText}" />
                            </Grid>

                            <!-- Right: Status badge (Default / No active lua), preset count pill, Remove action -->
                            <StackPanel
                                Grid.Column="2"
                                Margin="{DynamicResource SpaceLeft12}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Border
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceInsetBrush}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Visibility="{Binding VariantBadge, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentSoftBrush}"
                                        Text="{Binding VariantBadge}" />
                                </Border>

                                <Border
                                    Margin="{DynamicResource SpaceLeft8}"
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource WarningInsetBrush}"
                                    BorderBrush="{StaticResource WarningOutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Visibility="{Binding SavedBuildsOnly, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource WarningSoftBrush}"
                                        Text="{x:Static res:Strings.Builds_SavedBuildsNoLua}" />
                                </Border>

                                <Border
                                    Margin="{DynamicResource SpaceLeft8}"
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceInsetBrush}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Visibility="{Binding HasPresetsCount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentSoftBrush}"
                                        Text="{Binding PresetsCountLabel}" />
                                </Border>

                                <ui:Button
                                    Margin="{DynamicResource SpaceLeft8}"
                                    Padding="{DynamicResource SpaceAll4}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Static res:Strings.Builds_RemoveGame_Tip}"
                                    Background="{StaticResource DangerScrimBrush}"
                                    Command="{Binding DataContext.RemoveGameCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Icon="{ui:SymbolIcon Delete24}"
                                    ToolTip="{x:Static res:Strings.Builds_RemoveGame_Tip}">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowRoot}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
