<UserControl
    x:Class="LuaToolsGui.Views.BuildsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:themes="clr-namespace:LuaToolsGui.Themes"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DataContext="{d:DesignInstance Type=vm:BuildsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Results-per-page item display: shows the localized label while the bound value stays the
             English key ("All"), which PagedListViewModel parses. Same as Manage & Fixes. -->
        <DataTemplate x:Key="FilterOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="8,16,16,8">
        <!-- ── State 1: Full-width Grid / Steam-style List ─────────── -->
        <Grid x:Name="State1Host" Visibility="{Binding IsShowingGrid, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <HeaderedContentControl
                Grid.Row="0"
                Header="{x:Static res:Strings.Builds_Title}"
                Style="{StaticResource PageHeaderStyle}"
                Tag="{x:Static res:Strings.Builds_Subtitle}">
                <ui:Button
                    Command="{Binding RefreshCommand}"
                    Content="{x:Static res:Strings.Manage_Refresh}"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
            </HeaderedContentControl>

            <!-- Search + View mode + instant local filter pills (zero network calls) -->
            <StackPanel Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <views:ViewModeToggle
                        Grid.Column="1"
                        Margin="{DynamicResource SpaceLeft8}"
                        ViewMode="{Binding ViewMode, Mode=TwoWay}" />
                </Grid>
                <WrapPanel Margin="{DynamicResource SpaceTop12}" Orientation="Horizontal">
                    <ui:Button
                        Margin="{DynamicResource SpaceAll4}"
                        Command="{Binding SetQuickFilterCommand}"
                        CommandParameter="{x:Static vm:BuildsQuickFilter.All}"
                        Content="{x:Static res:Strings.Builds_Filter_All}">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button
                        Margin="{DynamicResource SpaceAll4}"
                        Command="{Binding SetQuickFilterCommand}"
                        CommandParameter="{x:Static vm:BuildsQuickFilter.WithStoredBuilds}"
                        Content="{x:Static res:Strings.Builds_Filter_WithStoredBuilds}">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterWithStoredBuilds}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button
                        Margin="{DynamicResource SpaceAll4}"
                        Command="{Binding SetQuickFilterCommand}"
                        CommandParameter="{x:Static vm:BuildsQuickFilter.WithoutActiveLua}"
                        Content="{x:Static res:Strings.Builds_Filter_WithoutActiveLua}">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterWithoutActiveLua}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </WrapPanel>
            </StackPanel>

            <!-- Loading state -->
            <ContentControl
                Grid.Row="2"
                Content="{x:Static res:Strings.Manage_LoadingGames}"
                Style="{StaticResource LoadingStateStyle}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Empty state -->
            <HeaderedContentControl
                Grid.Row="2"
                Header="{Binding EmptyMessage}"
                Style="{StaticResource EmptyStateStyle}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <!-- Virtualized Grid / Steam-style List container (zero extra I/O when toggling mode) -->
            <Grid
                Grid.Row="2"
                Margin="{DynamicResource SpaceTop12}"
                Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
                <vwp:VirtualizingItemsControl
                    x:Name="GameGrid"
                    ItemsSource="{Binding GridItems}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}"
                    VirtualizingPanel.CacheLength="1,1"
                    VirtualizingPanel.CacheLengthUnit="Page"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <vwp:VirtualizingItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel
                                Orientation="Horizontal"
                                SpacingMode="StartAndEndOnly"
                                StretchItems="False" />
                        </ItemsPanelTemplate>
                    </vwp:VirtualizingItemsControl.ItemsPanel>
                    <vwp:VirtualizingItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                x:Name="CardRoot"
                                Width="260"
                                Height="220"
                                Margin="{DynamicResource SpaceAll8}"
                                themes:Motion.EnableSmoothHover="True"
                                DataContextChanged="GameRow_DataContextChanged"
                                Loaded="GameRow_Loaded">
                            <Button
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                Command="{Binding DataContext.OpenGameCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                FocusVisualStyle="{StaticResource DefaultControlFocusVisualStyle}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="CardBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{DynamicResource RadiusLarge}">
                                            <StackPanel>
                                                <!-- Cover + high-contrast status badges -->
                                                <Border
                                                    Height="116"
                                                    Margin="{DynamicResource SpaceAll4}"
                                                    Background="{StaticResource SurfaceCardHoverBrush}"
                                                    ClipToBounds="True"
                                                    CornerRadius="{DynamicResource RadiusMedium}">
                                                    <Grid>
                                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                        <StackPanel
                                                            Margin="{DynamicResource SpaceAll4}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom"
                                                            Orientation="Vertical">
                                                            <Border
                                                                Padding="{DynamicResource SpaceAll4}"
                                                                HorizontalAlignment="Left"
                                                                Background="{StaticResource ScrimPanelBrush}"
                                                                CornerRadius="{DynamicResource RadiusSmall}"
                                                                Visibility="{Binding VariantBadge, Converter={StaticResource NullToCollapsed}}">
                                                                <TextBlock
                                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource AccentSoftBrush}"
                                                                    Text="{Binding VariantBadge}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                            <Border
                                                                Margin="{DynamicResource SpaceTop4}"
                                                                Padding="{DynamicResource SpaceAll4}"
                                                                HorizontalAlignment="Left"
                                                                Background="{StaticResource WarningInsetBrush}"
                                                                BorderBrush="{StaticResource WarningOutlineBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource RadiusSmall}"
                                                                Visibility="{Binding SavedBuildsOnly, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock
                                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource WarningSoftBrush}"
                                                                    Text="{x:Static res:Strings.Builds_SavedBuildsNoLua}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Card metadata -->
                                                <StackPanel Margin="{DynamicResource SpaceAll12}">
                                                    <TextBlock
                                                        Height="36"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        Style="{StaticResource TextBodyStrong}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap" />
                                                    <Grid Margin="{DynamicResource SpaceTop4}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource TextDimBrush}"
                                                            Style="{StaticResource TextCaption}"
                                                            Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                        <Border
                                                            Grid.Column="1"
                                                            Margin="{DynamicResource SpaceLeft8}"
                                                            Padding="{DynamicResource SpaceAll4}"
                                                            Background="{StaticResource SurfaceInsetBrush}"
                                                            CornerRadius="{DynamicResource RadiusSmall}"
                                                            Visibility="{Binding HasPresetsCount, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock
                                                                FontSize="{DynamicResource FontSizeCaption}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource AccentSoftBrush}"
                                                                Text="{Binding PresetsCountLabel}" />
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SurfaceCardHoverBrush}" />
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Hover / keyboard-focus remove-game affordance (sibling, never nested inside the card button) -->
                            <Border
                                x:Name="HoverOverlay"
                                Background="{StaticResource SurfaceGhostBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusLarge}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ui:Button
                                x:Name="RemoveGameButton"
                                Margin="{DynamicResource SpaceAll8}"
                                Padding="{DynamicResource SpaceAll4}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{x:Static res:Strings.Builds_RemoveGame_Tip}"
                                Background="{StaticResource DangerScrimBrush}"
                                Command="{Binding DataContext.RemoveGameCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Icon="{ui:SymbolIcon Delete24}"
                                ToolTip="{x:Static res:Strings.Builds_RemoveGame_Tip}">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </Grid>
                    </DataTemplate>
                </vwp:VirtualizingItemsControl.ItemTemplate>
            </vwp:VirtualizingItemsControl>
                <views:BuildsListView
                    x:Name="GameListView"
                    Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Pager bar: centered page numbers + right-aligned results-per-page (including All) -->
            <Grid
                Grid.Row="3"
                Margin="{DynamicResource SpaceTop12}"
                Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
                <Grid
                    HorizontalAlignment="Center"
                    Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button
                        Grid.Column="0"
                        Padding="{DynamicResource SpaceAll8}"
                        AutomationProperties.Name="{x:Static res:Strings.Pager_Prev}"
                        Command="{Binding PrevPageCommand}"
                        Content="‹"
                        FontSize="{DynamicResource FontSizeBody}"
                        IsEnabled="{Binding CanGoPrev}"
                        ToolTip="{x:Static res:Strings.Pager_Prev}" />
                    <ItemsControl Grid.Column="1" HorizontalAlignment="Center" ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        Margin="{DynamicResource SpaceLeft8}"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextDimBrush}"
                                        Text="…">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:Button
                                        Margin="{DynamicResource SpaceLeft4}"
                                        Padding="{DynamicResource SpaceAll8}"
                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding}"
                                        FontSize="{DynamicResource FontSizeBody}">
                                        <ui:Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualityMulti}">
                                                                <Binding />
                                                                <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Appearance" Value="Primary" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button
                        Grid.Column="2"
                        Margin="{DynamicResource SpaceLeft4}"
                        Padding="{DynamicResource SpaceAll8}"
                        AutomationProperties.Name="{x:Static res:Strings.Pager_Next}"
                        Command="{Binding NextPageCommand}"
                        Content="›"
                        FontSize="{DynamicResource FontSizeBody}"
                        IsEnabled="{Binding CanGoNext}"
                        ToolTip="{x:Static res:Strings.Pager_Next}" />
                </Grid>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TextCaption}"
                        Text="{x:Static res:Strings.Manage_ResultsPerPage}" />
                    <ComboBox
                        MinWidth="72"
                        Margin="{DynamicResource SpaceLeft8}"
                        ItemTemplate="{StaticResource FilterOptionTemplate}"
                        ItemsSource="{Binding PageSizeOptions}"
                        SelectedItem="{Binding SelectedPageSize}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ── State 2: Full-width game detail ──────────────────────── -->
        <views:BuildsDetailPane
            x:Name="DetailPane"
            Visibility="{Binding IsShowingDetail, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
