<UserControl
    x:Class="LuaToolsGui.Views.BuildsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:BuildsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Results-per-page item display: shows the localized label while the bound value stays the
             English key ("All"), which PagedListViewModel parses. Same as Manage. -->
        <DataTemplate x:Key="FilterOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
        </DataTemplate>

        <!-- Borderless, hover-highlight button used as a clickable depot/DLC row (opens SteamDB). -->
        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="-6,0,-6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One depot/DLC row: on/off switch, then the clickable → SteamDB info block (title with its
             DLC/SHARED tag, id · size · os · lang, this lua's manifest pin greyed when commented out by
             Auto Update), then the Lock tickbox. -->
        <DataTemplate x:Key="DepotRowTemplate">
          <!-- The switches live OUTSIDE the SteamDB button: nested inside it, clicking one would also
               fire the button and open a browser tab. -->
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- On/off. The container keeps its width even when the switch is hidden, so Missing and
                 Unknown rows (which never have one) still line their titles up with the In-lua rows. -->
            <Border Width="52" VerticalAlignment="Center">
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    Command="{Binding DataContext.ToggleEnabledCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    IsChecked="{Binding IsEnabled, Mode=OneWay}"
                    IsEnabled="{Binding CanEnable}"
                    ToolTip="{x:Static res:Strings.Builds_Depot_EnableTip}"
                    Visibility="{Binding IsInLua, Converter={StaticResource BoolToVis}}" />
            </Border>

            <Button
                Grid.Column="1"
                Command="{Binding DataContext.OpenSteamDbCommand, ElementName=Root}"
                CommandParameter="{Binding}"
                Style="{StaticResource RowButtonStyle}"
                ToolTip="{x:Static res:Strings.Confirm_OpenSteamDb}">
                    <StackPanel>
                        <!-- Title with its DLC/SHARED tag hugging it. Auto,Auto,* : the tag sits right
                             after the title instead of being flung to the far edge of the row, and the
                             trailing * absorbs the slack. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="12.5"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceInsetBrush}"
                                CornerRadius="4"
                                Visibility="{Binding IsDlc, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="9.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentSoftBrush}"
                                    Text="DLC" />
                            </Border>
                            <Border
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                Background="{StaticResource WarningInsetBrush}"
                                CornerRadius="4"
                                Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="9.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource WarningSoftBrush}"
                                    Text="{x:Static res:Strings.Confirm_Shared}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Margin="0,1,0,0"
                            FontSize="10.5"
                            Foreground="{StaticResource TextDimBrush}"
                            Text="{Binding Meta}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontFamily="Consolas"
                            FontSize="10.5"
                            Text="{Binding ManifestLabel}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding HasManifest, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Dimmed by default = a pin that exists but isn't in force. -->
                                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            Margin="0,1,0,0"
                            FontFamily="Consolas"
                            FontSize="10.5"
                            Foreground="{StaticResource WarningSoftBrush}"
                            Text="{Binding OutdatedLabel}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding IsOutdated, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
            </Button>

            <!-- Lock = keep the setManifestid pin. Hidden outright when the depot has no pin line to
                 comment in/out — there'd be nothing to toggle, and a permanently-greyed tickbox on most
                 rows is just noise. Auto column, so the info block reclaims the space. -->
            <CheckBox
                Grid.Column="2"
                MinWidth="0"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding DataContext.ToggleLockCommand, ElementName=Root}"
                CommandParameter="{Binding}"
                Content="{x:Static res:Strings.Builds_Depot_Lock}"
                FontSize="10.5"
                IsChecked="{Binding IsLocked, Mode=OneWay}"
                ToolTip="{x:Static res:Strings.Builds_Depot_LockTip}"
                Visibility="{Binding CanLock, Converter={StaticResource BoolToVis}}" />
          </Grid>
        </DataTemplate>

        <!-- One game in the left-hand list: cover thumb, name, and what build it's running. -->
        <DataTemplate x:Key="GameRowTemplate">
            <Grid Margin="0,0,0,2" DataContextChanged="GameRow_DataContextChanged" Loaded="GameRow_Loaded">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="46"
                    Height="22"
                    Background="{StaticResource SurfaceCardHoverBrush}"
                    ClipToBounds="True"
                    CornerRadius="3">
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock
                        FontSize="12.5"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource AccentBrush}"
                        Text="{Binding VariantBadge}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding VariantBadge, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <!-- Remove-game affordance. Deliberately quiet: it deletes files, so it must not sit at
                     the same visual weight as selecting a row, but it also cannot be hidden behind a
                     right-click nobody discovers. Held at 0 opacity until the pointer is over the row,
                     which keeps the list clean while making it obvious the moment you reach for it.

                     Bound through the ListBox rather than the row: the command lives on the page's
                     view-model, and the row's DataContext is the game — which is what it passes back
                     as the parameter. -->
                <ui:Button
                    x:Name="RemoveGameButton"
                    Grid.Column="2"
                    Width="26"
                    Height="26"
                    Padding="0"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="{x:Static res:Strings.Builds_RemoveGame_Tip}">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                            <!-- Opacity and Foreground are SETTERS, not attributes on the element. A local
                                 value outranks a style trigger in WPF, so writing Opacity="0" inline would
                                 pin the button invisible and the reveal triggers below would never win. -->
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </Trigger>
                                <!-- Keyboard users never raise IsMouseOver, so focus has to reveal it too;
                                     otherwise the control is reachable by Tab but invisible while focused. -->
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </Grid>
        </DataTemplate>

        <!-- One entry in the build switcher: label + "8 depots · 3 DLC · Pinned", active marker right. -->
        <DataTemplate x:Key="VariantRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding Label}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="10.5"
                        Foreground="{StaticResource TextDimBrush}"
                        Text="{Binding Meta}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="{StaticResource SuccessInsetBrush}"
                    CornerRadius="4"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontSize="9.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SuccessTextBrush}"
                        Text="{x:Static res:Strings.Builds_Active}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{x:Static res:Strings.Builds_Title}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11.5"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{x:Static res:Strings.Builds_Subtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <!-- Save lives up here rather than in a banner over the depot list: it only appears mid-edit,
                 and anything that appears/disappears inside the page body shoves the whole list up and
                 down. In the header row nothing below it moves.

                 Both buttons key off HasEditBase, which now means exactly "a build or preset is part-way
                 through an edit". Editing the DEFAULT shows neither: it follows the live lua by itself,
                 so there is nothing to save it to. -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding SaveInPlaceCommand}"
                    Content="{Binding SaveInPlaceLabel}"
                    Icon="{ui:SymbolIcon Save24}"
                    Visibility="{Binding HasEditBase, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding SaveAsPresetCommand}"
                    Content="{x:Static res:Strings.Builds_Action_SaveAsNew}"
                    Icon="{ui:SymbolIcon Bookmark24}"
                    Visibility="{Binding HasEditBase, Converter={StaticResource BoolToVis}}" />
                <!-- Jump to this game on the Manage page (its detail flyout) — the return trip for
                     Manage's "Manage Build". Disabled rather than hidden so the header doesn't reflow
                     when you select a game. -->
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding OpenInManageCommand}"
                    Content="{x:Static res:Strings.Nav_Manage}"
                    Icon="{ui:SymbolIcon Games24}"
                    IsEnabled="{Binding HasSelection}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}"
                    Content="{x:Static res:Strings.Manage_Refresh}"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Left: game picker ────────────────────────────────── -->
            <Border
                Padding="10"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBox
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="4,16,4,0"
                        VerticalAlignment="Top"
                        FontSize="11.5"
                        Foreground="{StaticResource TextDimBrush}"
                        Text="{Binding EmptyMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                    <ListBox
                        x:Name="GameList"
                        Grid.Row="1"
                        Margin="-4,8,-4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemTemplate="{StaticResource GameRowTemplate}"
                        ItemsSource="{Binding Items}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedGame}">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Pager. Deliberately minimal: prev / "Page x of y" / next. The base VM also exposes
                         windowed PageNumbers (as Manage renders) but there's no room for them here, and
                         the list is a picker, not a browsing grid. Always shown — even on a single page —
                         so the results-per-page control stays reachable; the arrows just disable. -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <ui:Button
                                Padding="8,2"
                                Command="{Binding PrevPageCommand}"
                                Content="‹"
                                FontSize="14"
                                IsEnabled="{Binding CanGoPrev}" />
                            <TextBlock
                                MinWidth="90"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="{Binding PageLabel}"
                                TextAlignment="Center" />
                            <ui:Button
                                Padding="8,2"
                                Command="{Binding NextPageCommand}"
                                Content="›"
                                FontSize="14"
                                IsEnabled="{Binding CanGoNext}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextDimBrush}"
                                Text="{x:Static res:Strings.Manage_ResultsPerPage}" />
                            <ComboBox
                                MinWidth="66"
                                ItemTemplate="{StaticResource FilterOptionTemplate}"
                                ItemsSource="{Binding PageSizeOptions}"
                                SelectedItem="{Binding SelectedPageSize}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Right: the selected game's builds ────────────────── -->
            <Grid Grid.Column="1" Margin="14,0,0,0">
                <!-- Nothing picked yet -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="42"
                        Foreground="{StaticResource TextDisabledBrush}"
                        Symbol="BranchFork24" />
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextDimBrush}"
                        Text="{x:Static res:Strings.Builds_NoSelection}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title + latest-build line -->
                    <!-- ActiveGame, not SelectedGame: paging nulls the list selection, and this panel must
                         keep showing the game whose builds are open. -->
                    <StackPanel Grid.Row="0" DataContext="{Binding ActiveGame}">
                        <TextBlock
                            FontSize="17"
                            FontWeight="Bold"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11.5"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontSize="11.5"
                        Foreground="{StaticResource TextDimBrush}"
                        Text="{Binding LatestBuildLabel}"
                        Visibility="{Binding LatestBuildLabel, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Switcher + actions -->
                    <Border
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{x:Static res:Strings.Builds_ActiveBuild}" />

                            <ComboBox
                                Margin="0,6,0,0"
                                HorizontalContentAlignment="Stretch"
                                ItemTemplate="{StaticResource VariantRowTemplate}"
                                ItemsSource="{Binding Variants}"
                                SelectedItem="{Binding SelectedVariant}" />

                            <!-- Status/save UI stays OUT of the page body on purpose: anything that
                                 appears and vanishes here shoves the depot list up and down as you work.
                                 The switcher row above says which build is live, and "Save to <build>"
                                 sits in the header, where nothing below it moves. -->

                            <!-- Inline rename (replaces the button row while active) -->
                            <Grid Margin="0,10,0,0" Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    PlaceholderText="{x:Static res:Strings.Builds_RenamePlaceholder}"
                                    Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Appearance="Primary"
                                    Command="{Binding CommitRenameCommand}"
                                    Content="{x:Static res:Strings.Builds_Action_Save}" />
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Command="{Binding CancelRenameCommand}"
                                    Content="{x:Static res:Strings.Builds_Action_Cancel}" />
                            </Grid>

                            <UniformGrid
                                Margin="0,10,0,0"
                                Columns="4"
                                Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}">
                                <ui:Button
                                    Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Primary"
                                    Command="{Binding ApplyCommand}"
                                    Content="{x:Static res:Strings.Builds_Action_Apply}"
                                    Icon="{ui:SymbolIcon Checkmark24}"
                                    IsEnabled="{Binding CanApply}" />
                                <ui:Button
                                    Margin="4,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding StartRenameCommand}"
                                    Content="{x:Static res:Strings.Builds_Action_Rename}"
                                    Icon="{ui:SymbolIcon Rename24}"
                                    IsEnabled="{Binding CanRename}" />
                                <ui:Button
                                    Margin="4,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding EditCommand}"
                                    Content="{x:Static res:Strings.Builds_Action_Edit}"
                                    Icon="{ui:SymbolIcon Edit24}" />
                                <ui:Button
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DeleteVariantCommand}"
                                    Content="{x:Static res:Strings.Builds_Action_Delete}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Icon="{ui:SymbolIcon Delete24}"
                                    IsEnabled="{Binding CanDelete}"
                                    ToolTipService.ShowOnDisabled="True">
                                    <!-- The tooltip EXPLAINS the disabled state, so it must only appear
                                         while disabled (and WPF hides tooltips on disabled controls
                                         unless ShowOnDisabled is set above). -->
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="ToolTip" Value="{x:Static res:Strings.Builds_Delete_ActiveTip}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Editor (replaces the depot table while open) -->
                    <Grid Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{x:Static res:Strings.Builds_Editor_Title}" />
                        <TextBox
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            AcceptsReturn="True"
                            AcceptsTab="True"
                            Background="{StaticResource ShadowBrush}"
                            FontFamily="Consolas"
                            FontSize="12"
                            HorizontalScrollBarVisibility="Auto"
                            Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                            VerticalScrollBarVisibility="Auto" />
                        <StackPanel
                            Grid.Row="2"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding CancelEditCommand}"
                                Content="{x:Static res:Strings.Builds_Action_Cancel}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding SaveAsPresetCommand}"
                                Content="{x:Static res:Strings.Builds_Action_SaveAsPreset}"
                                Icon="{ui:SymbolIcon Bookmark24}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Command="{Binding SaveEditCommand}"
                                Content="{x:Static res:Strings.Builds_Action_Save}"
                                Icon="{ui:SymbolIcon Save24}" />
                        </StackPanel>
                    </Grid>

                    <!-- Depot/DLC breakdown for the SELECTED variant (moved here from the Manage flyout).
                         The search box is OUTSIDE the ScrollViewer so it stays put on a long list. -->
                    <Grid
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ui:TextBox
                            Margin="0,0,12,0"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="{x:Static res:Strings.Builds_Depot_Search}"
                            Text="{Binding DepotSearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="2,12,0,0"
                            VerticalAlignment="Top"
                            FontSize="11.5"
                            Foreground="{StaticResource TextDimBrush}"
                            Text="{x:Static res:Strings.Builds_Depot_NoMatch}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasNoDepotMatches, Converter={StaticResource BoolToVis}}" />

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <!-- Right margin keeps the scrollbar in its own lane instead of sitting on top of
                             the Lock tickbox. -->
                        <StackPanel Margin="0,0,12,0">
                            <StackPanel
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding IsLoadingDepots, Converter={StaticResource BoolToVis}}">
                                <ui:ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsIndeterminate="True" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{x:Static res:Strings.Manage_LoadingDepotInfo}" />
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource DangerBrush}"
                                Text="{Binding DepotError}"
                                TextWrapping="Wrap"
                                Visibility="{Binding DepotError, Converter={StaticResource NullToCollapsed}}" />

                            <!-- Editing a build that isn't applied still works, it just lands differently
                                 (saved straight into that build; Steam keeps running the applied one). -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="10.5"
                                Foreground="{StaticResource AccentBrush}"
                                Text="{x:Static res:Strings.Builds_Depot_InactiveNote}"
                                TextWrapping="Wrap"
                                Visibility="{Binding EditingInactiveBuild, Converter={StaticResource BoolToVis}}" />

                            <!-- In lua: depots/DLC this build includes -->
                            <StackPanel Visibility="{Binding HasInLua, Converter={StaticResource BoolToVis}}">
                                <Button
                                    Padding="0"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleInLuaCommand}"
                                    Cursor="Hand">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding InLuaToggleLabel, Mode=OneWay}" />
                                        <Run Foreground="{StaticResource TextDimBrush}" Text="{Binding InLuaCount, StringFormat='({0})', Mode=OneWay}" />
                                    </TextBlock>
                                </Button>
                                <ItemsControl
                                    Margin="0,8,0,0"
                                    ItemTemplate="{StaticResource DepotRowTemplate}"
                                    ItemsSource="{Binding InLua}"
                                    Visibility="{Binding IsInLuaExpanded, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- Missing: real depots/DLC on Steam this lua omits -->
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                                <Button
                                    Padding="0"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleMissingCommand}"
                                    Cursor="Hand">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource WarningSoftBrush}">
                                        <Run Text="{Binding MissingToggleLabel, Mode=OneWay}" />
                                        <Run Foreground="{StaticResource TextDimBrush}" Text="{Binding MissingCount, StringFormat='({0})', Mode=OneWay}" />
                                    </TextBlock>
                                </Button>
                                <StackPanel Visibility="{Binding IsMissingExpanded, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="10.5"
                                        Foreground="{StaticResource TextDimBrush}"
                                        Text="{x:Static res:Strings.Manage_MissingHint}"
                                        TextWrapping="Wrap" />
                                    <ItemsControl
                                        Margin="0,8,0,0"
                                        ItemTemplate="{StaticResource DepotRowTemplate}"
                                        ItemsSource="{Binding Missing}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Unknown: unnamed DLC, 0-byte/broken depots, shared redists -->
                            <StackPanel Margin="0,8,0,12" Visibility="{Binding HasUnknown, Converter={StaticResource BoolToVis}}">
                                <Button
                                    Padding="0"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleUnknownCommand}"
                                    Cursor="Hand">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{Binding UnknownToggleLabel, Mode=OneWay}" />
                                        <Run Foreground="{StaticResource TextDimBrush}" Text="{Binding UnknownCount, StringFormat='({0})', Mode=OneWay}" />
                                    </TextBlock>
                                </Button>
                                <StackPanel Visibility="{Binding IsUnknownExpanded, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="10.5"
                                        Foreground="{StaticResource TextDimBrush}"
                                        Text="{x:Static res:Strings.Manage_UnknownHint}"
                                        TextWrapping="Wrap" />
                                    <ItemsControl
                                        Margin="0,8,0,0"
                                        ItemTemplate="{StaticResource DepotRowTemplate}"
                                        ItemsSource="{Binding Unknown}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
