<UserControl
    x:Class="LuaToolsGui.Views.ViewModeToggle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="ToggleHost"
    AutomationProperties.Name="{x:Static res:Strings.ViewMode_SwitchLabel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Real radio semantics (UI Automation: SelectionItem.IsSelected), segmented-button look. Grouped by
             their shared parent, not GroupName, so Manage's and Depots' toggles never clear each other. -->
        <Style x:Key="ModeSegmentStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Segment"
                            MinWidth="32"
                            MinHeight="28"
                            Padding="{DynamicResource SpaceAll4}"
                            Background="Transparent"
                            CornerRadius="{DynamicResource RadiusSmall}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{StaticResource SurfaceCardHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border
        Padding="{DynamicResource SpaceAll4}"
        Background="{StaticResource SurfaceCardBrush}"
        BorderBrush="{StaticResource BorderDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource RadiusMedium}">
        <StackPanel Orientation="Horizontal">
            <RadioButton
                x:Name="GridButton"
                AutomationProperties.Name="{x:Static res:Strings.ViewMode_Grid}"
                Checked="GridButton_Checked"
                Style="{StaticResource ModeSegmentStyle}"
                ToolTip="{x:Static res:Strings.ViewMode_Grid}">
                <ui:SymbolIcon FontSize="{DynamicResource FontSizeSubtitle}" Symbol="Grid24" />
            </RadioButton>
            <RadioButton
                x:Name="ListButton"
                Margin="{DynamicResource SpaceLeft4}"
                AutomationProperties.Name="{x:Static res:Strings.ViewMode_List}"
                Checked="ListButton_Checked"
                Style="{StaticResource ModeSegmentStyle}"
                ToolTip="{x:Static res:Strings.ViewMode_List}">
                <ui:SymbolIcon FontSize="{DynamicResource FontSizeSubtitle}" Symbol="List24" />
            </RadioButton>
        </StackPanel>
    </Border>
</UserControl>
