<!--
    Shared components for the Amethyst redesign (1.8.3).

    Each one replaces a pattern the views currently copy by hand: SettingsView's card/header/divider, the
    per-page loading/empty/error blocks, the hand-built page titles.

    Rules this file keeps, because the rollout depends on them:
      * Every style is KEYED. Nothing here restyles a page until that page opts in (Lotes C-H), so merging
        the file changes nothing on screen.
      * No colour literal: brushes come from Themes/Colors.xaml through {DynamicResource}, which resolves
        across sibling dictionaries and follows the live accent switch. Sizes come from Typography.xaml and
        Spacing.xaml the same way.
      * Pure styles and templates, no code-behind. PageHeader and the state blocks are HeaderedContentControl
        templates (Header = the text, Content = an optional action, Tag = an optional subtitle). A UserControl
        would add a code-behind file per component for nothing a template cannot do.
      * Nothing here is BasedOn a WPF-UI style. A {StaticResource} inside a dictionary merged by Source is
        resolved lazily and cannot see its sibling dictionaries: BasedOn="{StaticResource {x:Type ui:Button}}"
        here throws, and {x:Type ListBoxItem} silently falls back to the CLASSIC Windows style (measured,
        DesignFoundationTests). The WPF-UI-derived components (IconButtonStyle, DangerButtonStyle,
        ListItemStyle, PagerTemplate) therefore live in App.xaml's own top-level resources, where the lookup
        does reach the merged WPF-UI dictionaries. Merging ui:ControlsDictionary in here instead was rejected:
        it redefines 8 accent brushes Colors.xaml overrides and would shadow them, killing the accent switch.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ── Surfaces ───────────────────────────────────────────────────────────────── -->

    <!-- A card: one bordered container that groups related content. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="Padding" Value="{DynamicResource SpaceAll16}" />
    </Style>

    <!-- Label above a card or a group of rows. -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,24,0,8" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Hairline between rows inside a card. Decorative, so it may sit under WCAG 1.4.11's 3:1. -->
    <Style x:Key="RowDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <!-- ── Page header ────────────────────────────────────────────────────────────── -->

    <!-- Header = page title, Tag = optional subtitle, Content = optional actions (right-aligned). -->
    <Style x:Key="PageHeaderStyle" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <ContentPresenter
                                ContentSource="Header"
                                TextElement.FontSize="{DynamicResource FontSizeHeader}"
                                TextElement.FontWeight="SemiBold"
                                TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock
                                x:Name="Subtitle"
                                Margin="{DynamicResource SpaceTop4}"
                                FontSize="{DynamicResource FontSizeBody}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ContentPresenter
                            Grid.Column="1"
                            Margin="{DynamicResource SpaceLeft16}"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Tag" Value="">
                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── States ─────────────────────────────────────────────────────────────────── -->
    <!-- Header = the message, Content = an optional action (Retry, Clear filters). Not focusable: the action
         inside is what takes focus. -->

    <Style x:Key="EmptyStateStyle" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource SpaceAll32}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel MaxWidth="420">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{DynamicResource TextDimBrush}"
                            Symbol="Box24" />
                        <ContentPresenter
                            Margin="{DynamicResource SpaceTop12}"
                            HorizontalAlignment="Center"
                            ContentSource="Header"
                            TextElement.FontSize="{DynamicResource FontSizeSubtitle}"
                            TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                            <ContentPresenter.Resources>
                                <!-- Scoped to this presenter: wraps and centres a plain-string Header only. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <ContentPresenter Margin="{DynamicResource SpaceTop16}" HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErrorStateStyle" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource SpaceAll32}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel MaxWidth="420">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{DynamicResource DangerBrush}"
                            Symbol="ErrorCircle24" />
                        <ContentPresenter
                            Margin="{DynamicResource SpaceTop12}"
                            HorizontalAlignment="Center"
                            ContentSource="Header"
                            TextElement.FontSize="{DynamicResource FontSizeSubtitle}"
                            TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                            <ContentPresenter.Resources>
                                <!-- Scoped to this presenter: wraps and centres a plain-string Header only. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <ContentPresenter Margin="{DynamicResource SpaceTop16}" HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Content = the loading text (e.g. Common_Loading). -->
    <Style x:Key="LoadingStateStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource SpaceAll32}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel>
                        <ui:ProgressRing
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            IsIndeterminate="True" />
                        <ContentPresenter
                            Margin="{DynamicResource SpaceTop12}"
                            HorizontalAlignment="Center"
                            TextElement.FontSize="{DynamicResource FontSizeBody}"
                            TextElement.Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
